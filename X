\text{Control:}&\quad \dot{x} = -L(G_t)x+Bu,\\
\text{Learning:}&\quad \theta_{t+1}= \theta_t-\eta\nabla_\theta\mathcal{L}_{\text{InfoNCE}}(Z_t;G_t).
