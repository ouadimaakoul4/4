## 7. THE CHAMELEON SWARM ALGORITHM: FULL SPECIFICATION

### 7.1 Algorithm Overview and Pseudocode

```python
class ChameleonSwarm:
    """
    Decentralized adaptive control for N particles using Lipschitz-constrained 
    rules, SPH perception, and entropic policy gradients.
    """
    
    def __init__(self, N=100, d_z=64, d_s=8, L_max=0.95, h_sph=0.5):
        """
        Initialize swarm.
        
        Args:
            N: number of particles
            d_z: perception dimension
            d_s: internal state dimension  
            L_max: desired Lipschitz constant for rule network
            h_sph: SPH smoothing length
        """
        self.N = N
        self.positions = torch.randn(N, 3) * 5.0  # Initial random positions
        self.states = torch.randn(N, d_s)
        
        # Lipschitz-constrained rule network
        self.rule = LipschitzMLP(
            input_dim=d_z, 
            output_dim=3+d_s,  # Δx (3D) + Δs (d_s)
            hidden_dim=128,
            L_max=L_max
        )
        
        # SPH perception
        self.sph = DifferentiableSPH(h=h_sph, kernel='cubic_spline')
        
        # Entropic RL components
        self.beta = 0.1
        self.beta_min, self.beta_max = 0.01, 10.0
        self.entropy_target = 2.0
        self.gamma_beta = 0.05  # Learning rate for β
        
        # Exploration noise schedule
        self.sigma_0 = 0.1
        self.sigma_decay = 0.01
        
        # Optimizer
        self.optimizer = torch.optim.Adam(self.rule.parameters(), lr=0.001)
        
        # Metrics tracking
        self.loss_history = []
        self.entropy_history = []
        self.beta_history = []
    
    def perceive(self, t):
        """
        Compute SPH-based perception for each particle at time t.
        
        Returns: z (N, d_z) tensor
        """
        perceptions = []
        
        for i in range(self.N):
            # SPH density and gradients
            rho_i = self.sph.density(self.positions[i], self.positions)
            grad_rho_i = self.sph.density_gradient(self.positions[i], self.positions)
            s_hat_i = self.sph.state_smooth(self.positions[i], self.positions, self.states)
            grad_s_i = self.sph.state_gradient(self.positions[i], self.positions, self.states)
            
            # k-nearest neighbors relative positions
            k = 5
            distances = torch.norm(self.positions - self.positions[i], dim=1)
            k_nearest_idx = torch.topk(distances, k=k+1, largest=False)[1][1:]  # Exclude self
            rel_pos = (self.positions[k_nearest_idx] - self.positions[i]).flatten()  # (15,)
            
            # Exploration noise (decaying)
            sigma_t = self.sigma_0 * torch.exp(-self.sigma_decay * torch.tensor(t, dtype=torch.float32))
            xi_i = sigma_t * torch.randn(3)
            
            # Concatenate perception
            z_i = torch.cat([rel_pos, rho_i.unsqueeze(0), grad_rho_i, s_hat_i, grad_s_i, xi_i])
            perceptions.append(z_i)
        
        return torch.stack(perceptions)  # (N, d_z)
    
    def step(self, reward_fn, t, dt=0.01):
        """
        Execute one particle dynamics step.
        
        Args:
            reward_fn: function mapping positions to scalar reward
            t: current timestep
            dt: integration timestep
            
        Returns: reward (scalar)
        """
        # Perception phase
        perceptions = self.perceive(t)  # (N, d_z)
        
        # Action phase: apply Lipschitz rule
        actions = self.rule(perceptions)  # (N, 3+d_s)
        pos_actions = actions[:, :3]
        state_actions = actions[:, 3:]
        
        # Update phase
        self.positions = self.positions + dt * pos_actions
        self.states = self.states + dt * state_actions
        
        # Compute reward
        reward = reward_fn(self.positions)
        
        return reward.item()
    
    def rollout(self, reward_fn, horizon=100):
        """
        Execute one full episode (rollout).
        
        Returns:
            cumulative_reward (scalar)
            final_positions (N, 3)
        """
        total_reward = 0.0
        
        for t in range(horizon):
            reward = self.step(reward_fn, t)
            total_reward += (0.99 ** t) * reward  # Discount
        
        return total_reward, torch.clone(self.positions)
    
    def entropic_policy_gradient_step(self, batch_rewards, num_rollouts=8):
        """
        Update rule parameters using entropic policy gradients.
        
        Args:
            batch_rewards: list of M scalar rewards from recent rollouts
            num_rollouts: number of rollouts in batch
        """
        batch_rewards = torch.tensor(batch_rewards, dtype=torch.float32)
        
        # Compute importance weights
        log_weights_unnorm = self.beta * batch_rewards
        log_weights_unnorm = log_weights_unnorm - log_weights_unnorm.max()  # Numerical stability
        weights = torch.exp(log_weights_unnorm)
        weights = weights / weights.sum()
        
        # Entropy of weight distribution
        entropy = -(weights * torch.log(weights + 1e-8)).sum().item()
        
        # Adaptive β update
        if entropy < self.entropy_target:
            self.beta = min(self.beta * 1.05, self.beta_max)
        else:
            self.beta = max(self.beta * 0.95, self.beta_min)
        
        # Update parameters using top-k trajectories
        top_k = max(1, num_rollouts // 2)
        top_rewards, top_indices = torch.topk(batch_rewards, k=top_k)
        
        # Simple loss: negative of mean top reward
        self.optimizer.zero_grad()
        loss = -top_rewards.mean()
        loss.backward()
        self.optimizer.step()
        
        # Log metrics
        self.loss_history.append(loss.item())
        self.entropy_history.append(entropy)
        self.beta_history.append(self.beta)
        
        return {
            'loss': loss.item(),
            'entropy': entropy,
            'beta': self.beta,
            'best_reward': batch_rewards.max().item()
        }
    
    def meta_train(self, task_distribution, num_episodes=200, batch_size=8):
        """Meta-learning phase: train on distribution of tasks."""
        for episode in range(num_episodes):
            task = np.random.choice(task_distribution)
            
            batch_rewards = []
            for _ in range(batch_size):
                reward, _ = self.rollout(task.reward_fn, horizon=100)
                batch_rewards.append(reward)
            
            metrics = self.entropic_policy_gradient_step(batch_rewards, num_rollouts=batch_size)
            
            if episode % 20 == 0:
                print(f"Episode {episode}: Reward={np.mean(batch_rewards):.2f}, "
                      f"Entropy={metrics['entropy']:.3f}, β={metrics['beta']:.3f}")
    
    def test_time_adapt(self, novel_task, num_iters=30, horizon=50):
        """
        Test-time adaptation (TTT-Discover): rapidly adapt to novel task.
        """
        print(f"\n=== Adapting to novel task: {novel_task.name} ===")
        
        for iteration in range(num_iters):
            batch_rewards = []
            for _ in range(5):  # Small batch
                reward, _ = self.rollout(novel_task.reward_fn, horizon=horizon)
                batch_rewards.append(reward)
            
            metrics = self.entropic_policy_gradient_step(batch_rewards, num_rollouts=5)
            
            if iteration % 5 == 0:
                print(f"Iter {iteration}: Reward={np.mean(batch_rewards):.2f}, "
                      f"Entropy={metrics['entropy']:.3f}")
        
        # Final evaluation
        final_reward, final_pos = self.rollout(novel_task.reward_fn, horizon=100)
        print(f"Final performance on {novel_task.name}: {final_reward:.2f}")
        
        return final_pos
```

### 7.2 Stability Verification

**Algorithm 7.1 (Verify L_Φ · L_f < 1)**

For a trained swarm, compute and log the Lipschitz constants:

```python
def verify_contraction_condition(swarm, num_perturbations=100):
    """
    Empirically verify that L_Φ · L_f < 1.
    
    Perturb particles slightly and measure how perturbations propagate.
    """
    
    # Get nominal trajectory
    x_nominal = torch.clone(swarm.positions)
    reward_nominal, _ = swarm.rollout(dummy_reward_fn, horizon=10)
    
    # Perturb each particle by epsilon and measure max response
    epsilon = 0.01
    max_gain = 0
    
    for i in range(num_perturbations):
        # Random small perturbation
        delta_x = epsilon * torch.randn_like(x_nominal)
        swarm.positions = x_nominal + delta_x
        
        # Compute response
        perception_nominal = swarm.perceive(0)
        swarm.positions = x_nominal
        perception_nominal_2 = swarm.perceive(0)
        
        perception_diff = (perception_nominal - perception_nominal_2).norm()
        L_Phi_est = perception_diff / epsilon
        
        # Control rule gain
        L_f_est = swarm.rule.lipschitz_constant()  # Built-in method
        
        # Product
        gain = L_Phi_est * L_f_est
        max_gain = max(max_gain, gain)
    
    print(f"Estimated L_Φ · L_f (max): {max_gain:.3f}")
    
    if max_gain < 1.0:
        print("✓ Contraction condition satisfied: System is stable.")
        return True
    else:
        print("✗ Warning: L_Φ · L_f ≥ 1. System may not converge.")
        return False
```

