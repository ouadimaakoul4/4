### 9.3 Differentiable SPH Module

```python
class DifferentiableSPH(nn.Module):
    """
    Differentiable Smoothed Particle Hydrodynamics (SPH) operators.
    
    Computes local geometric features from particle positions using SPH kernels.
    All operations are differentiable and GPU-compatible.
    """
    
    def __init__(self, h=0.5, kernel_type='cubic_spline'):
        super().__init__()
        self.h = h
        self.kernel_type = kernel_type
    
    def cubic_spline_kernel(self, r):
        """
        Cubic spline kernel W(r) with compact support [0, h].
        
        W(r) = (1 - r^2/h^2)^3 for r < h, else 0
        """
        q = r / self.h
        w = torch.zeros_like(q)
        
        mask = q < 1.0
        w[mask] = (1 - q[mask]**2)**3
        
        return w
    
    def cubic_spline_kernel_grad(self, r):
        """Gradient of cubic spline kernel."""
        q = r / self.h
        dw = torch.zeros_like(q)
        
        mask = q < 1.0
        dw[mask] = -6 * q[mask] * (1 - q[mask]**2)**2 / self.h
        
        return dw
    
    def density(self, positions, masses):
        """
        Compute SPH density for each particle.
        
        ρ_i = Σ_j m_j W(||x_i - x_j||; h)
        """
        N = positions.shape[0]
        
        # Compute pairwise distances
        dx = positions.unsqueeze(0) - positions.unsqueeze(1)  # (N, N, 3)
        r = torch.norm(dx, dim=2)  # (N, N)
        
        # Kernel evaluation
        w = self.cubic_spline_kernel(r)  # (N, N)
        
        # Density: rho_i = Σ_j m_j W(r_ij)
        rho = w @ masses  # (N,)
        
        return rho
    
    def density_gradient(self, positions, masses):
        """
        Compute SPH density gradient.
        
        ∇ρ_i = Σ_j m_j ∇W(||x_i - x_j||; h)
        """
        N = positions.shape[0]
        
        # Pairwise differences
        dx = positions.unsqueeze(0) - positions.unsqueeze(1)  # (N, N, 3)
        r = torch.norm(dx, dim=2, keepdim=True)  # (N, N, 1)
        
        # Kernel gradient
        dw = self.cubic_spline_kernel_grad(r.squeeze(-1))  # (N, N)
        
        # Gradient direction (normalized)
        dr_hat = dx / (r + 1e-8)  # (N, N, 3)
        
        # ∇ρ_i = Σ_j m_j ∇W · dr_hat (scaled by mass)
        grad_rho = (dw.unsqueeze(-1) * dr_hat * masses.view(1, -1, 1)).sum(dim=1)  # (N, 3)
        
        return grad_rho
    
    def state_smooth(self, positions, states, masses):
        """
        Compute smoothed neighboring states.
        
        ŝ_i = Σ_j (m_j / ρ_j) s_j W(r_ij)
        """
        N = positions.shape[0]
        d_s = states.shape[1]
        
        dx = positions.unsqueeze(0) - positions.unsqueeze(1)
        r = torch.norm(dx, dim=2)
        
        w = self.cubic_spline_kernel(r)
        
        # Density (precomputed or cached for efficiency)
        rho = self.density(positions, masses)
        
        # ŝ_i = Σ_j (m_j / ρ_j) s_j W(r_ij)
        weights = (w * (masses / (rho + 1e-8)).unsqueeze(1))  # (N, N)
        s_smooth = weights @ states  # (N, d_s)
        
        return s_smooth
    
    def state_gradient(self, positions, states, masses):
        """
        Compute state gradient using SPH.
        
        ∇s_i = Σ_j (m_j / ρ_j) (s_j - s_i) ∇W
        """
        N = positions.shape[0]
        
        dx = positions.unsqueeze(0) - positions.unsqueeze(1)
        r = torch.norm(dx, dim=2, keepdim=True)
        
        dw = self.cubic_spline_kernel_grad(r.squeeze(-1))
        dr_hat = dx / (r + 1e-8)
        
        rho = self.density(positions, masses)
        
        # s_j - s_i
        s_diff = states.unsqueeze(0) - states.unsqueeze(1)  # (N, N, d_s)
        
        # ∇s_i = Σ_j (m_j / ρ_j) (s_j - s_i) ∇W · dr_hat
        grad_s = (dw.unsqueeze(-1) * dr_hat.unsqueeze(-1) * (masses / (rho + 1e-8)).view(1, -1, 1, 1) * s_diff.unsqueeze(2)).sum(dim=1).squeeze(-2)
        
        # This computes (∇s) · (direction), shape (N, d_s)
        # For simplicity, return magnitude of the gradient
        grad_s_magnitude = torch.norm(grad_s, dim=1, keepdim=True)  # (N, 1)
        
        return grad_s_magnitude
```

### 9.4 Entropic Policy Gradient Training Loop

```python
def train_chameleon_swarm(swarm, task_distribution, num_episodes=1000, batch_size=8):
    """
    Main training loop combining meta-learning and test-time adaptation.
    """
    
    optimizer = torch.optim.Adam(swarm.rule.parameters(), lr=0.001)
    
    for episode in range(num_episodes):
        
        # Sample random task from distribution
        task = np.random.choice(task_distribution)
        
        # Collect batch of rollouts
        rewards = []
        rollout_data = []  # Store state transitions for later gradient computation
        
        for _ in range(batch_size):
            reward, trajectory = swarm.rollout(task.reward_fn, horizon=100)
            rewards.append(reward)
            rollout_data.append(trajectory)
        
        rewards = torch.tensor(rewards, dtype=torch.float32)
        
        # Entropic policy gradient update
        log_weights_unnorm = swarm.beta * rewards
        log_weights_unnorm = log_weights_unnorm - log_weights_unnorm.max()
        weights = torch.exp(log_weights_unnorm)
        weights = weights / weights.sum()
        
        # Entropy of weight distribution
        entropy = -(weights * torch.log(weights + 1e-8)).sum()
        
        # Adaptive beta schedule
        if entropy < swarm.entropy_target:
            swarm.beta = min(swarm.beta * 1.05, swarm.beta_max)
        else:
            swarm.beta = max(swarm.beta * 0.95, 0.01)
        
        # Gradient step on top-k trajectories (simplified)
        top_k = max(1, batch_size // 2)
        top_rewards, top_indices = torch.topk(rewards, k=top_k)
        
        # In a full implementation, we would compute:
        # ∇_θ log π_θ(τ) for each top-k trajectory and average with weights
        # For this overview, we show the structure:
        
        optimizer.zero_grad()
        
        # Pseudo-loss for demonstration
        loss = -top_rewards.mean()  # Maximize rewards
        loss.backward()
        
        optimizer.step()
        
        if episode % 100 == 0:
            print(f"Episode {episode}, Mean reward: {rewards.mean():.2f}, "
                  f"Best reward: {rewards.max():.2f}, Beta: {swarm.beta:.3f}, "
                  f"Entropy: {entropy:.3f}")
    
    return swarm


def test_time_adaptation(swarm, novel_task, num_iters=20):
    """
    Rapidly adapt to a novel task via entropic gradients.
    """
    
    optimizer = torch.optim.Adam(swarm.rule.parameters(), lr=0.005)
    
    print(f"Adapting to novel task: {novel_task.name}")
    
    for iter in range(num_iters):
        
        # Quick rollout
        reward, traj = swarm.rollout(novel_task.reward_fn, horizon=50)
        
        # Single-step gradient update
        optimizer.zero_grad()
        loss = -reward
        loss.backward()
        optimizer.step()
        
        if iter % 5 == 0:
            print(f"Iter {iter}: Reward = {reward:.2f}")
    
    # Final evaluation
    final_reward, final_traj = swarm.rollout(novel_task.reward_fn, horizon=100)
    print(f"Final performance: {final_reward:.2f}")
    
    return final_traj
