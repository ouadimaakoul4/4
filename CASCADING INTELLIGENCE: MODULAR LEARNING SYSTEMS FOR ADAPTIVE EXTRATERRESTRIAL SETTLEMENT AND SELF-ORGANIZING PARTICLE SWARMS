### 9.2 Lipschitz-Constrained MLP Implementation

```python
import torch
import torch.nn as nn
from torch.linalg import svd

class LipschitzMLP(nn.Module):
    """
    Feedforward neural network with Lipschitz constraints.
    
    Each layer is 1-Lipschitz via:
    - Orthogonal weight matrices (spectral norm = 1)
    - 1-Lipschitz activation functions (ReLU)
    """
    
    def __init__(self, input_dim, output_dim, hidden_dim=128, num_layers=3, L_max=0.9):
        super().__init__()
        
        self.L_max = L_max
        self.layers = nn.ModuleList()
        
        # Architecture: input -> hidden -> hidden -> ... -> output
        dims = [input_dim] + [hidden_dim] * (num_layers - 1) + [output_dim]
        
        for i in range(len(dims) - 1):
            self.layers.append(
                LinearLipschitz(dims[i], dims[i+1])
            )
        
        # Final layer scales output by L_max to get desired Lipschitz bound
        self.scale = L_max
    
    def forward(self, x):
        for layer in self.layers[:-1]:
            x = layer(x)
            x = torch.relu(x)  # 1-Lipschitz activation
        
        x = self.layers[-1](x)
        x = self.scale * torch.tanh(x)  # Bounded output, scaled by L_max
        
        return x


class LinearLipschitz(nn.Module):
    """
    Linear layer with orthogonal weight matrix (1-Lipschitz).
    
    Uses spectral normalization to enforce orthogonality.
    """
    
    def __init__(self, in_features, out_features):
        super().__init__()
        
        self.in_features = in_features
        self.out_features = out_features
        
        # Initialize with random orthogonal matrix
        w = torch.randn(out_features, in_features)
        u, _, v = torch.svd(w)
        w_ortho = u @ v.T
        self.register_buffer('weight', w_ortho)
        
        # Bias
        self.bias = nn.Parameter(torch.zeros(out_features))
    
    def forward(self, x):
        # Apply spectral normalization to weight
        u, s, vh = torch.linalg.svd(self.weight, full_matrices=False)
        
        # Clip singular values to ensure || W ||_2 <= 1
        s_clipped = torch.clamp(s, max=1.0)
        w_normalized = u @ torch.diag(s_clipped) @ vh
        
        return torch.nn.functional.linear(x, w_normalized, self.bias)
    
    def lipschitz_constant(self):
        """Compute and return the Lipschitz constant of this layer."""
        _, s, _ = torch.linalg.svd(self.weight, full_matrices=False)
        return s[0].item()
