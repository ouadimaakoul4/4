Appendix A — Full Lean 4 Module

Core Lean 4 only; no Mathlib. The module is intended to be self-contained and to compile under lake build with no sorry.

```lean
/-!
# V-Core v11.0 — core Lean 4 module

Design invariants (see main text §1.2):
* Invariants are carried IN THE TYPE (proof-carrying fields).
* The proof-checking TCB is a named hypothesis `Sound c`, never implicit.
* Authority bounds attach to verifiers via a lineage, so no-escalation is a
  theorem over ancestry.
* Revocation/HOLD lives on a global `Ledger`; taint flows from DEPENDENCIES
  to dependents, with an effective (compromise) time.
-/

namespace VCore

/-! ## A.1 Authority poset -/

inductive Formal    | declared | derived  | verified     deriving DecidableEq, Repr
inductive Empirical | untested | observed | replicated   deriving DecidableEq, Repr
inductive Repro     | unverified | traceable | reproducible deriving DecidableEq, Repr

def Formal.toNat : Formal → Nat
  | .declared => 0 | .derived => 1 | .verified => 2
def Empirical.toNat : Empirical → Nat
  | .untested => 0 | .observed => 1 | .replicated => 2
def Repro.toNat : Repro → Nat
  | .unverified => 0 | .traceable => 1 | .reproducible => 2

theorem Formal.toNat_inj {a b : Formal} (h : a.toNat = b.toNat) : a = b := by
  cases a <;> cases b <;> simp_all [Formal.toNat]

theorem Empirical.toNat_inj {a b : Empirical} (h : a.toNat = b.toNat) : a = b := by
  cases a <;> cases b <;> simp_all [Empirical.toNat]

theorem Repro.toNat_inj {a b : Repro} (h : a.toNat = b.toNat) : a = b := by
  cases a <;> cases b <;> simp_all [Repro.toNat]

structure Authority where
  formal    : Formal
  empirical : Empirical
  repro     : Repro
  deriving DecidableEq, Repr

def Authority.le (a b : Authority) : Prop :=
  a.formal.toNat    ≤ b.formal.toNat    ∧
  a.empirical.toNat ≤ b.empirical.toNat ∧
  a.repro.toNat     ≤ b.repro.toNat

instance : LE Authority := ⟨Authority.le⟩

theorem Authority.le_refl (a : Authority) : a ≤ a :=
  ⟨Nat.le_refl _, Nat.le_refl _, Nat.le_refl _⟩

theorem Authority.le_trans {a b c : Authority} (h1 : a ≤ b) (h2 : b ≤ c) : a ≤ c :=
  ⟨Nat.le_trans h1.1 h2.1,
   Nat.le_trans h1.2.1 h2.2.1,
   Nat.le_trans h1.2.2 h2.2.2⟩

theorem Authority.le_antisymm {a b : Authority} (h1 : a ≤ b) (h2 : b ≤ a) : a = b := by
  have hf := Formal.toNat_inj    (Nat.le_antisymm h1.1     h2.1)
  have he := Empirical.toNat_inj (Nat.le_antisymm h1.2.1   h2.2.1)
  have hr := Repro.toNat_inj     (Nat.le_antisymm h1.2.2   h2.2.2)
  cases a; cases b; simp_all

def Formal.sup    (a b : Formal)    : Formal    := if a.toNat ≤ b.toNat then b else a
def Empirical.sup (a b : Empirical) : Empirical := if a.toNat ≤ b.toNat then b else a
def Repro.sup     (a b : Repro)     : Repro     := if a.toNat ≤ b.toNat then b else a

def Authority.sup (a b : Authority) : Authority :=
  ⟨a.formal.sup b.formal, a.empirical.sup b.empirical, a.repro.sup b.repro⟩

theorem Authority.le_sup_left (a b : Authority) : a ≤ a.sup b := by
  refine ⟨?_, ?_, ?_⟩
  · cases ha : a.formal <;> cases hb : b.formal
    <;> simp [Authority.sup, Formal.sup, Formal.toNat, ha, hb]
  · cases ha : a.empirical <;> cases hb : b.empirical
    <;> simp [Authority.sup, Empirical.sup, Empirical.toNat, ha, hb]
  · cases ha : a.repro <;> cases hb : b.repro
    <;> simp [Authority.sup, Repro.sup, Repro.toNat, ha, hb]

theorem Authority.le_sup_right (a b : Authority) : b ≤ a.sup b := by
  refine ⟨?_, ?_, ?_⟩
  · cases ha : a.formal <;> cases hb : b.formal
    <;> simp [Authority.sup, Formal.sup, Formal.toNat, ha, hb]
  · cases ha : a.empirical <;> cases hb : b.empirical
    <;> simp [Authority.sup, Empirical.sup, Empirical.toNat, ha, hb]
  · cases ha : a.repro <;> cases hb : b.repro
    <;> simp [Authority.sup, Repro.sup, Repro.toNat, ha, hb]

theorem Authority.sup_le {a b c : Authority} (h1 : a ≤ c) (h2 : b ≤ c) :
    a.sup b ≤ c := by
  obtain ⟨f1, e1, r1⟩ := h1
  obtain ⟨f2, e2, r2⟩ := h2
  refine ⟨?_, ?_, ?_⟩
  · cases ha : a.formal <;> cases hb : b.formal
    <;> simp_all [Authority.sup, Formal.sup, Formal.toNat]
  · cases ha : a.empirical <;> cases hb : b.empirical
    <;> simp_all [Authority.sup, Empirical.sup, Empirical.toNat]
  · cases ha : a.repro <;> cases hb : b.repro
    <;> simp_all [Authority.sup, Repro.sup, Repro.toNat]

def Authority.WF (a : Authority) : Prop :=
  1 ≤ a.empirical.toNat → 1 ≤ a.repro.toNat

/-! ## A.2 Checkers -/

structure Checker where
  name    : String
  accepts : String → Prop → Prop

def Sound (c : Checker) : Prop :=
  ∀ (bytes : String) (T : Prop), c.accepts bytes T → T

structure Meta where
  usage : Nat
  scope : Nat
  epoch : Nat
  deriving DecidableEq, Repr

structure Proof (cs : List Checker) (T : Prop) where
  bytes       : String
  meta        : Meta
  witnessHash : String
  nonempty    : cs ≠ []
  accepted    : ∀ c, c ∈ cs → c.accepts bytes T

theorem Proof.sound {cs : List Checker} {T : Prop} (p : Proof cs T)
    (hs : ∃ c, c ∈ cs ∧ Sound c) : T :=
  let ⟨c, hc, hsound⟩ := hs
  hsound p.bytes T (p.accepted c hc)

theorem no_proof_of_false {cs : List Checker}
    (hs : ∃ c, c ∈ cs ∧ Sound c) : ¬ Nonempty (Proof cs False) :=
  fun ⟨p⟩ => p.sound hs

structure Witness where
  artifact : String
  meta     : Meta

def Compat (H : String → String) {cs : List Checker} {T : Prop}
    (p : Proof cs T) (w : Witness) : Prop :=
  p.meta = w.meta ∧ p.witnessHash = H w.artifact

/-! ## A.3 Verifier lineage and no-escalation -/

def Descends : Authority → List Authority → Prop
  | _, []      => True
  | a, p :: ps => a ≤ p ∧ Descends p ps

theorem Descends.mem_le : ∀ (l : List Authority) (a : Authority),
    Descends a l → ∀ x, x ∈ l → a ≤ x
  | [],        _, _, x, hx => by cases hx
  | p :: ps,   a, ⟨hap, hrest⟩, x, hx => by
      cases hx with
      | head        => exact hap
      | tail _ hx'  => exact Authority.le_trans hap
                            (Descends.mem_le ps p hrest x hx')

structure Verifier where
  private mk ::
  id       : Nat
  auth     : Authority
  lineage  : List Authority
  descends : Descends auth lineage

structure Genesis where
  roots : List (Nat × Authority)

def Genesis.root (g : Genesis) (id : Nat) (a : Authority)
    (_h : (id, a) ∈ g.roots) : Verifier :=
  Verifier.mk id a [] trivial

def Verifier.issue (p : Verifier) (id : Nat) (a : Authority)
    (h : a ≤ p.auth) : Verifier :=
  Verifier.mk id a (p.auth :: p.lineage) ⟨h, p.descends⟩

theorem no_escalation (v : Verifier) :
    ∀ x, x ∈ v.lineage → v.auth ≤ x :=
  Descends.mem_le v.lineage v.auth v.descends

theorem issue_no_escalation (p : Verifier) (id : Nat) (a : Authority)
    (h : a ≤ p.auth) : (p.issue id a h).auth ≤ p.auth := h

theorem issue_bounded_by_all_ancestors (p : Verifier) (id : Nat) (a : Authority)
    (h : a ≤ p.auth) :
    ∀ x, x ∈ p.lineage → (p.issue id a h).auth ≤ x :=
  fun x hx => Authority.le_trans h (no_escalation p x hx)

/-! ## A.4 Faithfulness as data -/

structure Reform (P : String) (T : Prop) where
  formalizerId : Nat
  T'           : Prop
  equiv        : T ↔ T'

/-! ## A.5 Claims -/

structure Context where
  caps : List Nat

structure Claim (cs : List Checker) (T : Prop) (α : Authority) where
  private mk ::
  cid       : Nat
  proof     : Proof cs T
  verifier  : Verifier
  ctx       : Context
  authBound : α ≤ verifier.auth
  inTheta   : verifier.id ∈ ctx.caps

def sealClaim {cs : List Checker} {T : Prop} {P : String}
    (H : String → String) (ctx : Context) (cid : Nat) (producer : Nat)
    (v : Verifier) (α : Authority)
    (p : Proof cs T) (w : Witness)
    (_hcompat : Compat H p w)
    (hcap : v.id ∈ ctx.caps)
    (hα : α ≤ v.auth)
    (r : Reform P T) (_hind : r.formalizerId ≠ producer) :
    Claim cs T α :=
  Claim.mk cid p v ctx hα hcap

theorem Claim.sound {cs : List Checker} {T : Prop} {α : Authority}
    (c : Claim cs T α) (hs : ∃ k, k ∈ cs ∧ Sound k) : T :=
  c.proof.sound hs

theorem Claim.bounded_by_ancestors {cs : List Checker} {T : Prop} {α : Authority}
    (c : Claim cs T α) : ∀ x, x ∈ c.verifier.lineage → α ≤ x :=
  fun x hx => Authority.le_trans c.authBound (no_escalation c.verifier x hx)

/-! ## A.6 Ledger, HOLD, effective-time revocation -/

structure Ledger where
  deps     : Nat → List Nat
  signer   : Nat → Nat
  sealedAt : Nat → Nat

abbrev Revocations := Nat → Option Nat

inductive Hold (L : Ledger) (rev : Revocations) : Nat → Prop
  | direct {c t : Nat} :
      rev (L.signer c) = some t → t ≤ L.sealedAt c → Hold L rev c
  | taint  {c d : Nat} :
      d ∈ L.deps c → Hold L rev d → Hold L rev c

def DepStar (L : Ledger) : Nat → Nat → Prop :=
  Relation.TransGen (fun c d => d ∈ L.deps c)

theorem hold_of_depStar {L : Ledger} {rev : Revocations} {c d : Nat}
    (h : DepStar L c d) (hd : Hold L rev d) : Hold L rev c := by
  revert hd
  induction h with
  | single hcd       => exact fun hd => Hold.taint hcd hd
  | tail _ hbc ih    => exact fun hd => ih (Hold.taint hbc hd)

theorem held_dependency_blocks {L : Ledger} {rev : Revocations} {c d : Nat}
    (hdep : d ∈ L.deps c) (hd : Hold L rev d) : Hold L rev c :=
  Hold.taint hdep hd

theorem pre_compromise_not_direct {L : Ledger} {rev : Revocations} {c t : Nat}
    (_hr : rev (L.signer c) = some t) (hbefore : L.sealedAt c < t) :
    ¬ (rev (L.signer c) = some t ∧ t ≤ L.sealedAt c) := by
  intro ⟨_, h⟩; omega

def promote {cs : List Checker} {T : Prop} {α : Authority}
    (L : Ledger) (rev : Revocations)
    (c : Claim cs T α) (α' : Authority)
    (_hle : α ≤ α') (hv : α' ≤ c.verifier.auth)
    (_hfree : ¬ Hold L rev c.cid) : Claim cs T α' :=
  Claim.mk c.cid c.proof c.verifier c.ctx hv c.inTheta

/-- Direction check: a held dependent does NOT taint its dependency. -/
example : ∃ (L : Ledger) (rev : Revocations),
    Hold L rev 1 ∧ ¬ Hold L rev 0 := by
  let L : Ledger :=
    ⟨fun c => if c = 1 then [0] else [], fun c => c, fun _ => 5⟩
  let rev : Revocations := fun v => if v = 1 then some 0 else none
  refine ⟨L, rev, ?_, ?_⟩
  · exact Hold.direct (t := 0) (by simp [rev, L]) (by simp [L])
  · intro h
    cases h with
    | direct h1 _  => simp [rev, L] at h1
    | taint hd _   => simp [L] at hd

end VCore
