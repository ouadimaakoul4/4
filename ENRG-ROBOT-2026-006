    double ocv(double soc) {
        // Calibrated polynomial
        return 3.2 + 0.8*soc - 0.2*soc*soc + 0.05*soc*soc*soc;
    }
    
public:
    void update(double current, double dt) {
        // SOC update (Coulomb counting)
        SOC -= (current / Q_nom) * dt / 3600.0;
