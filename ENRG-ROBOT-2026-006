    beta = 0.95  # initial
    theta = 0.1
    last_update = time.now()
    while True:
        Sigma = ukf.get_covariance()
        Tr_Sigma = trace(Sigma)
        dTr_dt = (Tr_Sigma - prev_Tr_Sigma) / dt
        
        if Tr_Sigma > THRESH_SIGMA or abs(dTr_dt) > THRESH_DERIV:
            beta = compute_cvar_bound(Sigma)
            theta = compute_wasserstein_radius(Sigma)
