E.2 A-RCBF QP Implementation (C++ Pseudocode)

```cpp
class AdaptiveRCBF {
private:
    double epsilon_hat = 0.12;
    double epsilon_min = 0.08;
    double epsilon_max = 0.18;
    double gamma_leak = 0.01;
    double Gamma = 0.5;
    double dt = 0.005; // 200 Hz
    
    // Rate limiter
    double eps_dot_max = (epsilon_max - epsilon_min) / 0.5; // tau=0.5s
    
    // OSQP solver with cached factorization
    OsqpSolver qp_solver;
    
public:
    void update_epsilon(const VectorXd& innovation) {
        double eps_dot = Gamma * innovation.norm() - gamma_leak * (epsilon_hat - 0.12);
        eps_dot = clamp(eps_dot, -eps_dot_max, eps_dot_max);
        epsilon_hat += eps_dot * dt;
        epsilon_hat = clamp(epsilon_hat, epsilon_min, epsilon_max);
    }
    
    VectorXd compute_safe_control(const VectorXd& u_nom, 
                                  const VectorXd& x,
                                  const MatrixXd& Lf_h,
                                  const MatrixXd& Lg_h,
                                  const VectorXd& grad_h_norms) {
        // Form QP: min ||u - u_nom||^2_Q
        // s.t. Lf_h + Lg_h * u + alpha(h) + epsilon_hat * ||grad_h|| >= 0
        
        qp_solver.updateConstraintBounds(-OSQP_INFTY, 
                                         Lf_h + alpha_h + epsilon_hat * grad_h_norms);
        qp_solver.warmStart(prev_primal, prev_dual);
        
        auto result = qp_solver.solve();
        if (result.status == OSQP_SOLVED) {
            return result.x;
        } else {
            // Fallback to passive backup controller
            return backup_controller(x);
        }
    }
};
```

