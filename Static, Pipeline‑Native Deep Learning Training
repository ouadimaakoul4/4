            } else {
                c << "    launch_forward_stage1(" << op.micro_batch
                  << ", activation_buf_stage1 + slot1[" << op.micro_batch << "]*TENSOR_SIZE, "
                  << "/* output pointer for mb" << op.micro_batch << " */ NULL);\n";
            }
        } else if (op.type == Op::BI) {
            if (op.stage == 0) {
                c << "    launch_backward_input_stage0(" << op.micro_batch
                  << ", grad_input[" << op.micro_batch << "], NULL, "
                  << "activation_buf_stage0 + slot0[" << op.micro_batch << "]*TENSOR_SIZE);\n";
            } else {
                c << "    launch_backward_input_stage1(" << op.micro_batch
                  << ", grad_input[" << op.micro_batch << "], NULL, "
                  << "activation_buf_stage1 + slot1[" << op.micro_batch << "]*TENSOR_SIZE);\n";
            }
        } else { // BW
            if (op.stage == 0) {
                c << "    launch_backward_weight_stage0(" << op.micro_batch
                  << ", activation_buf_stage0 + slot0[" << op.micro_batch << "]*TENSOR_SIZE"
                  << ", weight_grad_stage0);\n";
            } else {
                c << "    launch_backward_weight_stage1(" << op.micro_batch
                  << ", activation_buf_stage1 + slot1[" << op.micro_batch << "]*TENSOR_SIZE"
                  << ", weight_grad_stage1);\n";
            }
        }
    }
    c << "}\n";
    return c.str();
}
