    g.edges.push_back({1, 2, EdgeKind::CommOrder, 0.01f}); // send->recv
    return g;
}

// ======================== Stencil-AD ========================
inline void stencil_ad(BGIR& g) {
    int N = (int)g.nodes.size();
    // Create backward nodes for each forward compute node
    std::vector<int> fwd_to_bwd(N, -1);
    for (int i = 0; i < N; ++i) {
        if (g.nodes[i].kind == NodeKind::Compute) {
            int bwd_id = (int)g.nodes.size();
            g.nodes.push_back({bwd_id, NodeKind::Compute, g.nodes[i].stage, 1.5f, {}});
            fwd_to_bwd[i] = bwd_id;
        }
    }
    // Add gradient communication: for the cross-stage edge (0->1->2->3)
    int f0_bwd = fwd_to_bwd[0];  // backward of stage 0 compute
    int f1_bwd = fwd_to_bwd[3];  // backward of stage 1 compute
    int gsend = (int)g.nodes.size();
    g.nodes.push_back({gsend, NodeKind::Send, 1, 0.1f, {}});
    int grecv = (int)g.nodes.size();
    g.nodes.push_back({grecv, NodeKind::Recv, 0, 0.1f, {}});
    g.edges.push_back({f1_bwd, gsend, EdgeKind::Gradient, 0.0f});
    g.edges.push_back({gsend, grecv, EdgeKind::CommOrder, 0.01f});
    g.edges.push_back({grecv, f0_bwd, EdgeKind::Gradient, 0.0f});
}

