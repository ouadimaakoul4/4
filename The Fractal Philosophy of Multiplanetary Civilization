### B.4 Communication Delay Modeling

**Model B.4.1: Asynchronous Message Queue with Delay Distribution**

```python
class AsyncMessageQueue:
    """Models inter-settlement communication under light-speed constraints"""
    
    def __init__(self, max_delay_minutes, delay_distribution='lognormal'):
        self.max_delay = max_delay_minutes  # Physical limit (e.g., Mars-Earth: 3-22 min)
        self.delay_dist = delay_distribution
        self.message_buffer = []  # List of (message, send_time, receive_time)
        
    def send(self, message, sender, receiver, current_time):
        """Queue message with stochastic delay"""
        if self.delay_dist == 'lognormal':
            # Lognormal captures occasional extreme delays (solar interference, etc.)
            delay = np.random.lognormal(mean=np.log(10), sigma=0.5)
            delay = min(delay, self.max_delay)  # Cap at physical limit
        elif self.delay_dist == 'fixed':
            delay = self.max_delay / 2  # Simplified model
        receive_time = current_time + delay
        self.message_buffer.append({
            'content': message,
            'sender': sender,
            'receiver': receiver,
            'send_time': current_time,
            'receive_time': receive_time,
            'delivered': False
        })
        
    def receive(self, receiver, current_time):
        """Retrieve messages that have arrived by current_time"""
        received = []
        for msg in self.message_buffer:
            if (msg['receiver'] == receiver and 
                msg['receive_time'] <= current_time and 
                not msg['delivered']):
                received.append(msg['content'])
                msg['delivered'] = True
        return received
    
    def get_effective_delay(self, sender, receiver):
        """Compute expected delay for strategic planning"""
        # Used by agents for belief updating under uncertainty
        return self.max_delay * 0.6  # Empirical mean of lognormal
