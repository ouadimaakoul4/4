def edge_loop(stream):
    buf = deque(maxlen=125)
    for sample in stream:
        buf.append(sample)
        if len(buf) < 125: continue
        X = preprocess(buf)           # bandpass + ICA
        C = cov(X) + 1e-4 * I
        S = logm(C_ref_inv @ C @ C_ref_inv)
        feat = tangent_vectorize(S)   # upper triangle with sqrt2 scaling
        feat_buffer.append(feat)
        if len(feat_buffer) == 10:
            intent, confidence_raw = decoder(feat_buffer)
            confidence = calibrate(confidence_raw)
            cog_load = workload_regressor(feat_buffer)
            packet = IntentPacket(intent, confidence, cog_load)
            send(packet)
            feat_buffer.popleft()
