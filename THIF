B.1 Code for Tail Dependence Coefficient Calculation

The following Python code demonstrates the calculation of tail dependence coefficients for the Student-t copula. This is a theoretical computation, not an empirical analysis.

```python
import numpy as np
from scipy import stats

def student_t_tail_dependence(rho, nu):
    """
    Calculate the tail dependence coefficient for a bivariate Student-t copula.
    
    Parameters:
    -----------
    rho : float
        Correlation coefficient, -1 < rho < 1
    nu : float
        Degrees of freedom, nu > 0
    
    Returns:
    --------
    lambda : float
        Tail dependence coefficient
    """
    # Argument for the t-distribution CDF
    argument = -np.sqrt((nu + 1) * (1 - rho) / (1 + rho))
    
    # CDF of Student-t with nu+1 degrees of freedom
    lambda_value = 2 * stats.t.cdf(argument, df=nu + 1)
    
    return lambda_value

def gaussian_tail_dependence(rho):
    """
    Calculate the tail dependence coefficient for a bivariate Gaussian copula.
    The Gaussian copula has zero tail dependence for all rho < 1.
    """
    if rho >= 1:
        return 1.0
    return 0.0

# Demonstrate the difference
rhos = [0.1, 0.3, 0.5, 0.7, 0.9]
nus = [3, 5, 10, 30]

print("Tail Dependence Coefficients")
print("-" * 40)
print(f"{'rho':>6} {'Gaussian':>10} {'t(nu=3)':>10} {'t(nu=5)':>10} {'t(nu=10)':>10} {'t(nu=30)':>10}")
print("-" * 40)

for rho in rhos:
    gaussian_lambda = gaussian_tail_dependence(rho)
    t_lambdas = [student_t_tail_dependence(rho, nu) for nu in nus]
    print(f"{rho:>6.1f} {gaussian_lambda:>10.3f} {t_lambdas[0]:>10.3f} {t_lambdas[1]:>10.3f} {t_lambdas[2]:>10.3f} {t_lambdas[3]:>10.3f}")

print("\nNote: All values are theoretical calculations, not empirical estimates.")
