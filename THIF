import numpy as np

def regime_switching_joint_failure(p_normal, p_crisis, p_01, p_10):
    """
    Calculate the unconditional joint failure probability under regime-switching.
    
    Parameters:
    -----------
    p_normal : float
        Joint failure probability in normal state
    p_crisis : float
        Joint failure probability in crisis state
    p_01 : float
        Transition probability from normal to crisis
    p_10 : float
        Transition probability from crisis to normal
    
    Returns:
    --------
    P_unconditional : float
        Unconditional joint failure probability
    """
    # Stationary distribution
    pi_0 = p_10 / (p_01 + p_10)  # Probability of normal state
    pi_1 = p_01 / (p_01 + p_10)  # Probability of crisis state
    
    # Unconditional joint failure probability
    P_unconditional = pi_0 * p_normal + pi_1 * p_crisis
    
    return P_unconditional, pi_0, pi_1

