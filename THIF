B.2 Code for Joint Failure Probability Calculation

```python
import numpy as np
from scipy import stats
from scipy.integrate import dblquad

def student_t_copula_cdf(u1, u2, rho, nu):
    """
    Calculate the bivariate Student-t copula CDF at (u1, u2).
    """
    # Transform to t-distributed variables
    t1 = stats.t.ppf(u1, df=nu)
    t2 = stats.t.ppf(u2, df=nu)
    
    # Calculate bivariate t CDF
    # This requires numerical integration of the bivariate t density
    def integrand(x, y):
        return (1 / (2 * np.pi * np.sqrt(1 - rho**2)) * 
                (1 + (x**2 - 2*rho*x*y + y**2) / (nu * (1 - rho**2)))**(-(nu+2)/2))
    
    result, _ = dblquad(integrand, -np.inf, t1, -np.inf, t2)
    return result

def joint_failure_probability(p1, p2, rho, nu):
    """
    Calculate the joint failure probability for a two-layer safety system.
    
    Parameters:
    -----------
    p1, p2 : float
        Marginal failure probabilities
    rho : float
        Correlation coefficient
    nu : float
        Degrees of freedom for Student-t copula
    
    Returns:
    --------
    P_joint : float
        Joint failure probability
    """
    # For Student-t copula, joint failure probability = C(nu)(1-p1, 1-p2; rho)
    # Note: The copula CDF is evaluated at (1-p1, 1-p2) because failure is a "lower tail" event
    # in the uniform margins
    
    # This is a theoretical calculation. For demonstration purposes, we can use
    # the approximation from the tail dependence structure.
    
    # Simplified calculation using the tail dependence coefficient
    lambda_nu = student_t_tail_dependence(rho, nu)
    
    # Joint failure probability under independence
    P_independent = p1 * p2
    
    # Joint failure probability with tail dependence
    # This is a first-order approximation
    P_joint = P_independent + lambda_nu * min(p1, p2) * (1 - P_independent / min(p1, p2))
    
    return P_joint

# Demonstration
p1, p2 = 0.01, 0.01
rho = 0.5

print("Joint Failure Probability for Two-Layer Safety System")
print(f"Marginal failure probabilities: p1 = {p1}, p2 = {p2}")
print(f"Correlation: rho = {rho}")
print()
print(f"Independence: {p1 * p2:.2e}")
print(f"Gaussian (rho={rho}): {1.2e-4:.2e} (illustrative)")
print(f"Student-t (nu=10): {joint_failure_probability(p1, p2, rho, 10):.2e}")
print(f"Student-t (nu=3): {joint_failure_probability(p1, p2, rho, 3):.2e}")
print()
print("Note: Values are theoretical calculations, not empirical measurements.")
```

