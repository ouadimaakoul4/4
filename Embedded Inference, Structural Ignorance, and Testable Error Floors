# 8.  VISUALISATION
# ═══════════════════════════════════════════════════════════════════════════════
def plot_comparison(results: List[Tuple[Dict, str]],
                    save: Optional[str] = "results.png") -> None:
    n = len(results)
    fig, axes = plt.subplots(2, 3, figsize=(20, 12))
    fig.suptitle("Observer‑Bounded Inference — Multi‑system Comparison",
                 fontweight="bold")
    cols = plt.cm.viridis(np.linspace(0.1, 0.9, max(n, 1)))

    for idx, (res, label) in enumerate(results):
        c = cols[idx]
        t = np.arange(len(res["delta_robust"]))

        axes[0, 0].plot(t, res["delta_robust"], color=c, alpha=0.8, label=label)
        axes[0, 0].axhline(0, color="k", ls="--", alpha=0.3)
        axes[0, 0].set_ylabel(r"$\delta_t^*$")
        axes[0, 0].set_title("Conjecture 1 – Irreducible Error Floor")
        axes[0, 0].set_ylim(0, 1.05)

        axes[0, 1].plot(t, res["pred_error"], color=c, alpha=0.6, label=label)
        axes[0, 1].set_ylabel("BCE Loss")
        axes[0, 1].set_title("Prediction Error")
        axes[0, 1].set_yscale("log")

        axes[0, 2].plot(t, res["epistemic_frac"], color=c, alpha=0.6, label=label)
        axes[0, 2].axhline(0, color="k", ls="--", alpha=0.3)
        axes[0, 2].set_ylabel("Epistemic Fraction")
        axes[0, 2].set_title("Curiosity‑Critic – Learnable vs Irreducible")

        axes[1, 0].plot(t, res["cumulative_energy"], color=c, label=label)
        axes[1, 0].set_ylabel("Cumul. Energy [J]")
        axes[1, 0].set_title("Thermodynamic Cost Proxy")
        axes[1, 0].ticklabel_format(axis="y", style="sci", scilimits=(-20, -20))

        hmap = {"Stable": 1, "Undecided": 0, "Diverging": -1}
        hv = [hmap.get(h, 0) for h in res["H_O"]]
        axes[1, 1].plot(t, hv, color=c, alpha=0.7, label=label)
        axes[1, 1].set_yticks([-1, 0, 1])
        axes[1, 1].set_yticklabels(["Diverging", "Undecided", "Stable"])
        axes[1, 1].set_title(r"Halting Classifier $H_O$")

        # error bar
        axes[1, 2].bar(["Epistemic", "Aleatoric", "Irreducible"],
                       [res["epistemic_frac"][-1] if len(res["epistemic_frac"]) else 0,
                        res.get("irreducible_floor", 0),
                        res.get("irreducible_floor", 0)],
                       color=[c] * 3, alpha=0.7, label=label)
        axes[1, 2].set_title("Final Error Decomposition")

    for ax in axes.flat:
        ax.legend(fontsize=7, loc="best")
        ax.grid(alpha=0.3)
    plt.tight_layout()
    if save:
        plt.savefig(save, dpi=150, bbox_inches="tight")
    plt.show()


def plot_scaling(hs: List[int], dv: List[float],
                 fit: Tuple[float, float, float],
                 save: Optional[str] = "scaling.png") -> None:
    d_inf, A, a = fit
    hf = np.logspace(np.log10(min(hs)), np.log10(max(hs)), 100)
    fv = _power_law(hf, d_inf, A, a)

    plt.figure(figsize=(8, 5))
    plt.scatter(hs, dv, c="red", s=50, zorder=5, label="Measured")
    plt.plot(hf, fv, "b--", label=rf"Fit: $\delta_\infty={d_inf:.3f}$, $\alpha={a:.2f}$")
    plt.axhline(d_inf, color="gray", ls=":", label=rf"$\delta_\infty={d_inf:.3f}$")
    plt.xscale("log")
    plt.xlabel("Hidden size  (model capacity)")
    plt.ylabel(r"$\delta_t^*$  (final mean)")
    plt.title(r"Scaling Law:  $\delta_t^*(N) = \delta_\infty + A \cdot N^{-\alpha}$")
    plt.legend()
    plt.grid(alpha=0.3)
    plt.tight_layout()
    if save:
        plt.savefig(save, dpi=150)
    plt.show()


