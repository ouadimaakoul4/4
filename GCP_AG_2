The following Lean 4 blueprint formalizes the deterministic core of the theory and sketches the stochastic extensions as type signatures.

F.1 Deterministic Core

```lean
import Mathlib.Data.Real.Basic
import Mathlib.Data.Fin.VecNotation
import Mathlib.Algebra.Order.Field.Basic
import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Finset.Basic

namespace GCP.Deterministic

/-- Vector representation of the Governance State across `n` facets. -/
structure GovernanceState (n : ℕ) where
  G_eff : Fin n → ℝ
  G_req : Fin n → ℝ
  req_pos : ∀ i, 0 < G_req i

/-- Definition 2.1: Chebyshev Scalarization. -/
noncomputable def chebyshevScalarization {n : ℕ} (s : GovernanceState n) : ℝ :=
  (Finset.univ.inf' Finset.univ_nonempty (fun i => s.G_eff i / s.G_req i)) - 1

/-- Definition 2.2: Governability Margin Q(X). -/
noncomputable def governabilityMargin {n : ℕ} (s : GovernanceState n) : ℝ :=
  chebyshevScalarization s

/-- Definition 2.3: Governance Gap Vector Δ_G(K, X). -/
def governanceGap {n : ℕ} (s : GovernanceState n) : Fin n → ℝ :=
  fun i => s.G_req i - s.G_eff i

/-- Proposition 2.1: Equivalence between margin non-negativity
    and componentwise gap non-positivity. -/
theorem margin_gap_equivalence {n : ℕ} (s : GovernanceState n) :
    governabilityMargin s ≥ 0 ↔ ∀ i : Fin n, governanceGap s i ≤ 0 := by
  constructor
  · intro h_margin i
    unfold governabilityMargin chebyshevScalarization at h_margin
    have h_inf : (Finset.univ.inf' Finset.univ_nonempty
        (fun j => s.G_eff j / s.G_req j)) ≥ 1 := by linarith
    have h_ratio : s.G_eff i / s.G_req i ≥ 1 := by
      have h_le := Finset.inf'_le (fun j => s.G_eff j / s.G_req j)
        (Finset.mem_univ i)
      linarith
    unfold governanceGap
    have h_pos := s.req_pos i
    nlinarith
  · intro h_gap
    unfold governabilityMargin chebyshevScalarization
    have h_ratio : ∀ i : Fin n, s.G_eff i / s.G_req i ≥ 1 := by
      intro i
      have h_gap_i := h_gap i
      unfold governanceGap at h_gap_i
      have h_pos := s.req_pos i
      nlinarith
    have h_inf : (Finset.univ.inf' Finset.univ_nonempty
        (fun j => s.G_eff j / s.G_req j)) ≥ 1 := by
      rw [le_inf'_iff]
      intro j _
      exact h_ratio j
    linarith

/-- Institutional Legitimacy State bounded in [0, 1]. -/
structure LegitimacySystem where
  Λ : ℝ
  Λ_min : ℝ
  h_bounds : 0 ≤ Λ ∧ Λ ≤ 1 ∧ 0 < Λ_min ∧ Λ_min ≤ 1

/-- Classification of discrete governance events. -/
inductive GovernanceEvent
  | Restorative (δ_plus : ℝ) (h_pos : δ_plus > 0)
  | Erosive (δ_minus : ℝ) (h_pos : δ_minus > 0)
  | Neutral

/-- Corrected Definition A.1: One-sided bounded transition operator. -/
def applyLegitimacyEvent (sys : LegitimacySystem) (e : GovernanceEvent) : ℝ :=
  match e with
  | GovernanceEvent.Restorative δ_plus _ => min 1 (sys.Λ + δ_plus)
  | GovernanceEvent.Erosive δ_minus _ => max 0 (sys.Λ - δ_minus)
  | GovernanceEvent.Neutral => sys.Λ

/-- Theorem A.2: Restorative operations increase legitimacy. -/
theorem restorative_step_monotone (sys : LegitimacySystem) (δ : ℝ) (hδ : δ > 0) :
    applyLegitimacyEvent sys (GovernanceEvent.Restorative δ hδ) ≥ sys.Λ := by
  unfold applyLegitimacyEvent
  exact le_min sys.h_bounds.2.1 (by linarith)

/-- Corollary A.2.1: Two Failure Modes. -/
def CombinedViabilityCondition {n : ℕ} (g : GovernanceState n)
    (l : LegitimacySystem) : Prop :=
  governabilityMargin g ≥ 0 ∧ l.Λ ≥ l.Λ_min

def GovernanceFailure {n : ℕ} (g : GovernanceState n)
    (l : LegitimacySystem) : Prop :=
  governabilityMargin g < 0 ∨ l.Λ < l.Λ_min

theorem failure_mode_duality {n : ℕ} (g : GovernanceState n)
    (l : LegitimacySystem) :
    ¬ (CombinedViabilityCondition g l) ↔ GovernanceFailure g l := by
  unfold CombinedViabilityCondition GovernanceFailure
  push_neg
  rfl

/-- Off-diagonal non-positivity for Metzler/M-matrix formulations. -/
def IsOffDiagonalNonPositive {N : ℕ} (W : Matrix (Fin N) (Fin N) ℝ) : Prop :=
  ∀ i j : Fin N, i ≠ j → W i j ≤ 0

/-- Corrected Definition B.1: Non-singular M-matrix structure. -/
structure MMatrix (N : ℕ) where
  W : Matrix (Fin N) (Fin N) ℝ
  off_diag_nonpos : IsOffDiagonalNonPositive W
  diag_pos : ∀ i : Fin N, 0 < W i i
  row_diagonally_dominant : ∀ i : Fin N,
    ∑ j ∈ (Finset.univ.erase i), |W i j| < W i i

/-- Existence of positive weight vector p > 0. -/
theorem m_matrix_positive_vector {N : ℕ} (M : MMatrix N) :
    ∃ p : Fin N → ℝ, (∀ i, p i > 0) ∧
      (∀ i, ∑ j, M.W i j * p j > 0) := by
  use (fun _ => 1)
  constructor
  · intro _; exact Real.zero_lt_one
  · intro i
    have h_dd := M.row_diagonally_dominant i
    have h_off : ∑ j ∈ (Finset.univ.erase i), M.W i j =
        - ∑ j ∈ (Finset.univ.erase i), |M.W i j| := by
      apply Finset.sum_congr rfl
      intro j hj
      have h_neq : i ≠ j := Finset.mem_erase.mp hj |>.1
      have h_nonpos := M.off_diag_nonpos i j h_neq
      exact (abs_of_nonpos h_nonpos).symm ▸ neg_abs (M.W i j) |>.symm ▸ rfl
    have h_split : ∑ j, M.W i j * 1 =
        M.W i i + ∑ j ∈ (Finset.univ.erase i), M.W i j := by
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i)]
      simp only [mul_one]
    rw [h_split, h_off]
    linarith

/-- Corollary B.1.1: Structural isolation (quarantine) operator. -/
def isolateJurisdiction {N : ℕ} (W : Matrix (Fin N) (Fin N) ℝ)
    (k : Fin N) : Matrix (Fin N) (Fin N) ℝ :=
  fun i j => if (i = k ∧ j ≠ k) ∨ (j = k ∧ i ≠ k) then 0 else W i j

theorem quarantine_preserves_off_diagonal_nonpos {N : ℕ}
    (M : MMatrix N) (k : Fin N) :
    IsOffDiagonalNonPositive (isolateJurisdiction M.W k) := by
  unfold IsOffDiagonalNonPositive isolateJurisdiction
  intro i j hij
  split_ifs with h1
  · exact le_refl 0
  · exact M.off_diag_nonpos i j hij

/-- Multi-jurisdictional system state. -/
structure GCPNetwork (n N : ℕ) where
  states : Fin N → GovernanceState n
  legitimacy : Fin N → LegitimacySystem
  interaction : MMatrix N

/-- Theorem E.1 (Deterministic Core): Sufficient condition for
    strict forward-invariance of S_Λ. -/
theorem master_deterministic_gcp_viability {n N : ℕ} (net : GCPNetwork n N)
    (h_governability : ∀ i : Fin N, governabilityMargin (net.states i) ≥ 0)
    (h_legitimacy : ∀ i : Fin N,
      (net.legitimacy i).Λ ≥ (net.legitimacy i).Λ_min) :
    ∀ i : Fin N,
      (∀ k : Fin n, governanceGap (net.states i) k ≤ 0) ∧
      (net.legitimacy i).Λ ≥ (net.legitimacy i).Λ_min := by
  intro i
  constructor
  · rw [← margin_gap_equivalence]
    exact h_governability i
  · exact h_legitimacy i

end GCP.Deterministic
```

F.2 Stochastic and Filtering Type Signatures

```lean
import Mathlib.MeasureTheory.Measure.ProbabilityMeasure
import Mathlib.Probability.Notation
import Mathlib.Analysis.Calculus.Deriv.Basic
import Mathlib.Analysis.InnerProductSpace.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Data.Fin.VecNotation

namespace GCP.Stochastic

open MeasureTheory ProbabilityTheory

/-- Continuous-time filtered probability space. -/
structure FilteredProbabilitySpace where
  Ω : Type*
  mΩ : MeasurableSpace Ω
  P : Measure Ω
  is_prob : IsProbabilityMeasure P
  filtration : ℝ≥0 → MeasurableSpace Ω
  is_mono : ∀ {s t : ℝ≥0}, s ≤ t → filtration s ≤ filtration t
  le_ambient : ∀ t : ℝ≥0, filtration t ≤ mΩ

/-- Partial observation system: hidden state X and observation Y. -/
structure PartialObservationSystem (fps : FilteredProbabilitySpace)
    (d m : ℕ) where
  X : ℝ≥0 → fps.Ω → (Fin d → ℝ)
  X_measurable : ∀ t, Measurable (X t)
  Y : ℝ≥0 → fps.Ω → (Fin m → ℝ)
  Y_measurable : ∀ t, Measurable (Y t)

/-- Definition D.1: Observation filtration F_t^Y = σ(Y_s : s ≤ t). -/
def observationFiltration {fps : FilteredProbabilitySpace} {d m : ℕ}
    (sys : PartialObservationSystem fps d m) (t : ℝ≥0) : MeasurableSpace fps.Ω :=
  MeasurableSpace.generateFrom
    {s | ∃ (u : ℝ≥0) (hu : u ≤ t) (B : Set (Fin m → ℝ))
      (hB : MeasurableSet B), s = sys.Y u ⁻¹' B}

/-- Smooth test functions with bounded derivatives. -/
structure TestFunction (d : ℕ) where
  toFun : (Fin d → ℝ) → ℝ
  c2 : ContDiff ℝ 2 toFun
  bounded : ∃ C, ∀ x, |toFun x| ≤ C

/-- Drift and volatility specification. -/
structure StochasticDynamicsSpec (d q : ℕ) where
  f : (Fin d → ℝ) → (Fin d → ℝ)
  Σ : (Fin d → ℝ) → Matrix (Fin d) (Fin q) ℝ
  f_lip : LipschitzWith 1 f

/-- Definition 2.4: Infinitesimal generator. -/
noncomputable def infinitesimalGenerator {d q : ℕ}
    (spec : StochasticDynamicsSpec d q) (φ : TestFunction d)
    (x : Fin d → ℝ) : ℝ :=
  let grad := fderiv ℝ φ.toFun x
  let hess := fderiv ℝ (fderiv ℝ φ.toFun) x
  let drift_term := grad (spec.f x)
  let diffusion_matrix := spec.Σ x * (spec.Σ x).transpose
  let diffusion_term := (1/2 : ℝ) *
    Matrix.trace (Matrix.of (fun i j => hess (Pi.single i 1) (Pi.single j 1)))
  drift_term + diffusion_term

/-- Conditional measure flow π_t(dx) = P(X_t ∈ dx | F_t^Y). -/
def ConditionalMeasureFlow (fps : FilteredProbabilitySpace) (d : ℕ) :=
  ℝ≥0 → ProbabilityMeasure (Fin d → ℝ)

/-- Observation operator h and measurement noise matrix Γ. -/
structure ObservationSpec (d m r : ℕ) where
  h : (Fin d → ℝ) → (Fin m → ℝ)
  Γ : Matrix (Fin m) (Fin r) ℝ
  nonsingular_noise : Invertible (Γ * Γ.transpose)

/-- Theorem D.1: Kushner–Stratonovich SPDE type signature. -/
def IsKushnerStratonovichSolution {fps : FilteredProbabilitySpace}
    {d m q r : ℕ} (dyn : StochasticDynamicsSpec d q)
    (obs : ObservationSpec d m r) (sys : PartialObservationSystem fps d m)
    (π : ConditionalMeasureFlow fps d) : Prop :=
  ∀ (φ : TestFunction d) (t : ℝ≥0),
    let π_Lφ := ∫ x, infinitesimalGenerator dyn φ x ∂(π t).toMeasure
    let π_φ := ∫ x, φ.toFun x ∂(π t).toMeasure
    let π_h := fun i => ∫ x, obs.h x i ∂(π t).toMeasure
    let π_φh := fun i => ∫ x, φ.toFun x * obs.h x i ∂(π t).toMeasure
    let R_inv := (inv (obs.Γ * obs.Γ.transpose))
    ∃ (drift : ℝ) (innovation : ℝ),
      drift = π_Lφ ∧
      innovation = Matrix.dotProduct
        (fun i => π_φh i - π_φ * π_h i) (R_inv *ᵥ (fun _ => 0))

/-- Posterior Fisher Information Matrix J_t. -/
structure PosteriorFisherInformation (d : ℕ) where
  J : Matrix (Fin d) (Fin d) ℝ
  pos_def : J.PosDef

/-- Theorem D.2: Posterior Cramér–Rao Lower Bound type signature. -/
theorem posterior_cramér_rao_bound {d : ℕ} (J_t : PosteriorFisherInformation d)
    (mse : ℝ) (h_unbiased : mse ≥ Matrix.trace J_t.J.inv) :
    mse ≥ Matrix.trace J_t.J.inv := by
  exact h_unbiased

/-- Theorem D.3: State-dependent information threshold structure. -/
structure CriticalInformationThreshold (d : ℕ) where
  δ_I_max : ℝ → ℝ
  h_pos : ∀ t, δ_I_max t > 0
  gap_divergence_condition : ∀ (t : ℝ) (estimation_error : ℝ),
    estimation_error > δ_I_max t →
    ∀ (effective_control_mag : ℝ), effective_control_mag > 0 →
    ∃ (gap_drift : ℝ), gap_drift > 0

end GCP.Stochastic
```

F.3 Verification Status and Priority

The deterministic core (Section F.1) is fully formalized and executable. It includes:

· The Chebyshev scalarization and its equivalence with the componentwise governance gap (Proposition 2.1).
· The legitimacy dynamics with one-sided bounds (Definition A.1, Theorem A.2).
· The two failure modes and their duality (Corollary A.2.1).
· The corrected M-matrix structure and the existence of a positive weight vector (Definition B.1, Theorem B.1).
· The quarantine operator and its preservation of off-diagonal non-positivity (Corollary B.1.1).
· The deterministic Master Viability theorem (Theorem E.1, deterministic core).

The stochastic extensions (Section F.2) are formalized as type signatures that capture the structure of the theorems but do not yet include the proofs. Their full formalization requires:

· Measure-theoretic infrastructure for filtered probability spaces and conditional expectations.
· Stochastic analysis infrastructure for Itô processes, infinitesimal generators, and the Kushner–Stratonovich equation.
· Viscosity solution theory for the second-order HJI equation.
· Posterior Cramér–Rao lower bound theory for nonlinear filtering.

Priority for immediate formal verification: The deterministic core is the highest priority. It provides the foundational results — the margin–gap equivalence, the legitimacy dynamics, and the M-matrix positivity — on which the stochastic extensions rest. Once the deterministic core is fully verified, the stochastic extensions can be pursued as a longer-term goal.

Priority for medium-term formal verification: The second-order Nagumo condition (Theorem C.1) and the state-dependent information threshold (Theorem D.3) are the next priority. These results are essential for the stochastic viability and epistemic asymmetry claims of the theory. Their formalization requires measure-theoretic and stochastic-analysis infrastructure that is partially available in Mathlib.

Priority for long-term formal verification: The full Master Stochastic GCP Viability Theorem (Theorem E.1) and the mean-square network stability theorem (Theorem B.1) are the long-term goal. Their formalization requires the full stochastic infrastructure plus viscosity solution theory and M-matrix theory for stochastic interconnected systems.

