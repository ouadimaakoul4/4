Appendix B: Implementation Notes and Reference Architecture

A reference implementation of the scale‑normalized star‑topology alignment loss and the differentiable self‑model router is provided in PyTorch. The loss modules are designed to be modular and pluggable into any multi‑encoder architecture.

B.1 Scale‑Normalized Star‑Topology Alignment Loss

```python
import torch
import torch.nn as nn
import torch.nn.functional as F

class ScaleNormalizedStarAlignmentLoss(nn.Module):
    def __init__(self, gamma_var: float = 1.0, eps: float = 1e-5):
        super().__init__()
        self.gamma_var = gamma_var
        self.eps = eps

    def compute_normalized_distance_matrix(self, x: torch.Tensor, p: float = 2.0) -> torch.Tensor:
        """Computes mean-normalized pairwise distance matrix."""
        D = torch.cdist(x, x, p=p)
        mean_d = D.mean() + self.eps
        return D / mean_d

    def vicreg_regularization(self, Z: torch.Tensor) -> torch.Tensor:
        """Variance and Covariance regularization to prevent representation collapse."""
        N, D_dim = Z.shape
        Z_centered = Z - Z.mean(dim=0)
        # Variance Loss: force feature std dev towards target gamma_var
        std = torch.sqrt(Z_centered.var(dim=0) + self.eps)
        var_loss = torch.mean(F.relu(self.gamma_var - std))
        # Covariance Loss: decorrelate distinct latent features
        cov_matrix = (Z_centered.T @ Z_centered) / (N - 1)
        off_diag = cov_matrix.pow(2).sum() - cov_matrix.diag().pow(2).sum()
        cov_loss = off_diag / D_dim
        return var_loss + cov_loss

    def forward(self, geometries: dict[str, torch.Tensor], z_core: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
        D_core_norm = self.compute_normalized_distance_matrix(z_core)
        loss_cgc = torch.tensor(0.0, device=z_core.device)
        loss_reg = self.vicreg_regularization(z_core)
        for name, z_i in geometries.items():
            D_i_norm = self.compute_normalized_distance_matrix(z_i)
            # Star topology alignment: || D_i_norm - D_core_norm ||^2
            loss_cgc += F.mse_loss(D_i_norm, D_core_norm)
            loss_reg += self.vicreg_regularization(z_i)
        return loss_cgc, loss_reg
```

B.2 Differentiable Self‑Model Router

```python
class DifferentiableSelfModelRouter(nn.Module):
    def __init__(self, query_dim: int, core_dim: int, num_geometries: int, hidden_dim: int = 64):
        super().__init__()
        self.mlp = nn.Sequential(
            nn.Linear(query_dim + core_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, num_geometries)
        )

    def forward(self, z_query: torch.Tensor, z_core: torch.Tensor, temperature: float = 1.0) -> tuple[torch.Tensor, torch.Tensor]:
        combined_input = torch.cat([z_query, z_core], dim=-1)
        logits = self.mlp(combined_input)
        weights = F.softmax(logits / temperature, dim=-1)
        # Entropy penalty to encourage balanced exploration across geometries
        entropy = -torch.sum(weights * torch.log(weights + 1e-8), dim=-1).mean()
        return weights, entropy
```

