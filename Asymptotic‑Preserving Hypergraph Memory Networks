### B.1 Stable AP-Attention with Chebyshev Truncation

```python
import torch
import math
from scipy.sparse.linalg import expm_multiply
from scipy.sparse import eye as speye

def stable_ap_attention(Q, K, V, L_seq, epsilon, t=1.0, delta=1e-6):
    """
    Q, K, V: [batch_size, n, d]
    L_seq:    sparse matrix [n, n] (normalized Laplacian)
    epsilon:  scalar regime parameter
    t:        diffusion time
    delta:    tolerance for Chebyshev truncation
    Returns:
      output: [batch_size, n, d]
      approx_error: Frobenius error estimate
    """
    batch_size, n, d = Q.shape

    # 1. Transport attention
    scores = torch.matmul(Q, K.transpose(-2, -1)) / math.sqrt(d)
    A_trans = torch.softmax(scores, dim=-1)  # [b, n, n]

    # 2. Diffusion attention via matrix exponential
    #    Use Krylov subspace method for large n
    #    For n <= 512, dense expm is okay; else use expm_multiply.
    if n <= 512:
        L_dense = L_seq.toarray()
        A_diff_full = torch.tensor(scipy.linalg.expm(-t * L_dense), dtype=torch.float32)
        A_diff = A_diff_full.unsqueeze(0).repeat(batch_size, 1, 1)
        approx_error = 0.0
    else:
        # Krylov approximation with error controlled by delta
        # Use expm_multiply on the identity matrix
        I = speye(n, format='csr')
        A_diff_list = []
        for b in range(batch_size):
            A_diff_b = expm_multiply(-t * L_seq, I, traceA=None)
            A_diff_list.append(torch.tensor(A_diff_b, dtype=torch.float32))
        A_diff = torch.stack(A_diff_list, dim=0)  # [b, n, n]
        # Approximate error from the tail of the Chebyshev series
        # We'll compute once per batch using a simple power iteration estimate.
        lambda_max = sparse_lambda_max_estimate(L_seq)
        K = int(math.ceil(t * lambda_max / 2 + math.log(1/delta))) + 5
        # Chebyshev error bound from Marcotte et al. (2021) for exp(-tL)
        approx_error = math.exp(-K**2 / (2*t*lambda_max))  # conservative

    # 3. Blend
    A_ap = (1 - epsilon) * A_diff + epsilon * A_trans

    # 4. Apply to V
    output = torch.matmul(A_ap, V)  # [b, n, d]

    return output, approx_error
```

### B.2 Hypergraph Insertion with Adaptive Basis

```python
import torch
import torch.nn.functional as F
from scipy.linalg import qr  # Householder QR for stable basis

class HypergraphMemory:
    def __init__(self, d, max_vertices, max_hyperedges, basis_dim=64):
        self.d = d
        self.max_vertices = max_vertices
        self.max_hyperedges = max_hyperedges
        self.vertices = torch.zeros(max_vertices, d)   # learnable parameters
        self.vertex_mask = torch.zeros(max_vertices, dtype=torch.bool)
        self.hyperedges = torch.zeros(max_hyperedges, d)
        self.hyperedge_mask = torch.zeros(max_hyperedges, dtype=torch.bool)
        self.incidence = torch.sparse_coo_tensor(
            torch.empty(2,0,dtype=torch.long),
            torch.empty(0),
            (max_vertices, max_hyperedges)
        )
        # Adaptive basis (built once from concept vectors)
        self.basis = None  # [basis_dim, d]
        self.basis_dim = basis_dim

    def build_basis(self, concept_vectors):
        # concept_vectors: [num_concepts, d]
        # Use Householder QR for numerical stability
        Q, R = qr(concept_vectors.numpy().T, mode='economic')
        self.basis = torch.tensor(Q.T[:self.basis_dim], dtype=torch.float32)
        # Normalize rows
        self.basis = F.normalize(self.basis, dim=-1)

    def insert(self, new_embeddings, epsilon):
        # new_embeddings: [num_new, d]
        num_new = new_embeddings.size(0)
        # Find free slots
        free_v = torch.where(~self.vertex_mask)[0][:num_new]
        assert len(free_v) == num_new, "Not enough vertex space"

        # Insert vertices
        self.vertices[free_v] = new_embeddings
        self.vertex_mask[free_v] = True

        # Update incidence matrix
        active_e = torch.where(self.hyperedge_mask)[0]
        if len(active_e) > 0:
            e_embeds = self.hyperedges[active_e]  # [num_e, d]
            # Compute similarity to each hyperedge
            sim = torch.matmul(new_embeddings, e_embeds.t())  # [num_new, num_e]
            # Softmax per hyperedge
            h_new = torch.softmax(sim / 0.1, dim=1)  # normalize across vertices for each edge? Actually per edge we want normalization over vertices in that edge.
            # Simplified: assign weight proportional to similarity, then re-normalize columns later.
            # For brevity, we skip full re-normalization here; in practice update H matrix columns.
        # (Full code would update the sparse incidence matrix with new columns and recompute Laplacian)
        return free_v
```

### B.3 Hyperedge Merge Operation

```python
def merge_hyperedges(self, idx_i, idx_j, epsilon):
    """
    Merge two hyperedges i and j if similarity > threshold(epsilon).
    Returns new index if merged, else None.
    """
    e_i = self.hyperedges[idx_i]
    e_j = self.hyperedges[idx_j]
    sim = F.cosine_similarity(e_i, e_j, dim=0).item()
    threshold = 0.7 + (1-epsilon)*0.2  # τ(ε)
    if sim > threshold:
        beta = sim * epsilon
        e_new = beta * e_i + (1-beta) * e_j
        e_new = F.normalize(e_new, dim=0)
        # Find free slot
        free_e = torch.where(~self.hyperedge_mask)[0][0]
        self.hyperedges[free_e] = e_new
        self.hyperedge_mask[free_e] = True
        # Remove old edges
        self.hyperedge_mask[idx_i] = False
        self.hyperedge_mask[idx_j] = False
        # Update incidence (union of vertices) ...
        return free_e
    return None
```

### B.4 Training Step with AP Loss and ε-Curriculum

```python
def train_step(model, batch, epsilon_current, optimizer):
    # Sample epsilon from truncated normal around current
    eps = torch.normal(epsilon_current, 0.05).clamp(0.0, 1.0)
    # Forward pass
    output, memory_state = model(batch.input, epsilon=eps)
    # Compute pure diffusion output (epsilon=0) for AP loss
    with torch.no_grad():
        output_diff, _ = model(batch.input, epsilon=0.0)
    # Task loss
    loss_task = F.cross_entropy(output.logits, batch.target)
    # AP consistency loss
    loss_ap = torch.mean((output.logits - output_diff.logits)**2)
    # Memory coherence loss
    coherence = memory_state.compute_coherence()
    loss_mem = -coherence
    # Regularization
    loss_reg = sum(p.norm(2) for p in model.parameters())
    # Total
    total_loss = loss_task + 0.1*loss_ap + 0.05*loss_mem + 0.01*loss_reg
    optimizer.zero_grad()
    total_loss.backward()
    torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
    optimizer.step()
    return total_loss.item()
```

