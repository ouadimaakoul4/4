-- Compilation to LTL_f --

compile(BOUNDED_ACTION_SEQUENCE) = 
  G( (∧_{a ∈ allowed_actions} X a) 
     ∧ G(∧_{(f,t) ∈ forbidden_transitions} (f → X ¬t))
     ∧ ∧_{a ∈ max_occurrences} (#a ≤ max_occurrences[a]) )

compile(DENY_TRANSITION) = 
  G( from_action → X ¬to_action )

compile(REQUIRE_PRIOR) = 
  G( target_action → F prior_action )

compile(RATE_LIMIT) = 
  G( #action ≤ max_per_window U (window_seconds elapsed) )

compile(HUMAN_APPROVAL_GATE) = 
  G( trigger_action → (¬trigger_action U approval) )

compile(CONDITIONAL_REQUIREMENT) = 
  G( condition → X required_action )

compile(TEMPORAL_ORDERING) = 
  G( first_action → F_{≤max_delay} second_action )

compile(DATA_FLOW_CONSTRAINT) = 
  G( source ∧ X sink → allowed )

compile(RESOURCE_QUOTA) = 
  G( Σ_{t} usage(t) ≤ max_usage )

compile(GEOGRAPHIC_RESTRICTION) = 
  G( region ∈ allowed_regions )

compile(TEMPORAL_WINDOW) = 
  G( current_time ∈ [start_time, end_time] )

compile(DELEGATION_DEPTH_LIMIT) = 
  G( delegation_depth ≤ max_depth )

compile(REVERSIBILITY_REQUIREMENT) = 
  G( reversibility ≥ min_reversibility )

compile(REPUTATION_THRESHOLD) = 
  G( reputation ≥ min_reputation )

compile(AND(E1, E2)) = compile(E1) ∧ compile(E2)
compile(OR(E1, E2)) = compile(E1) ∨ compile(E2)
compile(UNTIL(E1, E2)) = compile(E1) U compile(E2)
