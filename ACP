I.1 BPF Filter Pseudo-Code

```
// Hardened seccomp-bpf filter for ACP agent sandbox

// Step 1: Validate architecture
BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, arch))
BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_X86_64, 1, 0)
BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS)

// Step 2: Load syscall number and mask off x32 bit
BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr))
BPF_STMT(BPF_ALU | BPF_AND | BPF_K, ~__X32_SYSCALL_BIT)

// Step 3: Check against allowed syscall list
// For each allowed syscall σ:
BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, σ, 0, 1)
BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW)

// Step 4: Restrict FD manipulation syscalls
BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_dup, 0, 1)
BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_TRACE)
BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_dup2, 0, 1)
BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_TRACE)
BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_dup3, 0, 1)
BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_TRACE)
BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_fcntl, 0, 1)
BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_TRACE)

// Step 5: Default deny with ENOSYS
BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | (ENOSYS & SECCOMP_RET_DATA))
