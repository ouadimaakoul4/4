import torch
import torch.nn as nn
import torch.nn.functional as F
from typing import Tuple, List, Optional
import numpy as np
from dataclasses import dataclass

# =============================================================================
# Parameter Configuration
# =============================================================================

@dataclass
class InteroceptiveParameters:
    """Physiological parameters for interoceptive precision dynamics."""
    k_r: float = 0.5          # Restoration gain
    mu: float = 0.1           # Precision decay rate
    kappa: float = 2.0        # Arousal coupling
    eta: float = 1.0          # Saturation parameter
    sigma_delta: float = 0.05 # Innovation noise intensity
    sigma_pi: float = 0.02    # Precision noise intensity
    pi_0: float = 1.0         # Baseline precision
    pi_max: float = 10.0      # Maximum precision
    rho: float = 0.01         # Metabolic discount rate
    gamma_1: float = 0.1      # Basal maintenance cost
    gamma_2: float = 1.0      # Control effort cost

# =============================================================================
# Adjoint Sensitivity Function
# =============================================================================

class InteroceptiveSDEAdjointFunction(torch.autograd.Function):
    """
    Custom autograd function executing continuous-time stochastic adjoint 
    sensitivity integration for interoceptive precision dynamics.
    Memory Complexity: O(1) with respect to trajectory time steps T.
    """
    
    @staticmethod
    def forward(ctx, delta_0, pi_tilde_0, theta, t_span, noise_seeds, 
                pi_0, pi_max):
        """
        Forward integration loop using Euler-Maruyama SDE solver.
        """
        batch_size, state_dim = delta_0.shape
        num_steps = t_span.size(0)
        delta_pi_max = pi_max - pi_0
        
        k_r, mu, kappa, eta, sigma_delta, sigma_pi = theta
        
        delta = delta_0.clone()
        pi_tilde = pi_tilde_0.clone()
        
        ctx.pi_0 = pi_0
        ctx.pi_max = pi_max
        ctx.delta_pi_max = delta_pi_max
        ctx.save_for_backward(delta_0, pi_tilde_0, theta, t_span, noise_seeds)
        
        for step in range(num_steps - 1):
            dt = t_span[step + 1] - t_span[step]
            sqrt_dt = torch.sqrt(dt)
            
            dW1 = noise_seeds[step, :, :state_dim] * sqrt_dt
            dW2 = noise_seeds[step, :, state_dim:] * sqrt_dt
            
            delta_sq = torch.sum(delta ** 2, dim=-1, keepdim=True)
            delta_norm = torch.sqrt(delta_sq + 1e-8)
            pi_total = pi_0 + pi_tilde
            
            f_delta = -k_r * pi_total * delta
            g_delta = sigma_delta * delta_norm
            drive = torch.tanh(delta_sq / eta)
            f_pi = -mu * pi_tilde + kappa * drive * (delta_pi_max - pi_tilde)
            g_pi = sigma_pi * pi_tilde
            
            delta = delta + f_delta * dt + g_delta * dW1
            pi_tilde = torch.clamp(pi_tilde + f_pi * dt + g_pi * dW2, 
                                   0.0, delta_pi_max)
        
        return delta, pi_tilde
    
    @staticmethod
    def backward(ctx, grad_delta_T, grad_pi_tilde_T):
        """
        Backward Adjoint Integration Loop.
        """
        delta_0, pi_tilde_0, theta, t_span, noise_seeds = ctx.saved_tensors
        pi_0 = ctx.pi_0
        pi_max = ctx.pi_max
        delta_pi_max = ctx.delta_pi_max
        
        batch_size, state_dim = grad_delta_T.shape
        num_steps = t_span.size(0)
        
        # Re-run forward pass
        delta_history = [delta_0]
        pi_history = [pi_tilde_0]
        delta_curr = delta_0.clone()
        pi_curr = pi_tilde_0.clone()
        
        k_r, mu, kappa, eta, sigma_delta, sigma_pi = theta
        
        for step in range(num_steps - 1):
            dt = t_span[step + 1] - t_span[step]
            sqrt_dt = torch.sqrt(dt)
            dW1 = noise_seeds[step, :, :state_dim] * sqrt_dt
            dW2 = noise_seeds[step, :, state_dim:] * sqrt_dt
            
            delta_sq = torch.sum(delta_curr ** 2, dim=-1, keepdim=True)
            delta_norm = torch.sqrt(delta_sq + 1e-8)
            f_delta = -k_r * (pi_0 + pi_curr) * delta_curr
            g_delta = sigma_delta * delta_norm
            drive = torch.tanh(delta_sq / eta)
            f_pi = -mu * pi_curr + kappa * drive * (delta_pi_max - pi_curr)
            g_pi = sigma_pi * pi_curr
            
            delta_curr = delta_curr + f_delta * dt + g_delta * dW1
            pi_curr = torch.clamp(pi_curr + f_pi * dt + g_pi * dW2, 
                                  0.0, delta_pi_max)
            
            delta_history.append(delta_curr)
            pi_history.append(pi_curr)
        
        # Initialize adjoints
        a_delta = grad_delta_T.clone()
        a_pi = grad_pi_tilde_T.clone()
        a_theta = torch.zeros_like(theta)
        
        # Backward integration
        for step in reversed(range(num_steps - 1)):
            dt = t_span[step + 1] - t_span[step]
            sqrt_dt = torch.sqrt(dt)
            dW1 = noise_seeds[step, :, :state_dim] * sqrt_dt
            dW2 = noise_seeds[step, :, state_dim:] * sqrt_dt
            
            delta_t = delta_history[step]
            pi_t = pi_history[step]
            delta_sq = torch.sum(delta_t ** 2, dim=-1, keepdim=True)
            delta_norm = torch.sqrt(delta_sq + 1e-8)
            pi_total = pi_0 + pi_t
            drive = torch.tanh(delta_sq / eta)
            
            # Jacobians
            df_delta_ddelta = -k_r * pi_total
            df_delta_dpi = -k_r * delta_t
            dtanh = 1.0 - drive ** 2
            df_pi_ddelta = kappa * dtanh * (2.0 * delta_t / eta) * (delta_pi_max - pi_t)
            df_pi_dpi = -mu - kappa * drive
            
            # Parameter sensitivities
            df_dk_r = -pi_total * delta_t
            df_dmu = -pi_t
            df_dkappa = drive * (delta_pi_max - pi_t)
            df_deta = -kappa * dtanh * (delta_sq / (eta ** 2)) * (delta_pi_max - pi_t)
            dg_dsigma_delta = delta_norm * dW1
            dg_dsigma_pi = pi_t * dW2
            
            # Adjoint propagation
            da_delta = (df_delta_ddelta * a_delta + df_pi_ddelta * a_pi) * dt
            da_pi = (torch.sum(df_delta_dpi * a_delta, dim=-1, keepdim=True) 
                     + df_pi_dpi * a_pi) * dt
            da_pi = da_pi + (sigma_pi * dW2) * a_pi
            
            a_delta = a_delta + da_delta
            a_pi = a_pi + da_pi
            
            # Accumulate parameter gradients
            a_theta[0] += torch.sum(a_delta * df_dk_r).item() * dt.item()
            a_theta[1] += torch.sum(a_pi * df_dmu).item() * dt.item()
            a_theta[2] += torch.sum(a_pi * df_dkappa).item() * dt.item()
            a_theta[3] += torch.sum(a_pi * df_deta).item() * dt.item()
            a_theta[4] += torch.sum(a_delta * dg_dsigma_delta).item()
            a_theta[5] += torch.sum(a_pi * dg_dsigma_pi).item()
        
        return a_delta, a_pi, a_theta, None, None, None, None

# =============================================================================
# Module Wrapper
# =============================================================================

class InteroceptiveAdjointLayer(nn.Module):
    """
    Module wrapping the InteroceptiveSDEAdjointFunction.
    """
    def __init__(self, state_dim: int, params: InteroceptiveParameters):
        super().__init__()
        self.state_dim = state_dim
        self.pi_0 = params.pi_0
        self.pi_max = params.pi_max
        
        self.log_theta = nn.Parameter(torch.tensor([
            torch.log(torch.tensor(params.k_r)),
            torch.log(torch.tensor(params.mu)),
            torch.log(torch.tensor(params.kappa)),
            torch.log(torch.tensor(params.eta)),
            torch.log(torch.tensor(params.sigma_delta)),
            torch.log(torch.tensor(params.sigma_pi))
        ], dtype=torch.float32))
    
    def forward(self, delta_0, pi_tilde_0, t_span, seed=42):
        theta = torch.exp(self.log_theta)
        torch.manual_seed(seed)
        num_steps = t_span.size(0)
        batch_size = delta_0.size(0)
        noise_seeds = torch.randn(num_steps, batch_size, self.state_dim + 1,
                                  device=delta_0.device)
        return InteroceptiveSDEAdjointFunction.apply(
            delta_0, pi_tilde_0, theta, t_span, noise_seeds,
            self.pi_0, self.pi_max
        )

# =============================================================================
# Primary Affective System
# =============================================================================

class PrimaryAffectiveSystem(nn.Module):
    """
    Seven-dimensional primary affective system (Panksepp).
    """
    def __init__(self, e_dim: int):
        super().__init__()
        # Sensitivity vectors for each primary system
        self.omega = nn.Parameter(torch.randn(7, e_dim) * 0.1)
        self.theta = nn.Parameter(torch.zeros(7))
        
        # Circumplex projection matrix
        W = torch.tensor([
            [+0.80, -0.70, -0.90, +0.65, +0.85, -0.80, +0.90],
            [+0.75, +0.90, +0.85, +0.80, +0.25, +0.70, +0.65]
        ], dtype=torch.float32)
        self.register_buffer('W', W)
        
        # Subcortical residual tensor
        D = torch.tensor([
            [+0.10, -0.15, -0.30, 0.00, +0.05, -0.25, +0.15],
            [+0.20, +0.35, +0.45, +0.10, -0.10, +0.30, -0.05]
        ], dtype=torch.float32)
        self.register_buffer('D', D)
        
        # Global sensitivity matrix
        self.alpha_v = nn.Parameter(torch.tensor(1.0))
        self.kappa_a = nn.Parameter(torch.tensor(1.0))
        self.theta_a = nn.Parameter(torch.tensor(0.5))
    
    def forward(self, e_t: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, 
                                                    torch.Tensor, torch.Tensor]:
        """
        Input: e_t [batch, e_dim] - interoceptive prediction error
        Output: v_t [batch], a_t [batch], gamma_t [batch], beta_t [batch]
        """
        # Primary system activations
        logits = torch.matmul(e_t, self.omega.T) - self.theta
        p_t = torch.sigmoid(logits)  # [batch, 7]
        
        # Circumplex projection
        v_t = torch.tanh(torch.matmul(p_t, self.W[0]))  # valence
        a_t = torch.sigmoid(torch.matmul(p_t, self.W[1]) - self.theta_a)  # arousal
        
        # Parameter modulation
        gamma_inner = self.alpha_v * v_t + torch.matmul(p_t, self.D[0])
        gamma_t = torch.sigmoid(gamma_inner)
        
        beta_inner = self.kappa_a * a_t + torch.matmul(p_t, self.D[1])
        beta_t = torch.exp(beta_inner)
        
        return p_t, v_t, a_t, gamma_t, beta_t

# =============================================================================
# Complete Biological Value Agent
# =============================================================================

class BiologicalValueAgent(nn.Module):
    """
    Complete agent implementing the Biological Value Function architecture.
    """
    def __init__(self, state_dim: int, action_dim: int, e_dim: int,
                 params: InteroceptiveParameters):
        super().__init__()
        self.state_dim = state_dim
        self.action_dim = action_dim
        self.e_dim = e_dim
        
        self.interoceptive = InteroceptiveAdjointLayer(state_dim, params)
        self.affective = PrimaryAffectiveSystem(e_dim)
        
        # Value network
        self.value_net = nn.Sequential(
            nn.Linear(state_dim + e_dim + 2, 128),
            nn.ReLU(),
            nn.Linear(128, 128),
            nn.ReLU(),
            nn.Linear(128, action_dim)
        )
        
        # Policy network
        self.policy_net = nn.Sequential(
            nn.Linear(state_dim + e_dim + 2, 128),
            nn.ReLU(),
            nn.Linear(128, 128),
            nn.ReLU(),
            nn.Linear(128, action_dim)
        )
    
    def forward(self, s_t: torch.Tensor, delta_t: torch.Tensor, 
                pi_tilde_t: torch.Tensor):
        """
        Full forward pass through the BVF architecture.
        """
        batch_size = s_t.size(0)
        
        # Interoceptive prediction error
        e_t = (self.interoceptive.pi_0 + pi_tilde_t) * delta_t
        
        # Affective modulation
        p_t, v_t, a_t, gamma_t, beta_t = self.affective(e_t)
        
        # Combined state for value and policy
        combined = torch.cat([s_t, e_t, v_t.unsqueeze(-1), a_t.unsqueeze(-1)], 
                             dim=-1)
        
        # Value and policy
        q_values = self.value_net(combined)
        logits = self.policy_net(combined)
        
        return {
            'q_values': q_values,
            'logits': logits,
            'gamma': gamma_t,
            'beta': beta_t,
            'valence': v_t,
            'arousal': a_t,
            'primary_affect': p_t
        }
