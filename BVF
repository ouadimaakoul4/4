```python
class LQRPrecisionController:
    """
    Local Linear-Quadratic Regulator for precision modulation.
    """
    def __init__(self, params: InteroceptiveParameters, state_dim: int):
        self.params = params
        self.state_dim = state_dim
        
        # Compute P_delta_delta
        denominator = params.rho + 2 * params.k_r * params.pi_0 - \
                      state_dim * params.sigma_delta**2
        self.P_delta_delta = 1.0 / denominator
        
        # Compute Q_PiPi (state-driven precision demand)
        self.Q_PiPi = (4 * params.kappa**2 * 
                       (params.pi_max - params.pi_0)**2 / params.eta**2) * \
                      self.P_delta_delta**2
        
        # Solve Riccati equation for P_PiPi
        b = params.rho + 2 * params.mu - params.sigma_pi**2
        c = 2 * self.Q_PiPi / params.gamma_2
        self.P_PiPi = params.gamma_2 * (np.sqrt(b**2 + c) - b)
        
        # LQR gain
        self.K_Pi = self.P_PiPi / params.gamma_2
    
    def control(self, pi_tilde: float) -> float:
        """
        Compute optimal control signal.
        """
        return -self.K_Pi * pi_tilde
    
    def get_gain(self) -> float:
        return self.K_Pi
