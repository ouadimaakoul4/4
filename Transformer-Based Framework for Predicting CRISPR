def prepare_batch(sequences: List[str], targets: Union[List[int], torch.Tensor],
                  cell_types: List[int], config: XRepairConfig) -> Dict:
    """
    Prepare a batch for training/evaluation.
    
    Args:
        sequences: List of DNA sequences
        targets: Indel labels or distributions
        cell_types: Cell type identifiers
        config: Model configuration
        
    Returns:
        Dict with batch tensors ready for model forward pass
    """
    batch = {
        'sequences': sequences,
        'cell_types': torch.tensor(cell_types) if isinstance(cell_types, list) else cell_types
    }
    
    # Process targets
    if isinstance(targets[0], int):  # Hard labels
        batch['targets'] = torch.tensor(targets)
    else:  # Soft distributions
        batch['targets'] = torch.stack([
            torch.tensor(t) if isinstance(t, list) else t 
            for t in targets
        ])
    
    return batch


def train_epoch(model: XRepair, loss_fn: XRepairLoss, optimizer: torch.optim.Optimizer,
                dataloader, config: XRepairConfig, device: torch.device,
                scheduler: Optional[torch.optim.lr_scheduler._LRScheduler] = None) -> Dict:
    """
    Train model for one epoch.
    
    Args:
        model: X-Repair model
        loss_fn: Composite loss function
        optimizer: PyTorch optimizer
        dataloader: Training data loader
        config: Configuration
        device: Training device
        scheduler: Optional LR scheduler
        
    Returns:
        Dict with training metrics
    """
    model.train()
    total_loss = 0
    metrics = {'ce': 0, 'smooth': 0, 'kl': 0, 'focal': 0}
    n_batches = 0
    
    for batch in dataloader:
        optimizer.zero_grad()
        
        # Forward pass
        logits = model(batch['sequences'], batch['cell_types'])
        
        # Compute loss with components
        loss_dict = loss_fn(logits, batch['targets'], return_components=True)
        loss = loss_dict['total']
        
        # Backward pass
        loss.backward()
        
        # Gradient clipping
        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
        
        optimizer.step()
        
        # Accumulate metrics
        total_loss += loss.item()
        for key in metrics:
            metrics[key] += loss_dict[key].item()
        n_batches += 1
        
        # Step scheduler if using per-batch updates
        if scheduler is not None and hasattr(scheduler, 'step_batch'):
            scheduler.step_batch()
    
    # Step epoch-based scheduler
    if scheduler is not None and not hasattr(scheduler, 'step_batch'):
        scheduler.step()
    
    # Average metrics
    return {
        'loss': total_loss / n_batches,
        **{k: v / n_batches for k, v in metrics.items()}
    }


def evaluate(model: XRepair, loss_fn: XRepairLoss, dataloader, 
             config: XRepairConfig, device: torch.device) -> Dict:
    """
    Evaluate model on validation/test set.
    
    Returns comprehensive metrics including EMD, JSD, Recall@K, ECE.
    """
    model.eval()
    
    all_preds = []
    all_targets = []
    total_loss = 0
    n_batches = 0
    
    with torch.no_grad():
        for batch in dataloader:
            logits = model(batch['sequences'], batch['cell_types'])
            probs = F.softmax(logits, dim=-1)
            
            # Compute loss
            loss = loss_fn(logits, batch['targets'])
            total_loss += loss.item()
            
            # Store predictions and targets
            all_preds.append(probs.cpu())
            
            # Convert hard labels to one-hot if needed
            if batch['targets'].dim() == 1:
                targets_oh = F.one_hot(batch['targets'], num_classes=config.n_indels).float()
                all_targets.append(targets_oh.cpu())
            else:
                all_targets.append(batch['targets'].cpu())
            
            n_batches += 1
    
    # Concatenate all batches
    all_preds = torch.cat(all_preds, dim=0)
    all_targets = torch.cat(all_targets, dim=0)
    
    # Compute metrics
    emd = earth_movers_distance(all_preds, all_targets).mean()
    jsd = jensen_shannon_divergence(all_preds, all_targets).mean()
    recall_1 = recall_at_k(all_preds, all_targets, k=1).mean()
    recall_3 = recall_at_k(all_preds, all_targets, k=3).mean()
    recall_5 = recall_at_k(all_preds, all_targets, k=5).mean()
    ece = expected_calibration_error(all_preds, all_targets)
    
    return {
        'loss': total_loss / n_batches,
        'emd': emd.item(),
        'jsd': jsd.item(),
        'recall_1': recall_1.item(),
        'recall_3': recall_3.item(),
        'recall_5': recall_5.item(),
        'ece': ece.item()
    }


