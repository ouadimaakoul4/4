#### B.5 SafetyCertificateManager

```python
import time
import hashlib
import json
from typing import List, Optional

# Cryptographic primitives (simplified; actual: HSM calls)
class Ed25519:
    @staticmethod
    def sign(message: bytes, private_key: bytes) -> bytes:
        # Delegated to HSM
        pass
    
    @staticmethod
    def verify(message: bytes, signature: bytes, public_key: bytes) -> bool:
        # Delegated to HSM
        pass

@dataclass(frozen=True)
class SafetyCertificate:
    prev_hash: bytes           # SHA-256 of previous certificate
    cert_id: str               # UUID
    timestamp: float           # Unix epoch seconds
    context_hash: bytes        # Merkle root of safety context
    proof_hash: bytes          # SHA-256 of proof tree
    signature: bytes           # Ed25519 signature
    
    def serialise_for_hashing(self) -> bytes:
        """Deterministic serialisation excluding signature."""
        data = {
            'prev_hash': self.prev_hash.hex(),
            'cert_id': self.cert_id,
            'timestamp': self.timestamp,
            'context_hash': self.context_hash.hex(),
            'proof_hash': self.proof_hash.hex()
        }
        return json.dumps(data, sort_keys=True).encode('utf-8')
    
    def compute_hash(self) -> bytes:
        return hashlib.sha256(self.serialise_for_hashing()).digest()

class SafetyCertificateManager:
    """Immutable certificate ledger with Merkle optimisation."""
    
    def __init__(self, hsm_private_key: bytes, storage_path: str):
        self.private_key = hsm_private_key
        self.ledger: List[SafetyCertificate] = []
        self.storage = storage_path
        self._load_ledger()
        
    def issue_certificate(self, prev_cert: Optional[SafetyCertificate],
                         context: object, proof: Dict) -> SafetyCertificate:
        """Create and append new certificate."""
        # Verify proof via sound checker
        if not self._verify_proof(proof, context):
            raise ValueError("Proof verification failed")
        
        # Compute hashes
        prev_hash = prev_cert.compute_hash() if prev_cert else bytes(32)
        context_hash = self._merkle_root(context)
        proof_hash = hashlib.sha256(json.dumps(proof).encode()).digest()
        
        # Construct unsigned certificate
        unsigned = SafetyCertificate(
            prev_hash=prev_hash,
            cert_id=str(uuid.uuid4()),
            timestamp=time.time(),
            context_hash=context_hash,
            proof_hash=proof_hash,
            signature=bytes(64)  # Placeholder
        )
        
        # Sign via HSM
        message = unsigned.serialise_for_hashing()
        signature = Ed25519.sign(message, self.private_key)
        
        # Finalise
        cert = SafetyCertificate(
            prev_hash=prev_hash,
            cert_id=unsigned.cert_id,
            timestamp=unsigned.timestamp,
            context_hash=context_hash,
            proof_hash=proof_hash,
            signature=signature
        )
        
        # Append atomically
        self._atomic_append(cert)
        return cert
    
    def verify_chain(self, chain: List[SafetyCertificate], 
                     public_key: bytes) -> bool:
        """Verify entire chain integrity."""
        if not chain:
            return False
        
        # Check genesis
        genesis = chain[0]
        if genesis.prev_hash != bytes(32):
            return False
        
        for i in range(len(chain)):
            cert = chain[i]
            # Verify signature
            msg = cert.serialise_for_hashing()
            if not Ed25519.verify(msg, cert.signature, public_key):
                return False
            
            # Verify linkage
            if i > 0:
                expected_prev = chain[i-1].compute_hash()
                if cert.prev_hash != expected_prev:
                    return False
        
        return True
    
    def _merkle_root(self, context: object) -> bytes:
        """Compute Merkle root for large contexts."""
        # Flatten context into leaves
        leaves = self._context_leaves(context)
        if not leaves:
            return bytes(32)
        
        # Build tree bottom-up
        current = [hashlib.sha256(l).digest() for l in leaves]
        while len(current) > 1:
            next_level = []
            for i in range(0, len(current), 2):
                left = current[i]
                right = current[i+1] if i+1 < len(current) else left
                combined = hashlib.sha256(left + right).digest()
                next_level.append(combined)
            current = next_level
        
        return current[0]
    
    def _context_leaves(self, context: object) -> List[bytes]:
        """Decompose context into hashable leaves."""
        # Implementation: flatten policy, constraints, world model
        pass
    
    def _verify_proof(self, proof: Dict, context: object) -> bool:
        """Delegate to sound proof checker."""
        # Implementation: recursive verification of proof tree
        pass
    
    def _atomic_append(self, cert: SafetyCertificate) -> None:
        """Durable, crash-safe append."""
        # Implementation: write-ahead logging, fsync
        self.ledger.append(cert)
        self._persist()
    
    def _load_ledger(self) -> None:
        """Recover from storage."""
        pass
    
    def _persist(self) -> None:
        """Flush to non-volatile storage."""
        pass
