#### B.2 SymmetryCompressionModule

```python
from typing import Tuple
import hashlib
import math

@dataclass(frozen=True)
class CanonicalState:
    """State after symmetry reduction."""
    x: float           # [0, 1.0) metres
    y: float           # [0, 1.0) metres  
    theta: float       # {0, π/2, π, 3π/2}
    y_sign: int        # +1 or -1 (original reflection)
    joints: Tuple[float, ...]
    other: Tuple[float, ...]

class SymmetryCompressionModule:
    """Reduces state space via group-theoretic canonical mapping."""
    
    TILE_SIZE: float = 1.0        # metres
    THETA_STEP: float = math.pi / 2.0  # 90 degrees
    HASH_BITS: int = 4            # 4-bit equivalence class
    
    def __init__(self, enable_reflection: bool = True):
        self.enable_reflection = enable_reflection
        
    def canonical_form(self, s: State) -> CanonicalState:
        """Apply sequential symmetry reductions (Theorem 2.2)."""
        # Extract components (assuming standard ordering)
        x, y, z = s.data[0], s.data[1], s.data[2]
        theta = s.data[3]
        joints = s.data[4:]  # Remaining are joints + other
        
        # Step 1: Translational reduction
        x_can = x % self.TILE_SIZE
        y_can = y % self.TILE_SIZE
        
        # Step 2: Rotational reduction
        k = round(theta / self.THETA_STEP) % 4
        theta_can = k * self.THETA_STEP
        
        # Step 3: Reflective reduction
        y_sign = 1
        if self.enable_reflection and y_can < 0:
            y_can = abs(y_can)
            theta_can = -theta_can % (2 * math.pi)
            y_sign = -1
            # Note: joint mirroring would be applied here for symmetric robots
        
        return CanonicalState(
            x=x_can, y=y_can, theta=theta_can,
            y_sign=y_sign, joints=joints, other=()
        )
    
    def equivalence_hash(self, s: State) -> int:
        """4-bit hash of canonical state (Definition 2.7)."""
        can = self.canonical_form(s)
        
        # Serialise with fixed precision
        serialised = self._serialise(can)
        
        # SHA-256, take lowest 4 bits
        hash_bytes = hashlib.sha256(serialised.encode()).digest()
        return hash_bytes[0] & 0x0F  # 0-15
    
    def _serialise(self, can: CanonicalState) -> str:
        """Deterministic string representation."""
        parts = [
            f"{can.x:.2f}",
            f"{can.y:.2f}",
            f"{can.theta:.4f}",
            f"{can.y_sign}"
        ]
        for j in can.joints:
            parts.append(f"{j:.2f}")
        return "|".join(parts)
    
    def table_key(self, s: State, instance_id: int) -> int:
        """Combine equivalence hash with instance ID."""
        h = self.equivalence_hash(s)
        # 8-bit key: 4 bits hash + 4 bits instance
        return (h << 4) | (instance_id & 0x0F)  # 0-255
```

