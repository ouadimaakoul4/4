#### B.3 DeltaLTLVerifier

```python
from enum import Enum, auto
from typing import Set, Dict, List, Optional, Callable

class FormulaType(Enum):
    SAFETY = auto()      # G ψ
    LIVENESS = auto()    # F ψ
    UNKNOWN = auto()     # Complex LTL

@dataclass
class Formula:
    id: int
    formula_type: FormulaType
    psi: Callable[[State], bool]      # Propositional check
    progress_measure: Optional[Callable[[State], float]] = None
    footprint: Set[str] = None         # Variables mentioned

@dataclass
class CachedResult:
    result: bool
    timestamp: float
    dependency_signature: Tuple[float, ...]

class DeltaLTLVerifier:
    """Incremental LTL verifier (Algorithm 2.1)."""
    
    def __init__(self, full_verifier: Optional[Callable] = None):
        self.dependency_map: Dict[str, Set[int]] = {}  # var -> formula IDs
        self.cache: Dict[int, CachedResult] = {}
        self.full_verifier = full_verifier or self._default_full_verifier
        
    def build_dependency_graph(self, formulas: List[Formula]) -> None:
        """One-time offline construction (Definition 2.8)."""
        self.dependency_map.clear()
        for phi in formulas:
            for var in phi.footprint:
                if var not in self.dependency_map:
                    self.dependency_map[var] = set()
                self.dependency_map[var].add(phi.id)
    
    def verify(self, s: State, delta: Dict[str, float], 
               formulas: List[Formula]) -> Tuple[bool, Optional[Dict]]:
        """
        Incremental verification with proof generation.
        Returns: (safe, proof_tree or None)
        """
        changed_vars = set(delta.keys())
        
        # Step 1: Partition
        phi_aff_ids: Set[int] = set()
        for var in changed_vars:
            phi_aff_ids.update(self.dependency_map.get(var, set()))
        
        phi_unc = [f for f in formulas if f.id not in phi_aff_ids]
        phi_aff = [f for f in formulas if f.id in phi_aff_ids]
        
        proof_steps = []
        
        # Step 2: Verify unaffected (cache check)
        for phi in phi_unc:
            cached = self.cache.get(phi.id)
            if cached is None or not cached.result:
                # Cache miss or previously failed
                return False, None
            proof_steps.append({
                'type': 'cache_hit',
                'formula_id': phi.id,
                'reason': 'unaffected_by_delta'
            })
        
        # Step 3: Verify affected
        s_new = self._apply_delta(s, delta)
        
        for phi in phi_aff:
            if phi.formula_type == FormulaType.SAFETY:
                if not phi.psi(s_new):
                    return False, None
                proof_steps.append({
                    'type': 'safety_check',
                    'formula_id': phi.id,
                    'state': s_new,
                    'result': True
                })
                
            elif phi.formula_type == FormulaType.LIVENESS:
                if phi.psi(s_new):
                    proof_steps.append({
                        'type': 'liveness_satisfied',
                        'formula_id': phi.id
                    })
                elif phi.progress_measure is not None:
                    mu_old = phi.progress_measure(s)
                    mu_new = phi.progress_measure(s_new)
                    if mu_new >= mu_old:
                        return False, None
                    proof_steps.append({
                        'type': 'progress_decrease',
                        'formula_id': phi.id,
                        'mu_old': mu_old,
                        'mu_new': mu_new
                    })
                else:
                    # No progress measure, fall through to unknown
                    if not self.full_verifier(phi, s_new):
                        return False, None
                    proof_steps.append({
                        'type': 'full_verification',
                        'formula_id': phi.id
                    })
                    
            else:  # UNKNOWN
                if not self.full_verifier(phi, s_new):
                    return False, None
                proof_steps.append({
                    'type': 'full_verification',
                    'formula_id': phi.id
                })
        
        return True, {'steps': proof_steps, 'timestamp': time.time()}
    
    def _apply_delta(self, s: State, delta: Dict[str, float]) -> State:
        """Apply partial state update."""
        new_data = list(s.data)
        # Assuming variable ordering known; in practice use named mapping
        for var, value in delta.items():
            idx = self._var_index(var)
            if idx is not None:
                new_data[idx] = value
        return State(tuple(new_data))
    
    def _var_index(self, var: str) -> Optional[int]:
        """Map variable name to state vector index."""
        # Implementation depends on state schema
        mapping = {
            'x': 0, 'y': 1, 'z': 2, 'theta': 3,
            # ... joint indices ...
        }
        return mapping.get(var)
    
    def _default_full_verifier(self, phi: Formula, s: State) -> bool:
        """Fallback to external model checker."""
        raise NotImplementedError("Full LTL verifier not configured")
```

