#### B.1 NoveltyDetectionEngine

```python
from typing import List, Tuple, Callable, Optional
from dataclasses import dataclass
import math

@dataclass(frozen=True)
class State:
    """Robot state vector in R^p."""
    data: Tuple[float, ...]
    
    def __post_init__(self):
        assert len(self.data) > 0, "Empty state"

@dataclass(frozen=True)
class NoveltyResult:
    """Output of novelty assessment."""
    nu_tilde: float      # Calibrated novelty ∈ [0,1]
    confidence: float    # Detector agreement ∈ [0,1]
    kappa: float         # Conservatism multiplier ∈ [1,10]

class Detector:
    """Abstract base for OOD detectors."""
    def assess(self, s: State) -> float:
        """Return novelty score ∈ [0,1]."""
        raise NotImplementedError

class IsolationForestDetector(Detector):
    def __init__(self, n_trees: int = 100, sample_size: int = 256):
        self.n_trees = n_trees
        self.sample_size = sample_size
        self.trees: List[IsolationTree] = []
        
    def assess(self, s: State) -> float:
        if not self.trees:
            return 0.5  # Uncertain if untrained
        path_lengths = [t.path_length(s) for t in self.trees]
        avg_path = sum(path_lengths) / len(path_lengths)
        # Normalised to [0,1]: higher = more anomalous
        return 1.0 - (avg_path / self._max_path_length())
    
    def _max_path_length(self) -> float:
        return 2.0 * math.log2(self.sample_size)

class AutoencoderDetector(Detector):
    def __init__(self, encoder: NeuralNet, decoder: NeuralNet):
        self.encoder = encoder
        self.decoder = decoder
        self.mu_e: Optional[float] = None
        self.sigma_e: Optional[float] = None
        
    def assess(self, s: State) -> float:
        if self.mu_e is None:
            return 0.5  # Uncertain if uncalibrated
        encoded = self.encoder.forward(s.data)
        reconstructed = self.decoder.forward(encoded)
        error = math.sqrt(sum((a - b)**2 for a, b in zip(s.data, reconstructed)))
        # Sigmoid normalisation
        z_score = (error - self.mu_e) / max(self.sigma_e, 1e-6)
        return 1.0 / (1.0 + math.exp(-z_score))

class MahalanobisDetector(Detector):
    def __init__(self):
        self.mu: Optional[Tuple[float, ...]] = None
        self.inv_sigma: Optional[List[List[float]]] = None
        
    def assess(self, s: State) -> float:
        if self.mu is None:
            return 0.5
        diff = tuple(a - b for a, b in zip(s.data, self.mu))
        d2 = self._quadratic_form(diff, self.inv_sigma)
        # Chi-squared CDF approximation
        p_value = self._chi2_cdf(d2, df=len(s.data))
        return 1.0 - p_value  # Higher = more anomalous
    
    def _quadratic_form(self, x: Tuple[float, ...], A: List[List[float]]) -> float:
        n = len(x)
        result = 0.0
        for i in range(n):
            for j in range(n):
                result += x[i] * A[i][j] * x[j]
        return result

class LikelihoodRatioDetector(Detector):
    def __init__(self, bandwidth: float = 0.1):
        self.bandwidth = bandwidth
        self.train_samples: List[State] = []
        self.ref_density: Optional[Callable] = None
        
    def assess(self, s: State) -> float:
        if not self.train_samples or self.ref_density is None:
            return 0.5
        p_train = self._kde(s, self.train_samples, self.bandwidth)
        p_ref = self.ref_density(s)
        if p_ref <= 0:
            return 1.0
        llr = math.log(p_train / p_ref)
        return 1.0 / (1.0 + math.exp(-llr))  # Sigmoid

class NoveltyDetectionEngine:
    """Fuses multiple detectors via Dempster-Shafer theory."""
    
    def __init__(self, detectors: List[Detector], buffer_size: int = 10000):
        self.detectors = detectors
        self.normal_buffer: List[State] = []
        self.buffer_size = buffer_size
        self._validation_scores: List[float] = []
        
    def assess_novelty(self, s: State) -> NoveltyResult:
        """Compute calibrated novelty and conservatism multiplier."""
        if len(self.detectors) == 0:
            return NoveltyResult(nu_tilde=0.0, confidence=0.0, kappa=1.0)
        
        # Step 1: Individual detector scores
        scores = [d.assess(s) for d in self.detectors]
        
        # Step 2: Dempster-Shafer fusion (Lemma 2.1)
        nu = self._dempster_shafer_fuse(scores)
        
        # Step 3: Confidence via detector agreement (Definition 2.3)
        delta = max(scores) - min(scores)
        confidence = max(0.0, min(1.0, 1.0 - delta))
        
        # Step 4: Calibration
        nu_tilde = nu * confidence
        
        # Step 5: Conservatism multiplier (Definition 2.4)
        kappa = 10.0 ** nu_tilde
        
        return NoveltyResult(nu_tilde=nu_tilde, confidence=confidence, kappa=kappa)
    
    def _dempster_shafer_fuse(self, scores: List[float]) -> float:
        """Product-form fusion from Lemma 2.1."""
        n = len(scores)
        if n == 1:
            return scores[0]
        
        # Clip to avoid numerical issues
        scores = [max(1e-10, min(1.0 - 1e-10, s)) for s in scores]
        
        prod_nu = 1.0
        prod_one_minus = 1.0
        for s in scores:
            prod_nu *= s
            prod_one_minus *= (1.0 - s)
        
        denominator = prod_nu + prod_one_minus
        if denominator < 1e-15:
            return 0.5  # Maximum conflict, return neutral
        
        return prod_nu / denominator
    
    def update_normal_buffer(self, s: State, nu_tilde: float) -> None:
        """Add state to training buffer if sufficiently normal."""
        threshold = 0.1  # Novelty below this is considered normal
        if nu_tilde < threshold:
            self.normal_buffer.append(s)
            if len(self.normal_buffer) > self.buffer_size:
                self.normal_buffer.pop(0)
            
            # Periodic retraining
            if len(self.normal_buffer) % 1000 == 0:
                self._retrain_detectors()
    
    def _retrain_detectors(self) -> None:
        """Retrain all detectors on current buffer."""
        for d in self.detectors:
            if hasattr(d, 'train'):
                d.train(self.normal_buffer)
```

