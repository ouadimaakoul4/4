Appendix D: Algorithm Pseudocode

D.1 RSIC‑0 Main Loop

```
Algorithm RSIC‑0(s₀, ε, {ρ_t}, C, D_val, k_proj, η)
1:  s ← s₀; t ← 0
2:  G ← InitMemoryGraph()
3:  W ← InitWorldModel()
4:  critics ← {Critic_task, Critic_consistency, Critic_alignment}  // frozen independent copies
5:  C_cache ← ∅
6:  ℛ ← initial_normative_rules()
7:  while t < T do
8:      e_t ∼ environment()
9:      G ← UpdateMemoryGraph(G, e_t)
10:     (bottlenecks, H, confidence) ← Reflect(Trace(s), metrics_t)
11:     M_t ← GenerateModifications(bottlenecks, H, s, ρ_t)
12:     validated ← ∅
13:     for each δ in M_t do
14:         s′ ← Apply(s, δ)
15:         if C_cache.contains(s, s′) then
16:             verdict ← C_cache.lookup(s, s′)
17:         else
18:             verdict ← V_robust(s, s′)
19:             C_cache.insert(s, s′, verdict)
20:         end if
21:         if verdict ≥ ε then
22:             validated ← validated ∪ {s′}
23:         end if
24:     end for
25:     if validated ≠ ∅ then
26:         candidate ← argmax_{s′∈validated} [U(s′) − λ·Cost(s′)]
27:         if t mod k_proj = 0 then
28:             U0_val ← EvaluateU0(candidate, D_val)
29:             if U0_val ≥ U0(s₀) − η then
30:                 s ← candidate
31:             else
32:                 ℛ ← ℛ ∪ ExtractInstrumentalPatterns(candidate)
33:                 C_cache.insertNegative(s, candidate)
34:             end if
35:         else
36:             s ← candidate
37:         end if
38:     end if
39:     (W, s.P) ← TrainWorldModel(s, G, metrics_t)
40:     G ← CompressMemory(G, threshold)
41:     ρ_{t+1} ← step_schedule(t)   // e.g., ρ_t = ρ₀ / (t+1)^γ
42:     t ← t + 1
43: end while
44: return s
```

D.2 Reflect Module (SAE-Based)

```
Function Reflect(trace, metrics):
1:  SAE ← load_frozen_SAE()
2:  features ← SAE.encode(trace.activations)
3:  loss_grad ← ∇_{features} L_task
4:  sensitivities ← |loss_grad|
5:  bottlenecks ← TopK(sensitivities, k=3)
6:  H ← ∅
7:  for each b in bottlenecks do
8:      for mod_type in {prune, expand, retrain, restructure} do
9:          h ← OptimizeModification(b, mod_type, metrics,
10:                 constraints: ‖h‖ ≤ ρ_t, AlignmentScore(h) ≥ θ)
11:         if h ≠ ∅ then H ← H ∪ {h}
12:     end for
13: end for
14: H ← SortByPredictedImpact(H, metrics)
15: confidence ← {h: median(ensemble_predictors(h)) for h in H}
16: return (bottlenecks, H, confidence)
```

D.3 V_robust Implementation Sketch

```
Function V_robust(s, s′):
1:  v_task ← inf_{Q ∈ P_adv(s)} Probability_{e∼Q}(U(s′,e) > U(s,e))
2:  v_consistency ← 1 − MMD(BehaviorSample(s), BehaviorSample(s′))
3:  v_alignment ← (ϕ(s′) satisfies all rules in ℛ) ? 1 : 0
4:  return min(v_task, v_consistency, v_alignment)
```

