src/crystalcore/models.py – Data models

```python
from __future__ import annotations
from dataclasses import dataclass, field
from typing import List, Optional
import datetime

@dataclass
class Node:
    name: str

@dataclass
class Contact:
    from_node: str
    to_node: str
    start: float         # Unix timestamp (seconds) or ISO datetime
    end: float
    capacity_bps: float  # bit/s, constant over the window
    delay_s: float       # one-way light-time, constant

    @property
    def volume_bits(self) -> float:
        """Total contact volume in bits."""
        return self.capacity_bps * (self.end - self.start)

@dataclass
class Bundle:
    id: str
    size_bits: float
    src: str
    dst: str
    create_time: float
    lifetime_s: float

    @property
    def expire_time(self) -> float:
        return self.create_time + self.lifetime_s

@dataclass
class Hop:
    contact: Contact
    departure_time: float
    finish_time: float      # time when transmission completes
    arrival_time: float     # finish_time + delay

@dataclass
class Path:
    hops: List[Hop]
    final_arrival: float

    @property
    def delivery_time(self) -> float:
        return self.final_arrival
```

src/crystalcore/discretize.py – Time discretisation

```python
from typing import List, Set
from .models import Contact, Bundle

def event_times(contacts: List[Contact], bundle: Bundle) -> List[float]:
    """Extracts and sorts all significant time instants."""
    times = set()
    times.add(bundle.create_time)
    for c in contacts:
        times.add(c.start)
        times.add(c.end)
    # Could also add bundle.expire_time if needed
    return sorted(times)
```

src/crystalcore/physics.py – Volume and transfer time calculation

```python
def earliest_finish(contact_start: float, contact_end: float,
                    capacity_bps: float, required_bits: float,
                    earliest_departure: float) -> float | None:
    """
    Returns the earliest possible transmission finish time
    for a constant‑rate contact, or None if the volume is insufficient.
    """
    start = max(earliest_departure, contact_start)
    if start >= contact_end:
        return None
    available_time = contact_end - start
    max_volume = capacity_bps * available_time
    if max_volume < required_bits:
        return None
    xfer_time = required_bits / capacity_bps
    return start + xfer_time
```

src/crystalcore/teg.py – Lazy time‑expanded graph and Dijkstra

```python
import heapq
from typing import Dict, List, Tuple, Optional
from .models import Contact, Bundle, Path, Hop
from .physics import earliest_finish

def dijkstra_earliest_delivery(contacts: List[Contact],
                               bundle: Bundle,
                               event_times: List[float]) -> Optional[Path]:
    """
    Dijkstra shortest‑path search on the lazy TEG.
    Explores states (node, time) on demand.
    """
    best = {}   # (node, time) -> earliest known arrival
    heap = []   # (arrival_time, node, current_time, path_hops)
    src = bundle.src
    start_state = (src, bundle.create_time)
    best[start_state] = bundle.create_time
    heapq.heappush(heap, (bundle.create_time, src, bundle.create_time, []))

    while heap:
        arr_time, node, cur_time, hops = heapq.heappop(heap)

        if node == bundle.dst:
            if arr_time <= bundle.expire_time:
                return Path(hops=hops, final_arrival=arr_time)
            continue

        # 1) Waiting: stay at the same node until the next event time
        next_times = [t for t in event_times if t > cur_time]
        if next_times:
            next_t = next_times[0]
            wait_state = (node, next_t)
            new_arr = arr_time + (next_t - cur_time)
            if wait_state not in best or new_arr < best[wait_state]:
                best[wait_state] = new_arr
                heapq.heappush(heap, (new_arr, node, next_t, hops))

        # 2) Transmission: evaluate all contacts that depart from 'node'
        for contact in contacts:
            if contact.from_node != node:
                continue
            if max(cur_time, contact.start) >= contact.end:
                continue
            finish = earliest_finish(
                contact.start, contact.end,
                contact.capacity_bps, bundle.size_bits,
                cur_time
            )
            if finish is None:
                continue
            arrival = finish + contact.delay_s
            if arrival > bundle.expire_time:
                continue
            new_state = (contact.to_node, arrival)
            new_arr = arrival
            if new_state not in best or new_arr < best[new_state]:
                best[new_state] = new_arr
                new_hops = hops + [Hop(contact=contact,
                                       departure_time=cur_time,
                                       finish_time=finish,
                                       arrival_time=arrival)]
                heapq.heappush(heap, (new_arr, contact.to_node, arrival, new_hops))

    return None  # no feasible path
```

src/crystalcore/router.py – High‑level routing API

```python
from .models import Contact, Bundle, Path
from .discretize import event_times
from .teg import dijkstra_earliest_delivery

def route_bundle(contacts: List[Contact], bundle: Bundle) -> Path | None:
    events = event_times(contacts, bundle)
    return dijkstra_earliest_delivery(contacts, bundle, events)
```

src/crystalcore/cli.py – Command‑line interface

```python
import argparse
import json
from .models import Contact, Bundle
from .router import route_bundle

def main():
    parser = argparse.ArgumentParser(description='CrystalCore.OS DTN Router')
    parser.add_argument('plan', help='JSON contact plan file')
    parser.add_argument('bundle', help='JSON bundle file')
    args = parser.parse_args()

    with open(args.plan) as f:
        plan_data = json.load(f)
    contacts = [Contact(**c) for c in plan_data['contacts']]

    with open(args.bundle) as f:
        bundle_data = json.load(f)
    bundle = Bundle(**bundle_data)

    path = route_bundle(contacts, bundle)
    if path:
        print(f"Earliest delivery: {path.delivery_time}")
        for i, hop in enumerate(path.hops):
            print(f"Hop {i+1}: {hop.contact.from_node} -> {hop.contact.to_node}")
            print(f"  Depart: {hop.departure_time}, Finish: {hop.finish_time}, Arrive: {hop.arrival_time}")
    else:
        print("No feasible path within lifetime.")
```

