```python
def bootstrap_network_metrics(G, n_bootstraps=1000):
    """Calculate bootstrap confidence intervals for network metrics"""
    
    original_metrics = calculate_all_metrics(G)
    n_nodes = G.number_of_nodes()
    
    bootstrapped_metrics = []
    
    for i in range(n_bootstraps):
        # Resample nodes with replacement
        sampled_nodes = np.random.choice(
            list(G.nodes()), size=n_nodes, replace=True
        )
        
        # Create induced subgraph
        sampled_G = G.subgraph(sampled_nodes)
        
        # Calculate metrics
        metrics = calculate_all_metrics(sampled_G)
        bootstrapped_metrics.append(metrics)
    
    # Calculate confidence intervals
    ci = {}
    for metric_name in original_metrics.keys():
        values = [bm[metric_name] for bm in bootstrapped_metrics]
        ci[metric_name] = {
            'mean': np.mean(values),
            'std': np.std(values),
            'ci_95': np.percentile(values, [2.5, 97.5])
        }
    
    return original_metrics, ci
```

