14:     // SELECTION & EXPANSION with Progressive Widening
15:     while not is_terminal(node.state) do
16:         valid_actions = A_valid(node.state)  // topological candidates + NO_OP
17:         max_allowed = floor(c_pw * node.visits^α_pw)
18:         
19:         // Progressive widening: expand new action if possible
20:         if |node.tree_actions| < max_allowed and
21:            |node.tree_actions| < |valid_actions| then
22:             unexpanded = valid_actions \ node.tree_actions
23:             Compute priors for unexpanded using hybrid score (if not already)
24:             Sample action a from unexpanded according to softmax(priors/τ)
25:             // Initialize new action statistics
26:             node.tree_actions.add(a)
27:             node.N_a[a] = 0
28:             node.Q_R[a] = 0.0
29:             node.Q_C[a] = zeros(K)   // K constraints
30:             node.P[a] = priors[a]
31:             // Advance simulator state using transition model
32:             next_state = transition(node.state, a)
33:             child = new Node(state=next_state, parent=node)
34:             node.children[a] = child
35:             node = child
36:             actions_taken.append(a)
37:             path.append(node)
38:             break  // exit while, go to rollout
39:         else
40:             // Select best existing action using Constrained PUCT
41:             best_action = NULL
42:             best_score = -inf
43:             for a in node.tree_actions do
44:                 q_r = node.Q_R[a]
45:                 q_c = dot(λ, node.Q_C[a])
46:                 exploration = c_puct * node.P[a] *
47:                               sqrt(node.visits) / (1 + node.N_a[a])
48:                 score = (q_r - q_c) + exploration
49:                 if score > best_score then
50:                     best_score = score
51:                     best_action = a
52:                 end if
53:             end for
54:             actions_taken.append(best_action)
55:             node = node.children[best_action]
56:             path.append(node)
57:         end if
58:     end while
59:     
60:     // EVALUATION (Default policy rollout)
61:     R_value, C_values = rollout(node.state, default_policy)
62:     
63:     // BACKPROPAGATION
64:     for i = len(path)-1 down to 1 do
65:         child_node = path[i]
66:         parent_node = path[i-1]
67:         action = actions_taken[i-1]
68:         parent_node.visits += 1
69:         parent_node.N_a[action] += 1
70:         n_a = parent_node.N_a[action]
71:         // Incremental mean updates
72:         parent_node.Q_R[action] += (R_value - parent_node.Q_R[action]) / n_a
73:         for k = 1..K do
74:             parent_node.Q_C[action][k] += (C_values[k] - parent_node.Q_C[action][k]) / n_a
75:         end for
76:     end for
77:     root.visits += 1
78: end for
79:
80: // RECOMMENDATION: choose most visited action (robust against noise)
81: return argmax_{a in root.tree_actions} root.N_a[a]
```

B.2 Lagrangian Policy Iteration Pseudocode

```
Algorithm: Lagrangian-Policy-Iteration(M, λ_init, γ, η_λ, max_iters)
1:  Initialize policy π_0 arbitrarily (e.g., TOC heuristic)
2:  Initialize Lagrange multipliers λ = λ_init
3:  for iter = 1 to max_iters do
4:      // Policy evaluation: estimate Q-values under π_iter
5:      Q_π = evaluate_policy(π_iter, M)   // via Monte Carlo rollouts
6:      // Policy improvement: greedy w.r.t. penalized Q
7:      for each state s (sampled from recent trajectories) do
8:          π_{iter+1}(s) = argmax_a [ Q_π(s,a) - Σ_k λ_k C_k(s,a) ]
9:      end for
10:     // Update Lagrange multipliers based on constraint violations
11:     for each constraint k do
12:         J_Ck = estimate_constraint_return(π_{iter+1})  // expected discounted sum
13:         λ_k = max(0, λ_k + η_λ * (J_Ck - c_k))
14:     end for
15:     // Check convergence
16:     if max_s |π_{iter+1}(s) - π_iter(s)| < ε then
17:         return π_{iter+1}
18:     end if
19:     π_iter = π_{iter+1}
20: end for
21: return π_{iter+1}
```

B.3 Feasibility Check Pseudocode

```
Algorithm: Feasibility-Check(s_t, a_t)
Input: current state s_t, candidate action a_t = (v_target, m_import, r_alloc)
Output: Boolean feasible, and possibly modified action (fallback if infeasible)

1:  // Mass constraint
2:  if ||m_import||_1 > M_max - E_t then
3:      return False, NO_OP
4:  end if
5:  // Energy constraint
6:  E_req = required_energy(a_t, s_t)
