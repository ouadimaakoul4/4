  q̂_t ← q_phys + r_θ
  CI_t ← posterior_credible_interval(q̂_t, Σ_t)
  q_wall_t, σ_q_t ← neumann_heat_flux_infer(q̂_t, T_meas_t, λ_T)

  if flag_envelope_exceeded:
    CI_t ← widen_interval(CI_t, factor=1.5)

  ─── MODALITY HEALTH CHECK ───
  for m = 1 to M:
    if sensor_health_check(s_m(t)) == DEGRADED:
      x̂_m ← impute_modality(m, {x_k: k≠m}, Θ_impute)
      c_m ← imputation_confidence(x̂_m)
      censor_flags[m] ← classify_censoring(s_m(t))
    else:
      x̂_m ← s_m(t)
      c_m ← 1.0
      censor_flags[m] ← NONE

  ─── LAYER 2: Anomaly Scoring with CenEVT ───
  h_m ← TDEN(x̂_m) for each m
  h_fused ← GNN(h_1,...,h_M, c_1,...,c_M, Θ_GNN)
  z, μ_z, σ_z ← DVAE_encode(h_fused, Θ_AD)
  x̂_rec ← DVAE_decode(z, Θ_AD)
  r_t ← reconstruction_error(h_fused, x̂_rec)
  p_exceedance ← CenEVT_survival(r_t, ξ, σ, u, ζ_u)

  if censor_flags indicates any modality censored:
    r_t ← treat_as_censored(r_t, censor_flags)

  ─── ALERT STATE TRANSITION ───
  alert_state ← DFA_transition(alert_state, r_t,
                  τ_D, τ_PI, τ_C^cons, T_clear)

  ─── LAYER 3: FAILURE-DIVERSE N-VERSION ARBITRATION ───
  if alert_state ≥ Pre-Instability:
    a_1, c_1, u_1 ← V1_physics_deterministic(q̂_t, CI_t, q_wall_t)
    a_2a, s_2a ← V2a_dvae(h_fused, Θ_AD)
    a_2b, s_2b ← V2b_tcn_ae(h_fused, Θ_2b)
    a_2c, s_2c ← V2c_ocnn(h_fused, Θ_2c)
    a_2, c_2, u_2 ← V2_ensemble_aggregate(s_2a, s_2b, s_2c)
    a_3, c_3, u_3 ← V3_expert_system(y_t, hardware_interlocks)
    a*, S_max, margin ← voting_2oo3(
        a_1,c_1,u_1, a_2,c_2,u_2, a_3,c_3,u_3)
  else:
    a* ← NoAction; margin ← 0

  ─── LAYER 4: RUNTIME-GOVERNED HUMAN-AI TEAMING ───
  L_cog ← cognitive_load_estimator(f_cog(t))
  autonomy_level ← determine_autonomy(alert_state, L_cog)
  g_conf ← calibrate_confidence(S_max, margin, c_1, c_2, c_3)
  rev_a ← reversibility_class(a*)
  risk_a ← risk_class_lookup(a*, alert_state)
  xai_report ← generate_XAI(a*, SHAP_values(h_fused),
                  physical_attribution(a_1), q_wall_t, σ_q_t)

  ─── RUNTIME GOVERNANCE DECISION ───
  gov_decision, reason ← GOVERN(a*, t, alert_state,
                          watchdog_triggered, g_conf, rev_a, risk_a)

  gov_record ← build_governance_record(
      t, a*, rev_a, risk_a, g_conf, alert_state,
      watchdog_triggered, gov_decision, reason)

  case gov_decision of
    PERMIT:
      execute_action(a*)
      notify_operator(a*, xai_report, OVERRIDE_WINDOW)
    ROUTE_TO_HUMAN:
      present_for_review(a*, xai_report, T_review(rev_a, risk_a))
      human_decision, latency, bio ← await_human(T_review)
      gov_record.human_decision ← human_decision
      gov_record.human_decision_latency_ms ← latency
      gov_record.biometric_verification ← bio
      if human_decision == PERMIT:
        execute_action(a*)
        gov_record.action_executed ← True
      else:
        gov_record.action_executed ← False
    DENY:
      log_denial(a*, reason)
      present_advisory(a*, xai_report)
    BYPASS:
      log_watchdog_preemption(t)
  end case

  ─── AUDIT LOG (hash-chained) ───
  log_entry ← {
    timestamp: t,
    sensor_state: y_t,
    dt_output: (q̂_t, CI_t, q_wall_t, σ_q_t, flag_envelope_exceeded),
    anomaly_score: (r_t, p_exceedance, censor_flags),
    alert_state: alert_state,
    evt_params: (ξ, σ, u, ζ_u, τ_D, τ_PI, τ_C^cons),
    version_outputs: (a_1,c_1,u_1), (a_2,c_2,u_2), (a_3,c_3,u_3),
    ensemble_dispersion: disp_2,
    arbitration_result: (a*, S_max, margin),
    cognitive_load: L_cog,
    autonomy_level: autonomy_level,
    governance_record: gov_record,
    xai_attribution: xai_report,
    prev_hash: previous_log_hash
  }
  log_entry.record_hash ← SHA256(log_entry)
  append_cryptographic_log(log_entry, HMAC_key)
  previous_log_hash ← log_entry.record_hash

─── DETERMINISTIC WATCHDOG (independent FPGA, asynchronous) ───
WATCHDOG LOOP (runs at f_watch = 10 kHz, hardwired analog front-end):
  if dP_dt(t) > dP_dt_limit:
    set_watchdog_triggered()
    IMMEDIATE_PROPELLANT_VALVE_CLOSE()
  if T_wall(t) > T_wall_limit:
    set_watchdog_triggered()
    IMMEDIATE_PROPELLANT_VALVE_CLOSE()
  if N_turbopump(t) > N_burst_limit:
    set_watchdog_triggered()
    IMMEDIATE_PROPELLANT_VALVE_CLOSE()
  log_watchdog_event(t, trigger_cause, raw_analog_value)
