### B.5 Runtime Governance Decision Procedure

```
Algorithm 5: Per-Action Runtime Governance
Input:  Proposed action a, timestamp t, alert_state, watchdog_triggered
        Calibrated confidence g_conf
Output: Oversight decision, reason code, immutable governance record

REVERSIBILITY CLASSIFICATION:
  rev(a) ← REVERSIBILITY_TABLE[a]
  g_risk(a) ← RISK_TABLE[a][alert_state]

GOVERNANCE DECISION:
  if watchdog_triggered == True:
    decision ← BYPASS
    reason   ← "WATCHDOG_PREEMPTION"
    goto BUILD_RECORD

  if rev(a) == IRREV and g_risk(a) == R3:
    decision ← ROUTE_TO_HUMAN
    reason   ← "IRREVERSIBLE_HIGH_RISK_DUAL_AUTH"
    goto BUILD_RECORD

  if g_conf < θ_deny:                          // θ_deny = 0.40
    decision ← DENY
    reason   ← "INSUFFICIENT_CONFIDENCE"
    goto BUILD_RECORD

  if alert_state < Pre-Instability and a ∈ {Abort, Vent}:
    decision ← DENY
    reason   ← "ACTION_TIER_MISMATCH"
    goto BUILD_RECORD

  if rev(a) == PART or g_risk(a) >= R2:
    decision ← ROUTE_TO_HUMAN
    reason   ← "PARTIAL_REVERSIBILITY_REVIEW"
    goto BUILD_RECORD

  if g_conf >= θ_auto:                         // θ_auto = 0.85
    decision ← PERMIT
    reason   ← "AUTO_PERMIT_HIGH_CONFIDENCE"
    goto BUILD_RECORD

  decision ← ROUTE_TO_HUMAN
  reason   ← "BELOW_AUTO_THRESHOLD"

BUILD_RECORD:
  gov_record ← {
    timestamp: t,
    action_proposed: a,
    reversibility: rev(a),
    risk_class: g_risk(a),
    confidence: g_conf,
    confidence_method: "vote_margin_logistic_v1",
    alert_state: alert_state,
    watchdog_state: watchdog_triggered,
    oversight_decision: decision,
    reason_code: reason,
    routing_target: NULL,
    human_decision: NULL,
    human_decision_latency_ms: NULL,
    biometric_verification: NULL,
    action_executed: False,
    execution_timestamp: NULL,
    prev_record_hash: last_gov_record_hash
  }

EXECUTION PATHS:
  case decision of
    PERMIT:
      execute_action(a)
      gov_record.action_executed ← True
      gov_record.execution_timestamp ← now()
      notify_operator(a, OVERRIDE_WINDOW)
    ROUTE_TO_HUMAN:
      gov_record.routing_target ← select_operator()
      present_for_review(a, T_review(rev(a), g_risk(a)))
      h_dec, h_lat, h_bio ← await_human_decision(T_review)
      gov_record.human_decision ← h_dec
      gov_record.human_decision_latency_ms ← h_lat
      gov_record.biometric_verification ← h_bio
      if h_dec == PERMIT:
        execute_action(a)
        gov_record.action_executed ← True
        gov_record.execution_timestamp ← now()
      else:
        log_human_denial(a, h_dec, h_bio)
    DENY:
      present_advisory(a, reason)
    BYPASS:
      log_watchdog_preemption(t)
  end case

HASH AND PERSIST:
  gov_record.record_hash ← SHA256(serialize(gov_record))
  append_to_immutable_log(gov_record)
  last_gov_record_hash ← gov_record.record_hash

  return (decision, reason, gov_record)
```

