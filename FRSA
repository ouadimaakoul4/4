```python
def simulate(spacecraft: SpacecraftGraph,
             fault_sequence: List[Fault],
             crg_level: int,
             T_sink: float = 250.0) -> TrialResult:
    power = PowerModel(spacecraft)
    thermal = ThermalModel(spacecraft)
    compute = ComputeModel(spacecraft)
    reconfig = ReconfigurationModel(spacecraft, crg_level)

    faults_survived = 0
    reconfig_time = 0.0
    energy_used = 0.0
    thermal_load = 0.0

    for fault in fault_sequence:
        spacecraft.remove_node(fault.target_id)
        if not power.is_feasible():
            if not reconfig.reconfigure(fault):
                return TrialResult(
                    crew_survived=False,
                    mission_succeeded=False,
                    useful_compute=0.0,
                    reconfiguration_time_s=reconfig_time,
                    energy_used_kwh=energy_used,
                    thermal_load_kwh=thermal_load,
                    faults_survived=faults_survived,
                    faults_total=len(fault_sequence)
                )
        if not thermal.is_feasible(T_sink):
            if not reconfig.reconfigure(fault):
                return TrialResult(...)
        faults_survived += 1
        reconfig_time += 0.01 if crg_level == 2 else 0.1

    return TrialResult(
        crew_survived=True,
        mission_succeeded=True,
        useful_compute=compute.total_compute(),
        reconfiguration_time_s=reconfig_time,
        energy_used_kwh=energy_used,
        thermal_load_kwh=thermal_load,
        faults_survived=faults_survived,
        faults_total=len(fault_sequence)
    )
```

