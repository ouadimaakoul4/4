class PowerModel:
    def __init__(self, graph: SpacecraftGraph):
        self.graph = graph
        self.buses = [n for n in graph.nodes.values()
                      if n.node_type == NodeType.POWER_BUS]
        self.sources = [n for n in graph.nodes.values()
                        if n.node_type == NodeType.POWER_SOURCE]
        self.loads = [n for n in graph.nodes.values()
                      if n.node_type in (NodeType.COMPUTE, NodeType.ECLSS,
                                         NodeType.THERMAL, NodeType.PROPULSION)]

    def total_generation(self) -> float:
        return sum(s.power_kw for s in self.sources if s.active)

    def total_load(self) -> float:
        return sum(l.power_kw for l in self.loads if l.active)

    def balance(self) -> float:
        return self.total_generation() - self.total_load()

    def is_feasible(self) -> bool:
        return self.balance() >= 0

    def reconfiguration_actions(self) -> List[str]:
        if self.crg_level == 0:
            return []
        elif self.crg_level == 1:
            return ["load_shed"]
        else:
            return ["load_shed", "reroute_power", "switch_bus"]
