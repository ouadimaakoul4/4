## M.3 Thermal Model

```python
class ThermalModel:
    def __init__(self, graph: SpacecraftGraph):
        self.graph = graph
        self.radiators = [n for n in graph.nodes.values()
                          if n.node_type == NodeType.THERMAL]
        self.heat_sources = [n for n in graph.nodes.values()
                             if n.thermal_kw > 0]

    def total_heat(self) -> float:
        return sum(s.thermal_kw for s in self.heat_sources if s.active)

    def total_rejection(self, T_sink: float = 250.0) -> float:
        epsilon = 0.9
        sigma = 5.67e-8
        T = 300.0
        q_rad = epsilon * sigma * (T**4 - T_sink**4)  # W/m²
        total_area = sum(r.mass_kg * 0.1 for r in self.radiators if r.active)
        return q_rad * total_area / 1000  # kW

    def balance(self, T_sink: float = 250.0) -> float:
        return self.total_rejection(T_sink) - self.total_heat()

    def is_feasible(self, T_sink: float = 250.0) -> bool:
        return self.balance(T_sink) >= 0

    def reconfiguration_actions(self) -> List[str]:
        if self.crg_level == 0:
            return []
        elif self.crg_level == 1:
            return ["reduce_load"]
        else:
            return ["reduce_load", "reroute_coolant", "switch_radiator"]
