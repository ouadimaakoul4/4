H.2 Promotion Proof Obligation

```
promote(m: MemoryEntry, target: TrustLevel) → Result:
  require m.trust-state ⊏ target
  require validate_provenance(m.provenance) = Pass
  require m.epistemic-type ∈ {assertion, observation}
  require m.source.trust-level ≥ RequiredTrust(m.epistemic-type)
  require m.ttl > 0
  if target = PERSISTENT:
    require validate_against_existing(m) = Consistent
  return Success(m with trust-state = target)
```

H.3 Authority Elevation Proof Obligation

```
elevate_authority(m: MemoryEntry, target: AuthorityLevel) → Result:
  require m.authority-state ⊏ target
  if target = ADVISORY:
    require m.trust-state ≥ VALIDATED
  if target = AUTHORIZED:
    require m.trust-state ≥ VALIDATED
    require exists(confirmation_event ∈ E_t : confirmation_event.memory_id = m.id)
    require verify_signature(confirmation_event, user_credential) = Valid
  if target = POLICY_CHANGING:
    require m.authority-state = AUTHORIZED
    require exists(attestation ∈ A_t : attestation.purpose = policy_change)
    require verify_tpm_signature(attestation, I_crypto) = Valid
  return Success(m with authority-state = target)
```

