import numpy as np
import matplotlib.pyplot as plt

def e_value_continuous(beta, sd, conversion_factor=0.91):
    """
    Compute E-value for a continuous outcome.
    
    Args:
        beta: Estimated coefficient
        sd: Residual standard deviation
        conversion_factor: SMD-to-RR conversion (0.91 is Chinn 2000 approx;
                          explore 0.7-1.1 for sensitivity)
    """
    smd = abs(beta) / sd
    rr = np.exp(conversion_factor * smd)
    e_val = rr + np.sqrt(rr * (rr - 1))
    return e_val, smd, rr

