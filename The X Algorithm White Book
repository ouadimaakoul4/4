### C.3 Instrumentation Example (Python)

```python
import sys, hashlib, json, time
sys.path.append('./phoenix')
from ranking import PhoenixRanker

class InstrumentedRanker(PhoenixRanker):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.model_version = self._compute_model_hash()

    def _compute_model_hash(self):
        import torch
        hasher = hashlib.sha256()
        for param in self.model.parameters():
            hasher.update(param.data.cpu().numpy().tobytes())
        return hasher.hexdigest()[:8]

    def predict(self, candidates):
        scores, probs = super().predict(candidates)
        self._log(candidates, scores, probs)
        return scores, probs

    def _log(self, candidates, scores, probs):
        log_entry = {
            'model_version': self.model_version,
            'timestamp': time.time(),
            'candidates': [c.post_id for c in candidates],
            'scores': scores.tolist(),
            'action_probs': probs.tolist() if probs is not None else None
        }
        with open('score_log.jsonl', 'a') as f:
            f.write(json.dumps(log_entry) + '\n')
```

