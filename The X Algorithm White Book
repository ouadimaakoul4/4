## Appendix G: E-Values and Sensitivity Analysis (Complete Implementation)

### G.1 E-Value Contour Plots

```python
import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

def unmeasured_confounding_bounds(beta, sd, rr_ut_range, rr_uy_range):
    """
    Compute the true effect under unmeasured confounding.
    
    Under the null hypothesis (true effect = 0), the observed effect
    satisfies: observed_effect = true_effect + confounding_bias.
    Confounding_bias ≈ RR_UT * RR_UY * (small constant).
    
    Returns a matrix showing which (RR_UT, RR_UY) pairs explain away the effect.
    """
    smd = abs(beta) / sd
    rr_approx = np.exp(0.91 * smd)
    e_val = rr_approx + np.sqrt(rr_approx * (rr_approx - 1))
    
    rr_ut_vals = np.linspace(rr_ut_range[0], rr_ut_range[1], 50)
    rr_uy_vals = np.linspace(rr_uy_range[0], rr_uy_range[1], 50)
    
    grid = np.zeros((len(rr_ut_vals), len(rr_uy_vals)))
    for i, rr_ut in enumerate(rr_ut_vals):
        for j, rr_uy in enumerate(rr_uy_vals):
            product = rr_ut * rr_uy
            if product >= e_val:
                grid[i, j] = 1  # Can explain away
            else:
                grid[i, j] = 0  # Cannot explain away
    
    return rr_ut_vals, rr_uy_vals, grid, e_val

# Example: image on score (β = 0.20, σ = 0.50)
beta = 0.20
sd = 0.50
rr_ut_range = (1.0, 3.0)
rr_uy_range = (1.0, 3.0)

rr_ut, rr_uy, grid, e_val = unmeasured_confounding_bounds(beta, sd, rr_ut_range, rr_uy_range)

# Plot contour
fig, ax = plt.subplots(figsize=(10, 8))
levels = [0.5, 1]
contour = ax.contourf(rr_ut, rr_uy, grid.T, levels=levels, colors=['green', 'red'], alpha=0.6)
ax.contour(rr_ut, rr_uy, grid.T, levels=[0.5], colors=['black'], linewidths=2)

ax.set_xlabel('RR(Confounder → Image Presence)', fontsize=12)
ax.set_ylabel('RR(Confounder → Score)', fontsize=12)
