### C.4 Kendall τ Tier Assignment with Rank-Disagreement Probability

```python
from scipy.stats import kendalltau
import numpy as np

def rank_disagreement_prob(tau, k, N):
    """
    Probability that top-k items from mini-model
    disagree with production API given Kendall τ correlation.
    
    Args:
        tau: Kendall rank correlation
        k: Top-k items of interest
        N: Total number of items
    """
    prob_agree = 1 - (k * (k - 1)) / (2 * N * (N - 1)) * (1 - tau)
    return prob_agree

# Test results
mini_model_ranks = [1, 2, 3, 4, 5, ...]  # rankings from mini-model
production_ranks = [1, 3, 2, 5, 4, ...]  # rankings from API

tau, p_value = kendalltau(mini_model_ranks, production_ranks)

# Assign tier based on tau and disagreement probability
k_eval = 5  # evaluate top-5 agreement
N = 500     # test set size
prob_top5_agree = rank_disagreement_prob(tau, k_eval, N)

print(f"Kendall τ = {tau:.3f}")
print(f"P(top-{k_eval} agree) = {prob_top5_agree:.3f}")

if tau >= 0.7:
    tier = "A"
    weight_claims_allowed = True
    print(f"TIER {tier}: Weight-dependent claims allowed (τ ≥ 0.7)")
elif 0.4 <= tau < 0.7:
    tier = "B"
    weight_claims_allowed = False
    print(f"TIER {tier}: Ordinal claims only (0.4 ≤ τ < 0.7)")
else:
    tier = "C"
    weight_claims_allowed = False
    print(f"TIER {tier}: Mechanistic claims only (τ < 0.4)")
```

