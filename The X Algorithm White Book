## Appendix L: Counter-Audit Detection Protocol

### L.1 Account Fingerprinting Test

```python
import pandas as pd
from scipy.stats import ks_2samp
import numpy as np

def fingerprint_test(audit_account_feeds, control_account_feeds, metrics=['diversity', 'freshness']):
    """
    Kolmogorov-Smirnov test for differences in feed characteristics
    between audit and control accounts.
    """
    results = {}
    
    for metric in metrics:
        audit_values = [f[metric] for f in audit_account_feeds]
        control_values = [f[metric] for f in control_account_feeds]
        
        # KS test
        d_stat, p_val = ks_2samp(audit_values, control_values)
        
        results[metric] = {
            'KS_statistic': d_stat,
            'p_value': p_val,
            'mean_audit': np.mean(audit_values),
            'mean_control': np.mean(control_values),
            'detected': p_val < 0.05  # Significant difference suggests detection
        }
        
        print(f"{metric}: KS={d_stat:.3f}, p={p_val:.4f}, " +
              f"audit_mean={np.mean(audit_values):.3f}, " +
              f"control_mean={np.mean(control_values):.3f}")
    
    return results

# Decision tree
def platform_detection_likelihood(fingerprint_results, honeytoken_visibility,
                                   changepoint_detected):
    """
    Estimate probability that X has detected the audit
    based on multiple lines of evidence.
    """
    evidence_score = 0
    max_score = 3
    
    # Evidence 1: Fingerprinting
    for metric, result in fingerprint_results.items():
        if result['detected']:
            evidence_score += 1
            print(f"⚠ Detection signal: {metric} differs significantly (p={result['p_value']:.4f})")
    
    # Evidence 2: Honeytoken visibility
    honeytoken_visibility_ratio = len([h for h in honeytoken_visibility if h]) / len(honeytoken_visibility)
    if honeytoken_visibility_ratio < 0.3:  # Honeytokens should be visible ~50% in control accounts
        evidence_score += 1
        print(f"⚠ Detection signal: Honeytokens visible in {honeytoken_visibility_ratio:.1%} of audit feeds (expected ~50%)")
    
    # Evidence 3: Changepoint detection
    if changepoint_detected:
        evidence_score += 1
        print(f"⚠ Detection signal: Changepoint in feed metrics detected")
    
