## Appendix M: Temporal Validity and Changepoint Detection

### M.1 Half-Life Estimation

```python
import numpy as np
from scipy.optimize import curve_fit
import matplotlib.pyplot as plt

def exponential_decay_model(t, M_inf, M_0, lambda_param):
    """Exponential decay: M(t) = M_inf + (M_0 - M_inf) * exp(-lambda * t)"""
    return M_inf + (M_0 - M_inf) * np.exp(-lambda_param * t)

def compute_half_life(times, metrics, model=exponential_decay_model):
    """
    Fit an exponential decay model to metric timeseries.
    Compute half-life as the time when metric reaches 50% change.
    """
    # Remove outliers
    metrics_clean = np.array(metrics)
    q1, q3 = np.percentile(metrics_clean, [25, 75])
    iqr = q3 - q1
    mask = (metrics_clean >= q1 - 1.5*iqr) & (metrics_clean <= q3 + 1.5*iqr)
    
    times_clean = np.array(times)[mask]
    metrics_clean = metrics_clean[mask]
    
    # Fit model
    try:
        popt, pcov = curve_fit(model, times_clean, metrics_clean,
                                p0=[np.min(metrics_clean), np.max(metrics_clean), 0.01],
                                maxfev=5000)
        M_inf, M_0, lambda_param = popt
        
        # Compute half-life
        # Solve: M(t_half) = M_inf + 0.5 * (M_0 - M_inf)
        # → exp(-lambda * t_half) = 0.5
        # → t_half = ln(2) / lambda
        t_half = np.log(2) / lambda_param
        
        # Plot
        t_smooth = np.linspace(times_clean.min(), times_clean.max(), 100)
        m_smooth = model(t_smooth, M_inf, M_0, lambda_param)
        
        fig, ax = plt.subplots(figsize=(10, 6))
        ax.scatter(times_clean, metrics_clean, label='Observed τ', s=50, alpha=0.6)
        ax.plot(t_smooth, m_smooth, 'r-', linewidth=2, label='Fitted decay model')
        ax.axvline(t_half, color='g', linestyle='--', linewidth=2, label=f'Half-life = {t_half:.0f} days')
        ax.axhline(M_inf + 0.5*(M_0 - M_inf), color='gray', linestyle=':', alpha=0.5)
        
        ax.set_xlabel('Days Post-Publication', fontsize=12)
        ax.set_ylabel('Kendall τ (Mini-Model Fidelity)', fontsize=12)
        ax.set_title('Temporal Decay of Mini-Model Fidelity', fontsize=14)
        ax.legend()
        ax.grid(True, alpha=0.3)
        
        plt.tight_layout()
        plt.savefig('half_life_estimation.png', dpi=150)
        plt.show()
        
        return t_half, (M_inf, M_0, lambda_param)
    except Exception as e:
        print(f"Error fitting model: {e}")
        return None, None

# Example: longitudinal τ measurements
times_days = np.array([0, 7, 14, 21, 28, 35, 42, 49, 56, 60])
tau_measurements = np.array([0.70, 0.68, 0.65, 0.63, 0.60, 0.57, 0.54, 0.51, 0.49, 0.48])

