## Appendix H: Synthetic Data Validation Protocol (Complete)

### H.1 Validation Checklist

```python
def validate_synthetic_data(D_syn, D_real=None, threshold_correlation=0.1, 
                            threshold_utility=0.80):
    """
    Comprehensive validation of synthetic dataset.
    Returns a Validity Score (Definition 1).
    """
    import numpy as np
    from scipy.spatial.distance import pdist, squareform
    from sklearn.linear_model import LogisticRegression
    from sklearn.metrics import roc_auc_score
    
    # 1. FIDELITY CHECK
    if D_real is not None:
        corr_syn = np.corrcoef(D_syn.T)
        corr_real = np.corrcoef(D_real.T)
        rho_max = np.max(np.abs(corr_syn - corr_real))
        fidelity_pass = rho_max <= threshold_correlation
        fidelity_score = "HIGH" if fidelity_pass else "LOW"
        print(f"Fidelity check: ρ_max = {rho_max:.3f} (threshold: {threshold_correlation}) → {fidelity_score}")
    else:
        print("⚠ Data desert detected: no real data for fidelity comparison")
        return {"Confidence": "LOW", "Fidelity": "N/A", "reason": "data_desert"}
    
    # 2. BIAS AUDIT (Edge cases coverage)
    low_activity_real = (D_real.sum(axis=1) < np.percentile(D_real.sum(axis=1), 10)).sum()
    low_activity_syn = (D_syn.sum(axis=1) < np.percentile(D_syn.sum(axis=1), 10)).sum()
    
    coverage_ratio = low_activity_syn / max(low_activity_real, 1)
    bias_audit_pass = 0.5 <= coverage_ratio <= 1.5  # Allow 1.5x variation
    print(f"Bias audit (low-activity): real={low_activity_real}, synthetic={low_activity_syn}, ratio={coverage_ratio:.2f} → {'PASS' if bias_audit_pass else 'FAIL'}")
    
    # 3. UTILITY THRESHOLD
    # Train classifier on synthetic data; test on real data
    X_syn, y_syn = D_syn[:, :-1], D_syn[:, -1]
    X_real, y_real = D_real[:, :-1], D_real[:, -1]
    
    clf_syn = LogisticRegression(random_state=42)
    clf_syn.fit(X_syn, y_syn)
    
    # Evaluate on real data
    auc_real = roc_auc_score(y_real, clf_syn.predict_proba(X_real)[:, 1])
    
    # Train on real data for comparison
    clf_real = LogisticRegression(random_state=42)
    clf_real.fit(X_real, y_real)
    auc_real_baseline = roc_auc_score(y_real, clf_real.predict_proba(X_real)[:, 1])
    
    utility_ratio = auc_real / auc_real_baseline
    utility_pass = utility_ratio >= threshold_utility
    print(f"Utility threshold: AUC (synthetic) = {auc_real:.3f}, AUC (baseline) = {auc_real_baseline:.3f}, ratio = {utility_ratio:.3f} → {'PASS' if utility_pass else 'FAIL'}")
    
    # 4. CONFIDENCE DETERMINATION
    if fidelity_pass and bias_audit_pass and utility_pass:
        confidence = "HIGH"
    elif (rho_max <= 0.15 and bias_audit_pass) or utility_ratio >= 0.75:
        confidence = "MEDIUM"
    else:
        confidence = "LOW"
    
    return {
        "Fidelity": fidelity_score,
        "rho_max": rho_max,
        "Bias_Audit": "PASS" if bias_audit_pass else "FAIL",
        "Utility_Ratio": utility_ratio,
        "Confidence": confidence
    }

# Example usage
import numpy as np
D_syn = np.random.randn(1000, 20)  # Synthetic data
D_real = np.random.randn(1000, 20) + 0.05  # Real data (slightly different)

result = validate_synthetic_data(D_syn, D_real)
print(f"\nFinal Validity Score: {result['Confidence']}")
```

