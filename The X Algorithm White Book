### M.2 Bayesian Online Changepoint Detection (BOCPD)

```python
import numpy as np
from scipy.stats import norm

def bocpd(data, hazard_rate=1/20):
    """
    Bayesian online changepoint detection (simplified for Gaussian outcomes).
    
    Args:
        data: 1D timeseries (e.g., daily τ measurements)
        hazard_rate: prior probability of changepoint at each time (default: 1/20 = 5% daily)
    
    Returns:
        changepoint_prob: posterior probability of changepoint at each time
    """
    n = len(data)
    
    # Initialize
    log_prob = np.zeros((n, n))  # log_prob[t, s] = log P(data[s:t] | changepoint at s)
    growth_prob = np.zeros((n, n))  # growth_prob[t, s] = log P(no changepoint from s to t)
    
    # Hyperpriors
    mu_prior_mean = np.mean(data)
    mu_prior_var = np.var(data)
    sigma2_prior = np.var(data)
    
    # Likelihood model
    for t in range(n):
        for s in range(t + 1):
            segment = data[s:t+1]
            if len(segment) > 0:
                mu = np.mean(segment)
                sigma2 = np.var(segment) if len(segment) > 1 else sigma2_prior
                
                # Log-likelihood under Gaussian model
                log_likelihood = -0.5 * np.sum((segment - mu)**2) / sigma2
                log_prob[t, s] = log_likelihood
    
    # Forward pass (Viterbi-like)
    changepoint_probs = []
    for t in range(1, n):
        # Probability of changepoint at t
        changepoint_ll = np.log(hazard_rate) + np.max(log_prob[t-1, :t])
        no_changepoint_ll = np.log(1 - hazard_rate) + np.max(log_prob[t, :t+1])
        
        marginal_ll = np.logaddexp(changepoint_ll, no_changepoint_ll)
        changepoint_prob = np.exp(changepoint_ll - marginal_ll)
        changepoint_probs.append(changepoint_prob)
    
    return np.array(changepoint_probs)

# Example: daily τ measurements over 60 days
np.random.seed(42)
tau_series = np.concatenate([
    np.random.normal(0.70, 0.02, 20),  # Stable period 1
    np.random.normal(0.65, 0.02, 15),  # Changepoint + stable period 2
    np.random.normal(0.50, 0.03, 25),  # Changepoint + stable period 3
])

changepoint_probs = bocpd(tau_series, hazard_rate=1/20)

# Plot
