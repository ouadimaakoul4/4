39:  if candidates = ∅ then return NULL
40:
41:  // Step 8: Select smallest valid candidate
42:  c ← argmin_{c_i ∈ candidates} |c_i|
43:
44:  // Step 9: Local minimality check
45:  changed ← true
46:  while changed do
47:      changed ← false
48:      for each c' ∈ Ablate_1(c) do
49:          if Valid(c', T) then
50:              c ← c'
51:              changed ← true
52:              break
53:          end if
54:      end for
55:  end while
56:
57:  // Step 10: Log extraction
58:  LogExtraction(c, C_ext, timestamp)
59:
60:  return c
─────────────────────────────────────────────────────────────────────────
```

C.1.4 Subroutines

```
BuildMTCU(nodes, interface_spec, agent):
  1: I ← InferInputInterface(nodes, interface_spec)
  2: O ← InferOutputInterface(nodes, interface_spec)
  3: R ← InferRepresentation(nodes, agent)
  4: Π ← InferProcedure(nodes, agent)
  5: I_inv ← InferInvariants(nodes, agent)
  6: P ← InferPlasticityOperators(nodes, agent)
  7: E ← interface_spec.evaluation_contract
  8: return MTCU(I, O, R, Π, I_inv, P, E)

Valid(c, T):
  1: if not Instantiable(c) then return false
  2: if not PreservesInvariants(c) then return false
  3: if not Transmissible(c) then return false
  4: if not PerturbationRobust(c) then return false
  5: if not IndependentlyEvaluable(c) then return false
  6: if not ProducesTrait(c, T) then return false
  7: return true

Ablate_1(c):
  1: components ← [I, O, R, Π, I_inv, P, E]
  2: ablations ← ∅
  3: for i = 1 to 7 do
  4:     c' ← c with components[i] removed
  5:     ablations ← ablations ∪ {c'}
  6: end for
  7: return ablations
