C.2.2 Subroutines

```
Compatibility(c_A, c_B):
  1: // Interface type-checking
  2: type_AB ← TypeCheck(c_A.O, c_B.I)
  3: type_BA ← TypeCheck(c_B.O, c_A.I)
  4: type_compat ← type_AB ∧ type_BA
  5:
  6: // Invariant compatibility
  7: inv_compat ← |c_A.I_inv ∩ c_B.I_inv| / |c_A.I_inv ∪ c_B.I_inv|
  8:
  9: // Semantic alignment
 10: sem_align ← RSA(c_A.R, c_B.R)
 11: // RSA = Representational Similarity Analysis
 12:
 13: // Weighted combination
 14: Γ ← w_1 · 1[type_compat] + w_2 · inv_compat + w_3 · sem_align
 15: return Γ

SelectModules(c_A, c_B, ξ):
  1: // Select modules based on operator specification
  2: M_A ← SelectFromParent(c_A, ξ.selection_criterion)
  3: M_B ← SelectFromParent(c_B, ξ.selection_criterion)
  4: return M_A ∪ M_B

ComposeGraphs(M_sel, ξ):
  1: V_new ← ∅
  2: E_new ← ∅
  3: for each module m ∈ M_sel do
  4:     V_new ← V_new ∪ m.nodes
  5:     E_new ← E_new ∪ m.edges
  6: end for
  7: // Add inter-module edges
  8: for each pair (m_i, m_j) ∈ M_sel² do
  9:     if Compatible(m_i, m_j) then
 10:         E_new ← E_new ∪ {(m_i.output, m_j.input)}
 11:     end if
 12: end for
 13: return Graph(V_new, E_new)

AdaptInterfaces(G_graph, ξ):
  1: for each edge (u, v) ∈ G_graph.E do
  2:     if not TypeCheck(u.output, v.input) then
  3:         // Insert adapter module
  4:         adapter ← CreateAdapter(u.output, v.input)
  5:         G_graph.V ← G_graph.V ∪ {adapter}
  6:         G_graph.E ← G_graph.E \ {(u, v)} ∪ {(u, adapter), (adapter, v)}
  7:     end if
  8: end for
  9: return G_graph

AlignRepresentations(G_iface, ξ):
  1: R_A ← ExtractRepresentation(G_iface, "parent_A")
  2: R_B ← ExtractRepresentation(G_iface, "parent_B")
  3: // Find alignment map
  4: if ξ.alignment_method = "procrustes" then
  5:     W ← ProcrustesAlignment(R_A, R_B)
  6: elsif ξ.alignment_method = "optimal_transport" then
  7:     W ← OptimalTransport(R_A, R_B)
  8: elsif ξ.alignment_method = "cca" then
  9:     W ← CanonicalCorrelation(R_A, R_B)
 10: end if
 11: // Apply alignment
 12: G_iface.representation_alignment ← W
 13: return G_iface

IntersectConstraints(c_A, c_B):
  1: return c_A.I_inv ∩ c_B.I_inv
```

C.3 Algorithm 6 (Extended): Matched Germline Substitution with Full Details

C.3.1 Full Algorithm

```
Algorithm 6 (Extended): Matched Germline Substitution
─────────────────────────────────────────────────────────────────────────
Require: Parents A, B, operator R, trait T, sample size N
Ensure: H_0(T) with confidence interval

 1:  // Step 1: Fix stochastic background
 2:  ξ ← FixedRandomness()
 3:  mutation_A ← FixedMutations(A)
 4:  mutation_B ← FixedMutations(B)
 5:  dev_seed ← FixedSeed()
 6:
 7:  // Step 2: Treatment condition (both parents)
 8:  T_treatment ← []
 9:  for i = 1 to N do
 10:     G_X ← R(A, B, ξ, mutation_A, mutation_B, dev_seed)
 11:     X_0 ← Instantiate(G_X)
 12:     FreezeLearning(X_0)
 13:     T_i ← EvaluateTrait(X_0, T, X_test)
 14:     T_treatment.append(T_i)
 15: end for
 16:
 17: // Step 3: Control condition (substitute parent A)
 18: T_control ← []
 19: for i = 1 to N do
 20:     A_random ← RandomGermline(complexity(A))
 21:     G_C ← R(A_random, B, ξ, mutation_A, mutation_B, dev_seed)
 22:     X_0 ← Instantiate(G_C)
 23:     FreezeLearning(X_0)
 24:     T_i ← EvaluateTrait(X_0, T, X_test)
 25:     T_control.append(T_i)
 26: end for
 27:
 28: // Step 4: Control condition (substitute parent B)
 29: T_control_B ← []
 30: for i = 1 to N do
 31:     B_random ← RandomGermline(complexity(B))
 32:     G_C ← R(A, B_random, ξ, mutation_A, mutation_B, dev_seed)
 33:     X_0 ← Instantiate(G_C)
 34:     FreezeLearning(X_0)
 35:     T_i ← EvaluateTrait(X_0, T, X_test)
 36:     T_control_B.append(T_i)
 37: end for
 38:
 39: // Step 5: Compute causal effects
 40: H_0_A ← mean(T_treatment) - mean(T_control)
 41: H_0_B ← mean(T_treatment) - mean(T_control_B)
 42: H_0 ← (H_0_A + H_0_B) / 2
 43:
 44: // Step 6: Bootstrap confidence intervals
 45: CI_A ← BootstrapCI(T_treatment, T_control, α=0.05, B=10000)
 46: CI_B ← BootstrapCI(T_treatment, T_control_B, α=0.05, B=10000)
 47: CI ← (CI_A + CI_B) / 2
 48:
 49: // Step 7: Significance test
 50: p_value ← PermutationTest(T_treatment, T_control, B=10000)
 51:
 52: return H_0, CI, p_value
─────────────────────────────────────────────────────────────────────────
```

C.3.2 Statistical Details

```
BootstrapCI(treatment, control, α, B):
  1: n_t ← |treatment|
  2: n_c ← |control|
  3: effects ← []
  4: for b = 1 to B do
  5:     t_sample ← BootstrapSample(treatment, n_t)
  6:     c_sample ← BootstrapSample(control, n_c)
  7:     effect ← mean(t_sample) - mean(c_sample)
  8:     effects.append(effect)
  9: end for
 10: lower ← Quantile(effects, α/2)
 11: upper ← Quantile(effects, 1-α/2)
 12: return (lower, upper)

PermutationTest(treatment, control, B):
  1: combined ← treatment ∪ control
  2: n_t ← |treatment|
  3: observed ← mean(treatment) - mean(control)
  4: count ← 0
  5: for b = 1 to B do
  6:     perm ← Permute(combined)
  7:     t_perm ← perm[1:n_t]
  8:     c_perm ← perm[n_t+1:end]
  9:     effect_perm ← mean(t_perm) - mean(c_perm)
 10:     if |effect_perm| ≥ |observed| then
 11:         count ← count + 1
 12:     end if
 13: end for
 14: p_value ← (count + 1) / (B + 1)
 15: return p_value
```

