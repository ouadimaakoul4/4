Appendix L: Simulation Code Framework

L.1 Python Code Structure

```python
# T³ES 0.5 Simulation Framework
# Module: Efficiency Model

import numpy as np
import matplotlib.pyplot as plt

class GravityStorageSystem:
    def __init__(self, params):
        self.m = params['module_mass']          # kg
        self.h = params['shaft_depth']          # m
        self.g = 1.62                           # m/s²
        self.N = params['num_modules']          # dimensionless
        self.Nb = params['batch_size']          # dimensionless
        self.v = params['hoist_velocity']       # m/s
        self.eta_motor = 0.92
        self.eta_gen = 0.92
        self.eta_PE = 0.97
        self.eta_mech_init = 0.90
        self.r = params['retention_factor']
        
    def energy_per_module(self):
        return self.m * self.g * self.h / 3.6e6  # kWh
    
    def total_energy(self):
        return self.energy_per_module() * self.N
    
    def mechanical_efficiency(self, n):
        return self.eta_mech_init * self.r**(n/1000)
    
    def round_trip_efficiency(self, n):
        eta_mech = self.mechanical_efficiency(n)
        return (self.eta_motor * eta_mech * eta_mech * 
                self.eta_gen * self.eta_PE)
    
    def average_efficiency(self, N_cycles):
        # Analytical integration
        N = N_cycles
        r = self.r
        eta_0 = self.eta_mech_init
        
        if r == 1.0:
            avg_mech = eta_0
        else:
            avg_mech = (eta_0 * 1000 / (N * np.log(r))) * \
                       (r**(N/1000) - 1)
        
        return (self.eta_motor * avg_mech * avg_mech * 
                self.eta_gen * self.eta_PE)
    
    def power_out(self):
        return (self.eta_gen * self.eta_PE * 
                self.Nb * self.m * self.g * self.v / 1000)  # kW
    
    def power_in(self):
        return (self.Nb * self.m * self.g * self.v / 
                (self.eta_PE * self.eta_motor * self.eta_mech_init) / 1000)  # kW
    
    def charge_time(self):
        N_batches = int(np.ceil(self.N / self.Nb))
        lift_time = self.h / self.v
        return_time = self.h / (2 * self.v)  # faster empty return
        total_batch_time = lift_time + return_time
        return N_batches * total_batch_time / 3600  # hours
    
    def lifetime_energy(self, N_cycles):
        avg_eta = self.average_efficiency(N_cycles)
        return self.total_energy() * N_cycles * avg_eta  # kWh
```

L.2 Production Model Code

```python
# Module: Production Model

class ProductionModel:
    def __init__(self, params):
        self.excavation_energy = params['excavation_energy']  # kWh/kg
        self.processing_fraction = params['processing_fraction']
        self.module_mass = params['module_mass']  # kg
        self.num_modules = params['num_modules']
        self.bag_mass = params['bag_mass']  # kg
        self.production_power = params['production_power']  # kW
        
    def excavation_energy_per_module(self):
        return self.excavation_energy * self.module_mass  # kWh
    
    def processing_energy_per_module(self):
        return (self.excavation_energy_per_module() * 
                self.processing_fraction)
    
    def total_energy_per_module(self):
        return (self.excavation_energy_per_module() + 
                self.processing_energy_per_module())
    
    def total_production_energy(self):
        return self.total_energy_per_module() * self.num_modules
    
    def production_time(self):
        return self.total_production_energy() / self.production_power  # hours
    
    def total_bag_mass(self):
        return self.bag_mass * self.num_modules
