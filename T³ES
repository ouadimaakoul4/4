# Module: EIME Calculator

class EIMECalculator:
    def __init__(self, system_params):
        self.system = GravityStorageSystem(system_params)
        self.production = ProductionModel(system_params)
        
    def imported_mass(self):
        return {
            'structural': 1500,
            'thermal': 212,
            'bags': self.production.total_bag_mass(),
            'spares': 950
        }
    
    def total_imported_mass(self):
        return sum(self.imported_mass().values())
    
    def lifetime_energy(self, N_cycles):
        return self.system.lifetime_energy(N_cycles)
    
    def EIME(self, N_cycles):
        return self.lifetime_energy(N_cycles) / self.total_imported_mass()
    
    def LREE(self, N_cycles):
        return (self.lifetime_energy(N_cycles) / 
                self.production.total_production_energy())
    
    def AIE(self, N_cycles, lambda_coeff=1e-4):
        denominator = (self.total_imported_mass() + 
                       lambda_coeff * self.production.total_production_energy())
        return self.lifetime_energy(N_cycles) / denominator
