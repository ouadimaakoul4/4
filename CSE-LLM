Appendix G. Lean 4 Formalization of Extended Constraints (C1–C5)

We formalize the structural constraint set C = \{c_1, \ldots, c_m\} and prove that the rejection envelope guarantees containment.

```lean
import Mathlib.Data.Set.Basic
import Mathlib.Data.Finset.Basic

/-!
# Extended Lean 4 Formalization: Constraint Containment Conditions (C1–C5)
# for the CSE-LLM Safety Envelope

This extension formalizes the structural constraint set C = {c₁, ..., c_m},
the feature components, hypotheses, variables, causal edges, balance equations,
and scores, then proves that the rejection envelope guarantees containment.
-/

section ExtendedSafetyEnvelope

-- 1. Domain Definitions and Structures
variable (Hypothesis Variable Edge Balance : Type*)

-- System structures
structure CausalGraph where
  vars : Finset Variable
  edges : Finset Edge

structure PhysicalState where
  valid_balances : Balance → Prop

-- The complete constraint set C = {c₁, ..., c_m}
structure ConstraintSet (H : Finset Hypothesis) (G : CausalGraph) where
  allowed_hypotheses : Finset Hypothesis
  allowed_hypotheses_subset : allowed_hypotheses ⊆ H
  allowed_vars : Finset Variable
  allowed_vars_subset : allowed_vars ⊆ G.vars
  allowed_edges : Finset Edge
  allowed_edges_subset : allowed_edges ⊆ G.edges

-- Diagnostic Output Structure produced by the LLM or physical backup
structure DiagnosticOutput where
  named_hypotheses : Finset Hypothesis
  named_variables : Finset Variable
  asserted_edges : Finset Edge
  asserted_balances : Finset Balance
  score_consistent : Bool

-- 2. Formalization of Admissibility Conditions (C1 - C5)
def satisfies_constraints (C : ConstraintSet H G) (r : DiagnosticOutput)
    (state : PhysicalState) : Prop :=
  -- (C1) Hypothesis containment
  (r.named_hypotheses ⊆ C.allowed_hypotheses) ∧
  -- (C2) Variable containment
  (r.named_variables ⊆ C.allowed_vars) ∧
  -- (C3) Causal containment
  (r.asserted_edges ⊆ C.allowed_edges) ∧
  -- (C4) Physical consistency
  (∀ b ∈ r.asserted_balances, state.valid_balances b) ∧
  -- (C5) Score consistency
  (r.score_consistent = true)

-- 3. Safety Policy & Proof of Proposition 7.1
variable {H : Finset Hypothesis} {G : CausalGraph} (C : ConstraintSet H G)
variable (state : PhysicalState)
variable (r_phys : DiagnosticOutput)
hypothesis h_phys_admissible : satisfies_constraints C r_phys state

noncomputable def validate_output (r : DiagnosticOutput) : Bool :=
  if decide (satisfies_constraints C r state) then true else false

noncomputable def safety_policy (r_LLM : DiagnosticOutput) : DiagnosticOutput :=
  if validate_output C state r_LLM then r_LLM else r_phys

/--
Theorem 7.1 (Extended):
The safety policy guarantees that the emitted output strictly satisfies
all constraints C1 through C5.
-/
theorem safety_by_rejection_extended (r_LLM : DiagnosticOutput) :
  satisfies_constraints C (safety_policy C state r_phys r_LLM) state := by
  dsimp [safety_policy, validate_output]
  split_ifs with h
  · rw [decide_eq_true_iff] at h
    exact h
  · exact h_phys_admissible

end ExtendedSafetyEnvelope
```

