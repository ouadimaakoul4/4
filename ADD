    ┌─────────────────────────────────────────────────────────────────────────────────────────────┐
    │  STEP 10:  COMPUTE STRUCTURAL CHANGE                                                         │
    │                                                                                              │
    │     ΔΣ_t = ||Σ̂(t) − Σ̂(t−w)||_F                                                              │
    │                                                                                              │
    │     [bound: ΔΣ_t ≥ √2 · σ_1 · σ_2 · |Δρ|  under stationary variances]                        │
    └─────────────────────────────────────────────────────────────────────────────────────────────┘
                                              │
                                              ▼
    ┌─────────────────────────────────────────────────────────────────────────────────────────────┐
    │  STEP 11:  UPDATE MRS-C-INSPIRED DETECTOR                                                    │
    │                                                                                              │
    │     S_t = max(0, S_{t−1} + ΔΣ_t − κ)                                                        │
    │                                                                                              │
    │     [imported from Lee et al. (2025); NOT claimed as new theorem of ADD]                     │
    └─────────────────────────────────────────────────────────────────────────────────────────────┘
                                              │
                                              ▼
    ┌─────────────────────────────────────────────────────────────────────────────────────────────┐
    │  STEP 12:  CHECK INNOVATION SEQUENCE                                                         │
    │                                                                                              │
    │     ν(t) = z(t) − ẑ(t|t−1)                                                                  │
    │     IF autocorr(ν) > threshold OR kurtosis(ν) > threshold:                                   │
    │         FLAG "STRATEGIC_OBSERVATION"                                                         │
    │         Q_adaptive = Q_0 + η · I_effort(t) · I                                                  │
    │         activate behavioral probes                                                           │
    └─────────────────────────────────────────────────────────────────────────────────────────────┘
                                              │
                                              ▼
    ┌─────────────────────────────────────────────────────────────────────────────────────────────┐
    │  STEP 13:  CLASSIFY STATUS                                                                   │
    │                                                                                              │
    │     IF  B̂(t) < θ_B  AND  S_t < h:           status = GREEN                                  │
    │     ELIF  B̂(t) < θ_A  AND  S_t ≥ h:          status = AMBER                                  │
    │     ELSE:                                      status = RED                                   │
    └─────────────────────────────────────────────────────────────────────────────────────────────┘
                                              │
                                              ▼
    ┌─────────────────────────────────────────────────────────────────────────────────────────────┐
    │  STEP 14:  EMIT ASSURANCE STATE RECORD                                                       │
    │                                                                                              │
    │     AssuranceState {                                                                         │
    │         timestamp,                                                                           │
    │         Ĉ(t), Â(t), Û(t), μ̂(t),                                                              │
    │         Q̂_A^prod(t), Q̂_A^min(t),                                                             │
    │         D̂(t), B̂(t),                                                                          │
    │         Σ̂(t), ΔΣ_t, S_t,                                                                     │
    │         status,                                                                              │
    │         flags: { STRATEGIC_OBSERVATION }                                                     │
    │     }                                                                                        │
    └─────────────────────────────────────────────────────────────────────────────────────────────┘
                                              │
                                              ▼
    ┌─────────────────────────────────────────────────────────────────────────────────────────────┐
    │  FEEDBACK:  I_effort(t), E_safety(t) updated based on status                                 │
    │                                                                                              │
    │     GREEN:  I_effort unchanged (or reduced)                                                  │
    │     AMBER:  I_effort increased (safety RL, scale reduction, probe activation)                 │
    │     RED:    I_effort → 1 (pause, human review)                                               │
    │                                                                                              │
    │     → Return to STEP 1 for next t                                                            │
    └─────────────────────────────────────────────────────────────────────────────────────────────┘
