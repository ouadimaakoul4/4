### **B.1: Lanczos Hierarchy Discovery (Algorithm 2.1) — Full Pseudocode**

```
Algorithm: Lanczos_Hierarchy_Discovery(E, num_trajectories=100, M=10000, K=100)

// Phase 1: Generate Trajectory Data
trajectories ← []
for i = 1 to num_trajectories:
    s_init ← sample_from_uniform_manifold(𝓜_safe)
    s_current ← s_init
    
    for t = 1 to 100:
        // Gradient flow ODE step (4th-order Runge-Kutta)
        grad ← ∇E(s_current)
        s_current ← s_current - dt * grad  (dt = 0.01)
        trajectories.append(s_current)
    end for
end for

trajectory_data ← trajectories[random sample of M points]

// Phase 2: Lanczos per Data Point
all_eigenvalues ← []
for each s_j in trajectory_data:
    
    // Step 1: Matrix-Free Hessian-Vector Product Setup
    function HVP(v):
        // Compute H @ v without forming H explicitly
        grad1 ← autograd(E, s_j)            // ∇E(s_j)
        prod ← dot(grad1, v)                 // <∇E, v>
        grad2 ← autograd(prod, s_j)          // ∇(<∇E, v>) = H @ v
        return grad2
    end function
    
    // Step 2: Lanczos Algorithm
    V ← [normalize(random_vector(2432))]    // Lanczos vectors
    α ← []                                   // Diagonal of T_K
    β ← []                                   // Subdiagonal of T_K
    
    for k = 1 to K:
        w ← HVP(V[k])                        // H @ v_k
        α_k ← dot(w, V[k])
        α.append(α_k)
        
        w ← w - α_k * V[k]                   // Orthogonalize
        if k > 0:
            w ← w - β[k-1] * V[k-1]
        end if
        
        β_k ← norm(w)
        β.append(β_k)
        
        if β_k < 1e-10:
            break  // Converged
        end if
        
        V.append(w / β_k)                    // Next Lanczos vector
    end for
    
    // Step 3: Eigendecomposition of Tridiagonal
    T_K ← tridiag(α, β)                     // K × K tridiagonal matrix
    λ ← eigenvalues(T_K)                     // Compute eigenvalues of T_K
    λ ← sort(λ, order='descending')
    all_eigenvalues.append(λ)
    
end for

// Phase 3: Spectral Gap Analysis
mean_eigenvalues ← mean(all_eigenvalues, axis=0)  // Average over data points
gaps ← [|mean_eigenvalues[i+1] / mean_eigenvalues[i]| for i in 1..K-1]
k_star ← argmax(gaps)

ε_empirical ← |mean_eigenvalues[k_star] / mean_eigenvalues[k_star + 1]|
τ_slow ← 1 / |mean_eigenvalues[k_star]|
τ_fast ← 1 / |mean_eigenvalues[k_star + 1]|

// Phase 4: Hyperbolicity Check
J_fast_eigenvalues ← []
for each s_slow_point in critical_points:
    H_low ← Hessian(E_low, s_slow_point)    // Hessian of low-level part
    evals ← eigenvalues(H_low)
    J_fast_eigenvalues.append(evals)
end for

α_min ← min(real_part(J_fast_eigenvalues))
is_hyperbolic ← (α_min < -0.01)

// Output
return {
    d_h: k_star,
    n_h: 16,  // Empirically determined
    ε_empirical: ε_empirical,
    α: -α_min,
    τ_slow: τ_slow,
    τ_fast: τ_fast,
    is_hyperbolic: is_hyperbolic
}
```

### **B.2: Deep HJB Solver (Algorithm 4.1) — PyTorch Implementation**

```python
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import TensorDataset, DataLoader

class DeepHJBSolver(nn.Module):
    def __init__(self, state_dim=48, budget_dim=1):
        super().__init__()
        input_dim = state_dim + budget_dim
        self.mlp = nn.Sequential(
            nn.Linear(input_dim, 256),
            nn.ReLU(),
            nn.Linear(256, 256),
            nn.ReLU(),
            nn.Linear(256, 1)
        )
    
    def forward(self, s_c, n):
        """
        Args:
            s_c: state tensor of shape (batch, 48)
            n: budget tensor of shape (batch, 1)
        Returns:
            value: cost-to-go of shape (batch, 1)
        """
        x = torch.cat([s_c, n], dim=1)
        value = self.mlp(x)
        return value

def train_deep_hjb(full_model, num_trajectories=5000, horizon=100, n_max=20):
    """
    Train the deep HJB value function.
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    solver = DeepHJBSolver().to(device)
    optimizer = optim.Adam(solver.parameters(), lr=1e-3)
    criterion = nn.MSELoss()
    
    # Generate reference trajectories
    print("Generating reference trajectories...")
    training_data = []
    
    for traj_idx in range(num_trajectories):
        s_c_traj = full_model.generate_trajectory(horizon)  # shape: (horizon, 48)
        
        # Compute empirical cost-to-go
        costs = torch.zeros(horizon)
        for t in range(horizon):
            for τ in range(t, horizon):
                # Cost = reconstruction error + query cost
                recon_error = torch.norm(s_c_traj[τ] - decode(s_c_traj[τ])) ** 2
                query_cost = 0  # Assume optimal queries (can be randomized)
                costs[t] += recon_error + 0.1 * query_cost
        
        for t in range(horizon):
            n = torch.full((1, 1), n_max, dtype=torch.float32)
            training_data.append({
                's_c': s_c_traj[t],
                'n': n.squeeze(),
                'cost_to_go': costs[t]
            })
    
    # Create DataLoader
    s_c_batch = torch.stack([d['s_c'] for d in training_data])
    n_batch = torch.stack([d['n'] for d in training_data])
    cost_batch = torch.stack([torch.tensor(d['cost_to_go']) for d in training_data])
    
    dataset = TensorDataset(s_c_batch, n_batch, cost_batch)
    loader = DataLoader(dataset, batch_size=32, shuffle=True)
    
    # Train
    print("Training deep HJB solver...")
    num_epochs = 100
    for epoch in range(num_epochs):
        epoch_loss = 0
        for s_c, n, targets in loader:
            s_c, n, targets = s_c.to(device), n.to(device), targets.to(device).unsqueeze(1)
            
            # Forward pass
            predictions = solver(s_c, n)
            loss = criterion(predictions, targets)
            
            # Backward pass
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
            
            epoch_loss += loss.item()
        
        if (epoch + 1) % 20 == 0:
            print(f"Epoch {epoch+1}/{num_epochs}, Loss: {epoch_loss / len(loader):.6f}")
    
    return solver

def inference_hjb(solver, s_c, n, beta_q=0.1):
    """
    Compute optimal query decision at runtime.
    
    Args:
        s_c: current compressed state
        n: number of queries remaining
        beta_q: cost per query
    
    Returns:
        u: 1 if query now, 0 otherwise
    """
    solver.eval()
    with torch.no_grad():
        # Value if we don't query
        v_current = solver(s_c.unsqueeze(0), torch.tensor([[n]], dtype=torch.float32))
        
        # Value if we query (use one query)
        v_one_less = solver(s_c.unsqueeze(0), torch.tensor([[n-1]], dtype=torch.float32))
        
        # Marginal value test
        margin = (v_current - v_one_less).item()
        u = 1 if margin > beta_q else 0
    
    return u
```

