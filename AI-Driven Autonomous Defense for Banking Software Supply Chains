LTLSPEC G( state = AutoContain -> (p > 0.95 & phi > 0.98) )
LTLSPEC G( state = AlertEval -> F(state = AutoContain | state = HumanConfirm) )
INVARSPEC !( state = Error -> !(EX TRUE) )  -- no deadlock
