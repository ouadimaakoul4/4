B.1 NuSMV Model Code

```nusmv
MODULE main
VAR
  state : {Idle, AlertEval, AutoContain, HumanConfirm, ReportGen, MitigationDone, Error};
  p : real;   -- GNN confidence
  phi : real; -- ISV fidelity
  impact : real; -- financial threshold

ASSIGN
  init(state) := Idle;
  next(state) := case
    state = Idle & alert : AlertEval;
