#  4. ALIGNMENT & SAFETY CONSTRAINTS
# =========================================================================
class AlignmentConstraint:
    def __init__(self, ref_model: nn.Module, epsilon: float = 0.1):
        self.ref_model = ref_model
        self.epsilon = epsilon

    @torch.no_grad()
    def value(self, model: nn.Module, inputs: Tensor) -> Tensor:
        logp = F.log_softmax(model(inputs), dim=-1)
        logp_ref = F.log_softmax(self.ref_model(inputs), dim=-1)
        kl = F.kl_div(logp, logp_ref, log_target=True, reduction='batchmean')
        return kl - self.epsilon

    def gradient(self, model: nn.Module, inputs: Tensor) -> Dict[str, Tensor]:
        model.zero_grad(set_to_none=True)
        val = self.value(model, inputs)
        val.backward()
        grads = {n: p.grad.clone() if p.grad is not None else torch.zeros_like(p)
                 for n, p in model.named_parameters() if p.requires_grad}
        model.zero_grad(set_to_none=True)
        return grads


class SafetyConstraint:
    def __init__(self, unsafe_model: nn.Module, delta_safe: float = 0.5):
        self.unsafe_model = unsafe_model
        self.delta_safe = delta_safe

    @torch.no_grad()
    def value(self, model: nn.Module, inputs: Tensor) -> Tensor:
        logp = F.log_softmax(model(inputs), dim=-1)
        logp_unsafe = F.log_softmax(self.unsafe_model(inputs), dim=-1)
        kl = F.kl_div(logp, logp_unsafe, log_target=True, reduction='batchmean')
        return kl - self.delta_safe

    def gradient(self, model: nn.Module, inputs: Tensor) -> Dict[str, Tensor]:
        model.zero_grad(set_to_none=True)
        val = self.value(model, inputs)
        val.backward()
        grads = {n: p.grad.clone() if p.grad is not None else torch.zeros_like(p)
                 for n, p in model.named_parameters() if p.requires_grad}
        model.zero_grad(set_to_none=True)
        return grads


# =========================================================================
#  5. FISHER-METRIC HELPERS
# =========================================================================
def fisher_inner(u: Dict[str, Tensor], v: Dict[str, Tensor], kfac: KFACFisher) -> float:
    """⟨u, v⟩_{g_F} using Kronecker factors for linear layers."""
    result = 0.0
    for name in set(u.keys()) | set(v.keys()):
        u_val = u.get(name)
        v_val = v.get(name)
        if u_val is None or v_val is None:
            continue
        parts = name.rsplit('.', 1)
        layer = parts[0] if len(parts) == 2 else name
        param_type = parts[1] if len(parts) == 2 else ''
        if layer not in kfac.state.G:
            result += (u_val * v_val).sum().item()
            continue
        if param_type == 'weight' and v_val.dim() == 2:
            A = kfac.state.A[layer]
            G = kfac.state.G[layer]
            if A.size(0) > v_val.size(1):
                A_w = A[:-1, :-1]
            else:
                A_w = A
            gfv = G @ v_val @ A_w
            result += (u_val * gfv).sum().item()
        elif param_type == 'bias' and v_val.dim() == 1:
            G = kfac.state.G[layer]
            gfv = G @ v_val
            result += (u_val * gfv).sum().item()
        else:
            result += (u_val * v_val).sum().item()
    return result


def fisher_norm_sq(u: Dict[str, Tensor], kfac: KFACFisher) -> float:
    return fisher_inner(u, u, kfac)


def dict_scale(d: Dict[str, Tensor], s: float) -> Dict[str, Tensor]:
    return {k: v * s for k, v in d.items()}


def dict_add(a: Dict[str, Tensor], b: Dict[str, Tensor], scale_b: float = 1.0) -> Dict[str, Tensor]:
    keys = set(a.keys()) | set(b.keys())
    return {k: a.get(k, 0.0) + scale_b * b.get(k, 0.0) for k in keys}


# =========================================================================
#  6. JOINT PROJECTION (Lemma 2.5 – CORRECTED)
# =========================================================================
def joint_projection(
    psi_comp: Dict[str, Tensor],
    grad_g: Dict[str, Tensor],
    grad_h: Dict[str, Tensor],
    h_val: float,
    kfac: KFACFisher,
    alpha: float = 1.0,
    damping: float = 1e-6,
) -> Dict[str, Tensor]:
    """
    Closed‑form projection onto T_θG and CBF half‑space.
    Uses Fisher inner products ⟨·,·⟩_{g_F} via Kronecker factors.
    """
    # Natural gradient of g: g_F^{-1} ∇g
    ng_g = kfac.natural_gradient(grad_g)

    # Inverse Fisher norm squared of ∇g:  ‖∇g‖²_{g_F^{-1}} = ∇gᵀ g_F^{-1} ∇g
    inv_norm_g = max(sum((grad_g[n] * ng_g[n]).sum().item()
                         for n in grad_g if n in ng_g), damping)

    # 1. Project Ψ_comp onto T_θG
    num_psi = fisher_inner(grad_g, psi_comp, kfac)          # ⟨∇g, Ψ⟩_{g_F}
    coeff_psi = num_psi / inv_norm_g
    pi_psi = dict_add(psi_comp, ng_g, scale_b=-coeff_psi)

    # 2. Project ∇h onto T_θG
    num_h = fisher_inner(grad_g, grad_h, kfac)              # ⟨∇g, ∇h⟩_{g_F}
    coeff_h = num_h / inv_norm_g
    pi_h = dict_add(grad_h, ng_g, scale_b=-coeff_h)

    # 3. CBF multiplier ν
    num_cbf = fisher_inner(grad_h, pi_psi, kfac)            # ⟨∇h, Π(Ψ)⟩_{g_F}
    denom_cbf = max(fisher_norm_sq(pi_h, kfac), damping)   # ‖Π(∇h)‖²_{g_F}
    cbf_rhs = -alpha * h_val                                # CBF requires ⟨∇h,Ψ⟩ ≥ -α h
    nu = max(0.0, (cbf_rhs - num_cbf) / denom_cbf)

    return dict_add(pi_psi, pi_h, scale_b=nu)


