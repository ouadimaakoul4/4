#  8. CONDITION NUMBER ESTIMATION
# =========================================================================
@torch.no_grad()
def estimate_condition_number(kfac: KFACFisher) -> float:
    kappas = []
    for name in kfac.state.A:
        A = kfac.state.A[name]
        G = kfac.state.G[name]
        A_jit = A + 1e-4 * torch.eye(A.size(0), device=A.device)
        G_jit = G + 1e-4 * torch.eye(G.size(0), device=G.device)
        eigA = torch.linalg.eigvalsh(A_jit)
        eigG = torch.linalg.eigvalsh(G_jit)
        kA = (eigA.max() / (eigA.min() + 1e-8)).item()
        kG = (eigG.max() / (eigG.min() + 1e-8)).item()
        kappas.append(kA * kG)
    return float(max(kappas)) if kappas else 1.0


# =========================================================================
#  9. STEP-SIZE (Theorem 4.1)
# =========================================================================
def get_base_lr(step: int, config: SRIConfig) -> float:
    if config.lr_decay == "robbins_monro":
        return config.base_lr * config.lr_decay_offset / (step + config.lr_decay_offset)
    elif config.lr_decay == "cosine":
        return config.base_lr * 0.5 * (1.0 + math.cos(math.pi * step / 10000.0))
    else:
        return config.base_lr


def adaptive_step_size(mu_k: float, L_I: float, norm_psi_sq: float,
                       sigma_xi_sq: float, base_eta: float, endogenous: bool) -> float:
    if not endogenous or mu_k <= 0:
        return base_eta
    bound = 2.0 * mu_k / (L_I * (norm_psi_sq + sigma_xi_sq) + 1e-8)
    return min(base_eta, float(bound))


# =========================================================================
# 10. K-FAC ERROR ESTIMATION
# =========================================================================
def estimate_kfac_error(kfac: KFACFisher, loss_fn: Callable[[Tensor, Tensor], Tensor],
                        inputs: Tensor, targets: Tensor, n_iters: int = 1) -> float:
    params = {n: p for n, p in kfac.model.named_parameters() if p.requires_grad}
    v = {n: torch.randn_like(p) for n, p in params.items()}
    total_norm = math.sqrt(sum(t.norm().item()**2 for t in v.values()))
    v = {n: t / max(total_norm, 1e-8) for n, t in v.items()}
    max_ratio = 0.0
    for _ in range(n_iters):
        ng_kfac = kfac.natural_gradient(v)
        with torch.enable_grad():
            kfac.model.zero_grad()
            out = kfac.model(inputs)
            loss = loss_fn(out, targets)
            g = torch.autograd.grad(loss, params.values(), create_graph=False, retain_graph=False)
        named_g = {n: gg for (n, _), gg in zip(params.items(), g) if gg is not None}
        fv = {}
        for n, gg in named_g.items():
            if n in v:
                dot = (gg * v[n]).sum()
                fv[n] = gg.detach() * dot
            else:
                fv[n] = torch.zeros_like(gg)
        err = {n: ng_kfac[n] - fv.get(n, torch.zeros_like(ng_kfac[n])) for n in ng_kfac}
        err_norm = math.sqrt(sum(t.norm().item()**2 for t in err.values()))
        v_norm = math.sqrt(sum(t.norm().item()**2 for t in v.values()))
        max_ratio = max(max_ratio, err_norm / max(v_norm, 1e-8))
        v = ng_kfac
        total_norm = math.sqrt(sum(t.norm().item()**2 for t in v.values()))
        v = {n: t / max(total_norm, 1e-8) for n, t in v.items()}
    return max_ratio


# =========================================================================
# 11. SRI TRAINING STEP
# =========================================================================
@dataclass
class SRIStepResult:
    accepted: bool
    loss_cap: float
    nce_bound: float
    rho: float
    lambda_eff: float
    eta_tilde: float
    delta_star_stoch: float
    delta_kfac: float
    certified: bool
    batch_sufficient: bool
    h_val: float
    g_val: float


def sri_step(
    model: nn.Module,
    kfac: KFACFisher,
    critic: InfoNCEAnchorCritic,
    critic_optimizer: Optimizer,
    loss_fn: Callable[[Tensor, Tensor], Tensor],
    alignment: AlignmentConstraint,
    safety: SafetyConstraint,
    batch: Tuple[Tensor, Tensor],
    rare_batch: Tuple[Tensor, Tensor, Tensor],
    anchor: Tuple[Tensor, Tensor],
    step: int,
    config: SRIConfig,
    kappa_est: float,
    L_I: float = 10.0,
    sigma_xi_sq: float = 0.01,
    var_cap_ema: Optional[float] = None,
    var_mi_ema: Optional[float] = None,
) -> SRIStepResult:
    inputs, targets = batch
    z_pos, r_pos, r_neg = rare_batch
    z_anchor, r_anchor = anchor
    device = next(model.parameters()).device

    # >>> FIX: Transfer main batch to device <<<
    inputs = inputs.to(device)
    targets = targets.to(device)
    # Transfer rare tensors
    z_pos = z_pos.to(device)
    r_pos = r_pos.to(device)
    r_neg = r_neg.to(device)
    z_anchor = z_anchor.to(device)
    r_anchor = r_anchor.to(device)

    # 1. K-FAC factor update
    if step % config.kfac_update_freq == 0:
        model.zero_grad(set_to_none=True)
        out = model(inputs)
        loss = loss_fn(out, targets)
        loss.backward()
        kfac.update_factors()
        kfac.invert_factors()
        model.zero_grad(set_to_none=True)

    # 2. Critic update
    if step % config.critic_update_freq == 0:
        critic_optimizer.zero_grad()
        mi_loss, _ = infoNCE_anchor_loss(critic, z_pos, r_pos, r_neg,
                                         z_anchor, r_anchor,
                                         temperature=config.mi_temperature)
        mi_loss.backward()
        critic_optimizer.step()

    # 3. Capability gradient
    model.zero_grad(set_to_none=True)
    out = model(inputs)
    loss_cap = loss_fn(out, targets)
    loss_cap.backward()
    grad_cap_euc = {n: p.grad.clone() for n, p in model.named_parameters() if p.grad is not None}
    model.zero_grad(set_to_none=True)

    # 4. MI surrogate gradient
    z_latent = _get_latent(model, inputs[:z_pos.size(0)])
    mi_loss_model, mi_bound = infoNCE_anchor_loss(critic, z_latent, r_pos, r_neg,
                                                  z_anchor, r_anchor,
                                                  temperature=config.mi_temperature)
    mi_loss_model.backward()
    grad_mi_euc = {n: -p.grad.clone() for n, p in model.named_parameters() if p.grad is not None}
    model.zero_grad(set_to_none=True)
    nce_bound = float(mi_bound.item())

    # 5. Natural gradients
    grad_cap_nat = kfac.natural_gradient(grad_cap_euc)
    grad_mi_nat  = kfac.natural_gradient(grad_mi_euc)

    # 6. Dominance & certification
    dom = select_lambda_and_certify(grad_cap_nat, grad_mi_nat, kfac, config, kappa_est,
                                    inputs.size(0), var_cap_ema=var_cap_ema,
                                    var_mi_ema=var_mi_ema)

    # 7. Composite Ψ_comp
    psi_comp = dict_add(dict_scale(grad_cap_nat, -1.0),
                        grad_mi_nat, scale_b=dom.lambda_eff)

    # 8. Joint projection
    grad_g = alignment.gradient(model, inputs)
    grad_h = safety.gradient(model, inputs)
    g_val = float(alignment.value(model, inputs).item())
    h_val = float(safety.value(model, inputs).item())
    psi_star = joint_projection(psi_comp, grad_g, grad_h, h_val,
                                kfac, alpha=config.cbf_alpha,
                                damping=config.alignment_damping)

    # 9. K-FAC certification
    delta_kfac = 0.0
    certified = True
    if config.certify_every > 0 and step % config.certify_every == 0:
        delta_kfac = estimate_kfac_error(kfac, loss_fn, inputs, targets)
        certified = (delta_kfac < dom.delta_star_stoch)

    # 10. Step-size
    base_eta = get_base_lr(step, config)
    mu_k = dom.eta_tilde * max(fisher_norm_sq(grad_mi_nat, kfac), 1e-8)
    norm_psi_sq = fisher_norm_sq(psi_comp, kfac)
    eta = adaptive_step_size(mu_k, L_I, norm_psi_sq, sigma_xi_sq, base_eta, config.endogenous_step)

    # 11. Gradient clipping
    total_norm = math.sqrt(sum(v.norm().item()**2 for v in psi_star.values()))
    if total_norm > config.max_grad_norm:
        scale = config.max_grad_norm / (total_norm + 1e-8)
        psi_star = dict_scale(psi_star, scale)

    # 12. Update & rollback
    with torch.no_grad():
        old_params = {n: p.clone() for n, p in model.named_parameters() if p.requires_grad}
        for n, p in model.named_parameters():
            if n in psi_star:
                p.add_(psi_star[n].to(p.device), alpha=eta)

    new_loss_val = loss_fn(model(inputs), targets).item()
    accepted = (new_loss_val <= loss_cap.item() + config.rollback_tolerance)
    if not accepted:
        for n, p in model.named_parameters():
            if n in old_params:
                p.copy_(old_params[n])

    batch_ok = (inputs.size(0) >= dom.batch_req)
    return SRIStepResult(
        accepted=accepted,
        loss_cap=loss_cap.item(),
        nce_bound=nce_bound,
        rho=dom.rho,
        lambda_eff=dom.lambda_eff,
        eta_tilde=dom.eta_tilde,
        delta_star_stoch=dom.delta_star_stoch,
        delta_kfac=delta_kfac,
        certified=certified,
        batch_sufficient=batch_ok,
        h_val=h_val,
        g_val=g_val,
    )


# =========================================================================
# 12. LATENT EXTRACTION
# =========================================================================
def _get_latent(model: nn.Module, inputs: Tensor) -> Tensor:
    if hasattr(model, 'encoder'):
        enc_out = model.encoder(inputs if inputs.dim() == 3 else inputs.unsqueeze(1))
        if isinstance(enc_out, tuple):
            enc_out = enc_out[0]          # (B, T, H)
        return enc_out[:, -1, :]          # last time-step
    else:
        warnings.warn("Model lacks 'encoder' attribute; using full forward pass as latent.")
        return model(inputs)


# =========================================================================
# 13. TRAINER
# =========================================================================
class SRITrainer:
    def __init__(self, model: nn.Module, ref_model: nn.Module,
                 unsafe_model: nn.Module, loss_fn: Callable,
                 config: SRIConfig = SRIConfig(), latent_dim: int = 64):
        self.model = model
        self.loss_fn = loss_fn
        self.config = config
        self.kfac = KFACFisher(model, config)
        self.critic = InfoNCEAnchorCritic(latent_dim)
        self.critic_optimizer = torch.optim.Adam(self.critic.parameters(), lr=config.mi_estimator_lr)
        self.alignment = AlignmentConstraint(ref_model)
        self.safety = SafetyConstraint(unsafe_model)
        self.kappa_est = 1.0
        self.history: List[SRIStepResult] = []

    def train(self, dataloader, rare_dataloader,
              anchor_sample: Tuple[Tensor, Tensor],
              num_steps: int, L_I: float = 10.0, sigma_xi_sq: float = 0.01):
        data_iter = iter(dataloader)
        rare_iter = iter(rare_dataloader)
        step = 0
        try:
            while step < num_steps:
                try:
                    batch = next(data_iter)
                except StopIteration:
                    data_iter = iter(dataloader)
                    batch = next(data_iter)
                try:
                    rare_batch = next(rare_iter)
                except StopIteration:
                    rare_iter = iter(rare_dataloader)
                    rare_batch = next(rare_iter)
                if step % (self.config.kfac_update_freq * 5) == 0:
                    self.kappa_est = estimate_condition_number(self.kfac)
                result = sri_step(
                    model=self.model, kfac=self.kfac, critic=self.critic,
                    critic_optimizer=self.critic_optimizer, loss_fn=self.loss_fn,
                    alignment=self.alignment, safety=self.safety,
                    batch=batch, rare_batch=rare_batch, anchor=anchor_sample,
                    step=step, config=self.config, kappa_est=self.kappa_est,
                    L_I=L_I, sigma_xi_sq=sigma_xi_sq,
                )
                self.history.append(result)
                if step % self.config.log_every == 0:
                    self._log(step, result)
                step += 1
        finally:
            self.kfac.remove_hooks()
        print(f"\nTraining complete. {step} steps.")

    def _log(self, step, result):
        acc_rate = sum(r.accepted for r in self.history) / len(self.history)
        cert_rate = sum(r.certified for r in self.history) / len(self.history)
        print(
            f"[Step {step:5d}] "
            f"loss={result.loss_cap:.4f}  I_NCE={result.nce_bound:.4f}  "
            f"ρ={result.rho:+.3f}  λ={result.lambda_eff:.3f}  "
            f"η̃={result.eta_tilde:.3f}  δ*={result.delta_star_stoch:.4f}  "
            f"δ_K={result.delta_kfac:.4f}  h={result.h_val:.3f}  "
            f"g={result.g_val:.3f}  acc={acc_rate:.2%}  cert={cert_rate:.2%}  "
            f"batchOK={'✓' if result.batch_sufficient else '⚠'}  "
            f"{'✓' if result.accepted else '✗'}"
            f"{'🔒' if result.certified else '⚠️'}"
        )

    def infeasibility_check(self, inputs: Tensor, multiplier_grid_size: int = 20) -> Tuple[bool, float]:
        best_lb = -float('inf')
        for mu in torch.linspace(-5.0, 5.0, multiplier_grid_size):
            h_v = float(self.safety.value(self.model, inputs).item())
            g_v = float(self.alignment.value(self.model, inputs).item())
            lb = -h_v + mu.item() * g_v
            best_lb = max(best_lb, lb)
        infeasible = (best_lb > 0)
        if infeasible:
            print(f"[INFEASIBILITY CERTIFICATE] 𝒢 ∩ 𝒞 = ∅. Dual bound: {best_lb:.4f}")
        return infeasible, best_lb

    def compute_summary_stats(self) -> dict:
        if not self.history:
            return {}
        loss_vals = [r.loss_cap for r in self.history]
        mi_vals   = [r.nce_bound for r in self.history]
        return {
            "accept_rate": sum(r.accepted for r in self.history) / len(self.history),
            "cert_rate": sum(r.certified for r in self.history) / len(self.history),
            "mi_final": mi_vals[-1], "mi_delta": mi_vals[-1] - mi_vals[0],
            "loss_final": loss_vals[-1], "loss_delta": loss_vals[-1] - loss_vals[0],
            "rho_mean": sum(r.rho for r in self.history) / len(self.history),
            "mi_non_decreasing": all(b >= a - 1e-4 for a, b in zip(mi_vals, mi_vals[1:])),
            "loss_non_increasing": all(b <= a + 1e-4 for a, b in zip(loss_vals, loss_vals[1:])),
            "kappa_final": self.kappa_est,
        }


# =========================================================================
# EXAMPLE USAGE
# =========================================================================
if __name__ == "__main__":
    torch.manual_seed(42)

    class PolicyModel(nn.Module):
        def __init__(self, obs_dim=3, act_dim=1, hidden=64):
            super().__init__()
            self.encoder = nn.GRU(obs_dim, hidden, batch_first=True)
            self.head = nn.Linear(hidden, act_dim)
        def forward(self, x):
            if x.dim() == 2:
                x = x.unsqueeze(1)
            out, _ = self.encoder(x)
            return self.head(out[:, -1, :])

    obs_dim, act_dim, hidden = 3, 1, 64
    model = PolicyModel(obs_dim, act_dim, hidden)
    ref = PolicyModel(obs_dim, act_dim, hidden)
    unsafe = PolicyModel(obs_dim, act_dim, hidden)
    ref.eval(); unsafe.eval()
    for p in ref.parameters(): p.requires_grad_(False)
    for p in unsafe.parameters(): p.requires_grad_(False)

    def make_batch(b=32):
        return torch.randn(b, obs_dim), torch.randn(b, act_dim)
    def make_rare(b=32, K=16, d=hidden):
        return torch.randn(b, d), torch.randint(0,2,(b,)), torch.randint(0,2,(b,K))

    dataloader = [make_batch() for _ in range(200)]
    rare_dataloader = [make_rare() for _ in range(200)]
    anchor = (torch.randn(1, hidden), torch.tensor([1]))

    config = SRIConfig(kfac_damping=1e-3, kfac_update_freq=10, lambda_margin=0.5,
                       critic_update_freq=10, mi_num_negatives=16, base_lr=4e-3,
                       lr_decay="robbins_monro", lr_decay_offset=100.0,
                       rollback_tolerance=1e-4, certify_every=0, log_every=20)

    trainer = SRITrainer(model, ref, unsafe, nn.MSELoss(), config, latent_dim=hidden)
    trainer.train(dataloader, rare_dataloader, anchor, num_steps=200)

    stats = trainer.compute_summary_stats()
    print("\n── SRI Training Summary ──────────────────────────────")
    for k, v in stats.items():
        print(f"  {k:<25s}: {v}")

    test_in = torch.randn(16, obs_dim)
    infeas, lb = trainer.infeasibility_check(test_in)
    print(f"\nInfeasibility: {infeas}, dual bound: {lb:.4f}")
