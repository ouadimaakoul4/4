# =========================================================================
#  2. K-FAC FISHER APPROXIMATION
# =========================================================================
class KFACState:
    def __init__(self):
        self.A: Dict[str, Tensor] = {}      # input covariances
        self.G: Dict[str, Tensor] = {}      # gradient covariances
        self.A_inv: Dict[str, Tensor] = {}
        self.G_inv: Dict[str, Tensor] = {}
        self.has_bias: Dict[str, bool] = {}


class KFACFisher:
    """Kronecker-Factored Approximate Curvature for nn.Linear layers."""
    def __init__(self, model: nn.Module, config: SRIConfig):
        self.model = model
        self.config = config
        self.state = KFACState()
        self._hooks: List = []
        self._activations: Dict[str, Tensor] = {}
        self._grad_outputs: Dict[str, Tensor] = {}
        self.device = next(model.parameters()).device
        self._register_hooks()

    def _register_hooks(self):
        for name, module in self.model.named_modules():
            if isinstance(module, nn.Linear):
                h_fwd = module.register_forward_hook(self._make_forward_hook(name, module))
                h_bwd = module.register_full_backward_hook(self._make_backward_hook(name))
                self._hooks.extend([h_fwd, h_bwd])

    def _make_forward_hook(self, name: str, module: nn.Linear):
        def hook(mod, inp, out):
            a = inp[0].detach().to(self.device)
            if a.dim() == 3:
                a = a.reshape(-1, a.size(-1))
            if mod.bias is not None:
                ones = torch.ones(a.size(0), 1, device=self.device)
                a = torch.cat([a, ones], dim=1)
                self.state.has_bias[name] = True
            else:
                self.state.has_bias[name] = False
            self._activations[name] = a
        return hook

    def _make_backward_hook(self, name: str):
        def hook(module, grad_in, grad_out):
            if grad_out[0] is None:
                return
            g = grad_out[0].detach().to(self.device)
            if g.dim() == 3:
                g = g.reshape(-1, g.size(-1))
            self._grad_outputs[name] = g
        return hook

    @torch.no_grad()
    def update_factors(self):
        decay = 0.95
        for name in self._activations:
            a = self._activations[name]
            g_val = self._grad_outputs.get(name)
            if g_val is None:
                continue
            A_new = (a.T @ a) / a.size(0)
            G_new = (g_val.T @ g_val) / g_val.size(0)

            if name in self.state.A:
                self.state.A[name] = decay * self.state.A[name] + (1 - decay) * A_new
                self.state.G[name] = decay * self.state.G[name] + (1 - decay) * G_new
            else:
                self.state.A[name] = A_new
                self.state.G[name] = G_new

        self._activations.clear()
        self._grad_outputs.clear()

    @torch.no_grad()
    def invert_factors(self):
        d = self.config.kfac_damping
        for name in self.state.A:
            A = self.state.A[name]
            G = self.state.G[name]
            pi = torch.sqrt((torch.trace(A) / A.size(0)) /
                            (torch.trace(G) / G.size(0) + 1e-8))
            da = math.sqrt(d) * pi
            dg = math.sqrt(d) / (pi + 1e-8)
            self.state.A_inv[name] = torch.linalg.inv(
                A + da * torch.eye(A.size(0), device=self.device))
            self.state.G_inv[name] = torch.linalg.inv(
                G + dg * torch.eye(G.size(0), device=self.device))

    @torch.no_grad()
    def natural_gradient(self, named_grads: Dict[str, Tensor]) -> Dict[str, Tensor]:
        nat = {}
        for name, grad in named_grads.items():
            parts = name.rsplit('.', 1)
            layer = parts[0] if len(parts) == 2 else name
            param_type = parts[1] if len(parts) == 2 else ''
            if layer not in self.state.A_inv:
                nat[name] = grad
                continue
            A_inv = self.state.A_inv[layer]
            G_inv = self.state.G_inv[layer]
            if param_type == 'weight':
                if A_inv.size(0) > grad.size(1):
                    A_inv_w = A_inv[:-1, :-1]
                else:
                    A_inv_w = A_inv
                nat[name] = G_inv @ grad @ A_inv_w
            elif param_type == 'bias':
                nat[name] = G_inv @ grad
            else:
                nat[name] = grad
        return nat

    def remove_hooks(self):
        for h in self._hooks:
            h.remove()
        self._hooks.clear()


