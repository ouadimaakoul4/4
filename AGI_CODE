#  7. DOMINANCE AND CERTIFICATION
# =========================================================================
@dataclass
class DominanceResult:
    rho: float
    lambda_eff: float
    eta_tilde: float
    feasible: bool
    delta_star: float
    delta_star_stoch: float
    batch_req: int
    kappa: float


def select_lambda_and_certify(
    grad_cap_nat: Dict[str, Tensor],
    grad_mi_nat: Dict[str, Tensor],
    kfac: KFACFisher,
    config: SRIConfig,
    kappa_est: float,
    batch_size: int,
    var_cap_ema: Optional[float] = None,
    var_mi_ema: Optional[float] = None,
) -> DominanceResult:
    delta = config.lambda_margin
    norm_cap = math.sqrt(max(fisher_norm_sq(grad_cap_nat, kfac), 1e-12))
    norm_mi  = math.sqrt(max(fisher_norm_sq(grad_mi_nat, kfac), 1e-12))
    rho_raw = fisher_inner(grad_cap_nat, grad_mi_nat, kfac) / (norm_cap * norm_mi + 1e-12)
    rho = float(max(-1.0, min(1.0, rho_raw)))

    if rho <= 0.0:
        lambda_eff = 0.0
        eta_tilde_det = 1.0
        feasible = True
    else:
        max_delta = (1.0 - rho**2) / (rho**2 + 1e-8)
        feasible = (delta < max_delta)
        delta_use = delta if feasible else max(0.01, 0.9 * max_delta)
        lambda_min = rho * norm_cap / (norm_mi + 1e-8)
        lambda_eff = (1.0 + delta_use) * lambda_min
        eta_tilde_det = min(1.0, delta_use * rho**2 / (1.0 + delta_use * rho**2))

    denom = 2.0 * math.sqrt(kappa_est) * (1.0 + (1.0 + delta) * rho**2 + 1e-8)
    delta_star = eta_tilde_det / (denom + 1e-8)

    var_cap = var_cap_ema if var_cap_ema is not None else sum(v.var().item() for v in grad_cap_nat.values() if v.numel() > 0)
    var_mi  = var_mi_ema if var_mi_ema is not None else sum(v.var().item() for v in grad_mi_nat.values() if v.numel() > 0)
    trace_var = var_cap + lambda_eff**2 * var_mi

    delta_conf = max(1e-6, 1.0 - config.stoch_conf)
    epsilon_stoch = math.sqrt(2.0 * trace_var * math.log(2.0 / delta_conf) / batch_size)
    eta_tilde_stoch = max(eta_tilde_det - epsilon_stoch, config.stoch_margin_floor)
    delta_star_stoch = eta_tilde_stoch / (denom + 1e-8)

    req = 8.0 * (var_cap + lambda_eff**2 * var_mi) * math.log(2.0 / delta_conf)
    req /= (eta_tilde_stoch**2 * min(norm_cap**2, norm_mi**2) + 1e-8)
    batch_req = int(math.ceil(req))

    return DominanceResult(
        rho=rho,
        lambda_eff=float(lambda_eff),
        eta_tilde=float(eta_tilde_stoch),
        feasible=feasible,
        delta_star=float(delta_star),
        delta_star_stoch=float(delta_star_stoch),
        batch_req=batch_req,
        kappa=float(kappa_est),
    )


