Appendix B — Isabelle/HOL Formalisation: Inductive Invariant and Faded Worked Example

We present the Isabelle/HOL theory CBF_Invariant.thy. The formalisation uses a shallow embedding of discrete‑time dynamical systems and safety properties.

B.1 Full Formalisation

```isabelle
theory CBF_Invariant
  imports Main "HOL-Library.FuncSet"
begin

type_synonym 'state = real
type_synonym 'action = real
(* For concreteness, we use real numbers; the actual state and action are vectors,
   but the proof is abstract in the types. *)

locale CBF_System =
  fixes h :: "'state ⇒ real"
    and f :: "'state ⇒ 'action ⇒ 'state"
    and π :: "'state ⇒ 'action"
    and γ :: real
  assumes gamma_range: "0 < γ" "γ ≤ 1"
    and CBF_cond: "∀s. h s ≥ 0 ⟶ h (f s (π s)) ≥ (1 - γ) * h s"
begin

fun iter :: "nat ⇒ 'state ⇒ ('state ⇒ 'action) ⇒ 'state" where
  "iter 0 s _ = s"
| "iter (Suc n) s π = f (iter n s π) (π (iter n s π))"

lemma CBF_invariance:
  assumes "h s0 ≥ 0"
  shows "∀k. h (iter k s0 π) ≥ 0"
proof
  fix k
  show "h (iter k s0 π) ≥ 0"
  proof (induction k)
    case 0
    then show ?case using assms by simp
  next
    case (Suc k)
    then have "h (iter k s0 π) ≥ 0" by simp
    with CBF_cond have "h (f (iter k s0 π) (π (iter k s0 π))) ≥ (1 - γ) * h (iter k s0 π)" by blast
    also have "... ≥ 0" using gamma_range Suc by (simp add: mult_nonneg_nonneg)
    finally show ?case by simp
  qed
qed

end
end
```

