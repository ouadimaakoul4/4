            if np.sum(mask) > 10:
                performance[ancestry] = {
                    'auc': roc_auc_score(y_true[mask], y_pred[mask]),
                    'n_samples': np.sum(mask)
                }
        
        # Compute equity metrics
        equity_metrics = comprehensive_equity_metrics(performance, 
            {a: performance[a]['n_samples'] for a in performance})
        
        # Compute calibration metrics
        calibration = calibration_metrics(y_true, y_pred, ancestries)
        equity_metrics['calibration'] = calibration
        
        # Compute economic impact
        equity_metrics['economic'] = equity_premium_calculation(
            performance, self.base_reimbursement,
            {a: performance[a]['n_samples'] for a in performance}
        )
        
        return equity_metrics
    
    def run_cross_validation(self, model, X, y, ancestries, n_folds=5):
        """
        Run ancestry-stratified cross-validation.
        
        Parameters
        ----------
        model : sklearn estimator
            Machine learning model
        X : np.ndarray
            Feature matrix
        y : np.ndarray
            Target labels
        ancestries : np.ndarray
            Ancestry labels
        n_folds : int
            Number of cross-validation folds
        
        Returns
        -------
        cv_results : dict
            Cross-validation results by ancestry
        """
        return ancestry_stratified_cv(model, X, y, ancestries, n_folds)
    
    def get_iaadn_tier(self, equity_metrics):
        """
        Determine IA.ADN tier based on equity metrics.
        
        Parameters
        ----------
        equity_metrics : dict
            Output from evaluate_equity()
        
        Returns
        -------
        tier : int
            IA.ADN tier (1-4)
        """
        auc_range = equity_metrics.get('equity_range', 1.0)
        ratio = equity_metrics.get('performance_ratio', 0.0)
        calibration_adequate = all(
            metrics.get('well_calibrated', False) 
            for metrics in equity_metrics.get('calibration', {}).values()
            if isinstance(metrics, dict) and 'well_calibrated' in metrics
        )
        
        if ratio >= 0.95 and auc_range <= 0.10 and calibration_adequate:
            return 1
        elif ratio >= 0.90 and auc_range <= 0.15 and calibration_adequate:
            return 2
        elif ratio >= 0.85 and auc_range <= 0.20:
            return 3
        else:
            return 4
    
    def save_results(self, filepath):
        """
        Save pipeline results to file.
        
        Parameters
        ----------
        filepath : str
            Output file path (.pkl or .json)
        """
        import pickle
        with open(filepath, 'wb') as f:
            pickle.dump(self.results, f)
    
    def load_results(self, filepath):
        """
        Load saved pipeline results.
        
        Parameters
        ----------
        filepath : str
            Input file path
        """
        import pickle
        with open(filepath, 'rb') as f:
            self.results = pickle.load(f)


