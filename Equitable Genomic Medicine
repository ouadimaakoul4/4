### 5.3 Calibration Validation Across Ancestries

As noted earlier, calibration is critical for clinical deployment. We provide a specialized function for ancestry-stratified calibration validation.

```python
def ancestry_calibration_validation(y_true, y_pred_proba, ancestries, 
                                   n_bins=10, plot=True):
    """
    Validate calibration across ancestry groups.
    
    Returns calibration metrics and visualizations for each ancestry,
    along with a global calibration score.
    """
    from sklearn.calibration import calibration_curve
    import matplotlib.pyplot as plt
    
    unique_ancestries = np.unique(ancestries)
    n_ancestries = len(unique_ancestries)
    
    results = {}
    fig, axes = plt.subplots(1, min(n_ancestries, 3), figsize=(15, 5))
    if n_ancestries == 1:
        axes = [axes]
    
    for idx, ancestry in enumerate(unique_ancestries):
        mask = ancestries == ancestry
        y_true_anc = y_true[mask]
        y_pred_anc = y_pred_proba[mask]
        
        # Calibration curve
        prob_true, prob_pred = calibration_curve(
            y_true_anc, y_pred_anc, n_bins=n_bins, strategy='uniform'
        )
        
        # Expected Calibration Error
        bin_edges = np.linspace(0, 1, n_bins + 1)
        bin_indices = np.digitize(y_pred_anc, bin_edges) - 1
        ece = 0.0
        for b in range(n_bins):
            bin_mask = bin_indices == b
            if np.sum(bin_mask) > 0:
                accuracy = np.mean(y_true_anc[bin_mask])
                confidence = np.mean(y_pred_anc[bin_mask])
                weight = np.sum(bin_mask) / len(y_true_anc)
                ece += weight * np.abs(accuracy - confidence)
        
        # Brier Score
        brier = np.mean((y_true_anc - y_pred_anc) ** 2)
        
        results[ancestry] = {
            'ece': ece,
            'brier': brier,
            'calibration_curve': (prob_true.tolist(), prob_pred.tolist()),
            'n_samples': len(y_true_anc)
        }
        
        if plot and idx < 3:
            axes[idx].plot(prob_pred, prob_true, marker='o', linewidth=1, 
                          label=f'{ancestry} (ECE={ece:.3f})')
            axes[idx].plot([0, 1], [0, 1], linestyle='--', color='gray', 
                          label='Perfect Calibration')
            axes[idx].set_xlabel('Mean Predicted Probability')
            axes[idx].set_ylabel('Fraction of Positives')
            axes[idx].set_title(f'Calibration Curve - {ancestry}')
            axes[idx].legend()
            axes[idx].grid(True, alpha=0.3)
    
    # Global calibration score (harmonic mean of ECE across ancestries)
    ece_values = [results[a]['ece'] for a in unique_ancestries]
    if len(ece_values) > 0:
        global_ece = 1 / np.mean(1 / np.maximum(ece_values, 1e-10))
    else:
        global_ece = np.nan
    
    results['global'] = {
        'global_calibration_score': 1 - global_ece,
        'global_ece': global_ece,
        'best_ancestry_calibration': min(zip(unique_ancestries, ece_values), 
                                         key=lambda x: x[1]),
        'worst_ancestry_calibration': max(zip(unique_ancestries, ece_values), 
                                         key=lambda x: x[1]),
        'calibration_disparity': max(ece_values) - min(ece_values) if len(ece_values) > 1 else 0
    }
    
    return results
