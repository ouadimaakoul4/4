    /\ state = "Freeze"
    /\ \A n \in Nodes: heartbeats[n] = HeartbeatTimeout
    /\ state' = "Run"
    /\ UNCHANGED heartbeats

Next ==
    \/ \E n \in Nodes: HeartbeatDecrement(n)
    \/ HeartbeatLoss
    \/ \E n \in Nodes: HeartbeatReceived(n)
    \/ Unfreeze

Invariant ==
    state = "Run" => \A n \in Nodes: heartbeats[n] > 0

====
