          heartbeats,     \* function from Nodes to countdown timer

Init == 
    /\ state = "Run"
    /\ heartbeats = [n \in Nodes |-> HeartbeatTimeout]

HeartbeatDecrement(n) ==
    IF state = "Run" THEN
        heartbeats' = [heartbeats EXCEPT ![n] = heartbeats[n] - 1]
    ELSE
        UNCHANGED heartbeats

HeartbeatLoss ==
    \E n \in Nodes:
        /\ state = "Run"
        /\ heartbeats[n] = 0
        /\ state' = "Freeze"
        /\ heartbeats' = heartbeats

HeartbeatReceived(n) ==
    IF state \in {"Run","Freeze"} THEN
        heartbeats' = [heartbeats EXCEPT ![n] = HeartbeatTimeout]
    ELSE
        UNCHANGED heartbeats

