@dataclass
class CRAConfig:
    # Generator / embedder
    generator_model: str = "google/flan-t5-large"
    embedder_model: str = "sentence-transformers/all-MiniLM-L6-v2"

    # Sampling
    k_candidates: int = 5
    theta: float = 0.25

    # H1 / H0 weights
    alpha: float = 1.0
    beta: float = 1.0

    # Additive integrity weights (should sum ≈ 1.0)
    tda_weight: float = 0.40
    kinematic_weight: float = 0.20
    coherence_weight: float = 0.15
    graph_weight: float = 0.10
    semantic_weight: float = 0.10
    verify_weight: float = 0.05

    # Generation
    max_length: int = 512
    temperature: float = 0.7
    do_sample: bool = True

    # TDA
    betti_sigma: float = 1.0
    alpha_max_sq: float = 4.0

    # Graph
    sim_threshold: float = 0.7

    # Local suspicion
    hull_z_threshold: float = 2.0

    # ── NEW validated fixes ──
    light_mode: bool = False               # skip TDA + graph for speed
    structured_output: bool = False        # prompt for JSON steps
    semantic_center: float = -5.0          # calibrated centre for sigmoid
    semantic_scale: float = 2.0            # calibrated scale for sigmoid
    restatement_threshold: float = 0.92    # n‑gram overlap threshold
    use_causal_depth: bool = True          # apply (1-cd) penalty
    calibration_graph_stats: Optional[dict] = None  # pre‑computed {"mean": {...}, "std": {...}}


