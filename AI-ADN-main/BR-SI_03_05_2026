def candidate_acceptance_step(
    candidates: List, 
    S_t: dict,
    S_pre: dict,
    A0: List[Callable],  # intervention functions
    D_shift: dataset,
    epsilon_reg: float
) -> List:
    """
    Filter candidates according to Definition 4.1.
    Returns list of candidates that pass the necessary filter.
    """
    survivors = []
    for c in candidates:
        # Criterion 1: expected loss drop (negative expected delta)
        if expected_loss_diff(c, S_t, D_shift) >= 0:
            continue
        # Criterion 2: causal robustness on all interventions
        if any(expected_loss_diff_do(c, S_t, a, D_shift) >= 0 for a in A0):
            continue
        # Criterion 3: non-regression to pre-trained baseline
        if any(expected_loss_do(c, a, D_shift) > expected_loss_do(S_pre, a, D_shift) + epsilon_reg for a in A0):
            continue
        survivors.append(c)
    return survivors
