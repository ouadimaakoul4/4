C.2 Non‑i.i.d. SGM Gate

```python
def sgm_gate_non_iid(
    candidate, baseline, delta: float, max_samples: int,
    forecast_update_fn, lambda_scheduler
) -> (bool, dict):
    """
    Anytime-valid e‑value test with predictable plug-in.
    Returns (accepted, stats).
    """
    W = 1.0
    t = 0
    history = []
    while t < max_samples and W < 1/delta:
        batch = sample_fresh_minibatch()
        delta_t = loss(baseline, batch) - loss(candidate, batch)
        # Update forecast of conditional mean and variance
        mu_hat, sigma2_hat = forecast_update_fn(history, t)
        # Choose lambda adaptively
        lam = lambda_scheduler(mu_hat, sigma2_hat)
        # Compute e‑value
        E = np.exp(lam * delta_t - 0.5 * lam**2 * sigma2_hat)
        W *= E
        history.append(delta_t)
        t += 1
        # Check for secondary gaming alert
        if len(history) > 10:
            actual_mean = np.mean(history[-10:])
            if actual_mean > mu_hat + 1e-3:  # drift detected
                raise GamingAlert("Evaluated mean exceeds forecast")
    return (W >= 1/delta, {"wealth": W, "samples": t})
```

C.3 Hill Estimator with Bootstrap Stability

```python
def hill_estimator_with_stability(data: np.ndarray, B=200, boot_thresh=0.1) -> float:
    """
    Compute tail index xi via Hill estimator, selecting k via bootstrap SE.
    Returns xi_hat, or raises InsufficientData if no stable k.
    """
    n = len(data)
    sorted_data = np.sort(data)
    k_candidates = range(int(n**0.5), int(n**0.9), max(1, n//20))
    best_xi = None
    best_k = None
    best_se = float('inf')
    for k in k_candidates:
        # Hill estimate
        top = sorted_data[-k:]
        xi = np.mean(np.log(top / sorted_data[-k-1]))
        # bootstrap SE
        boots = []
        for _ in range(B):
            sample = np.random.choice(data, size=n, replace=True)
            samp_sort = np.sort(sample)
            boots.append(np.mean(np.log(samp_sort[-k:] / samp_sort[-k-1])))
        se = np.std(boots)
        if se < boot_thresh and se < best_se:
            best_se = se
            best_xi = xi
            best_k = k
    if best_xi is None:
        raise RuntimeError("Insufficient data for stable tail estimation.")
    return best_xi
```

C.4 Watchtower CUSUM

```python
def watchtower_cusum(
    monitor_values_stream, mu0, inv_cov, kappa, h
):
    """
    Multivariate CUSUM for OOD monitor detection.
    Yields alarm when Q exceeds h.
    """
    Q = 0.0
    for m_t in monitor_values_stream:
        z = (m_t - mu0).T @ inv_cov @ (m_t - mu0)
        Q = max(0.0, Q + z - kappa)
        if Q > h:
            yield "ALARM"
        else:
            yield "OK"
