    λ_SG ← √(L̂_g1 + ε_safety) · (1 + ε_safety)
20. ASSERT λ_LT · λ_SG > L̂_g1
21. LOG f"Memory ISS: CERTIFIED. L̂_g1={L̂_g1:.4f},
