B.2 Differentiable FEM Material ID with iSVD PE Monitor and Probing Budget

```python
class iSVDPEMonitor:
    def __init__(self, dim, rank=10, alpha=0.99):
        self.rank = rank
        self.U = torch.zeros(dim, rank)
        self.S = torch.zeros(rank)
        self.V = zeros(1, rank)  # will be updated
        self.alpha = alpha  # forgetting factor

    def update(self, psi):
        # psi: (m,) row of regressor; we perform rank-1 update
        # Simplified: maintain a buffer of recent psi and recompute SVD periodically
        self.buffer.append(psi)
        if len(self.buffer) > 100:
            self.buffer.pop(0)
        if len(self.buffer) % 10 == 0:
            M = torch.stack(self.buffer)  # (N, m)
            U, S, Vh = torch.linalg.svd(M, full_matrices=False)
            self.U = U[:, :self.rank]
            self.S = S[:self.rank]
            self.V = Vh[:self.rank, :].T

    def min_sv_approx(self):
        if self.S.numel() == 0:
            return 0.0
        return self.S[-1].item()  # smallest of top-k

def estimate_theta(probe_traj, theta_init, max_time=2.0, budget=0.2, pe_thresh=1e-3):
    theta = theta_init.clone().requires_grad_(True)
    opt = Adam([theta], lr=0.01)
    sim = DifferentiableFEM()
    pe_monitor = iSVDPEMonitor(len(theta), rank=10)
    probe_used = 0.0
    t = 0.0
    step = 0
    mode = "probing"
    while t < max_time:
        cmd = probe_traj.get_cmd(t, mode)
        y_pred = sim.step(theta, cmd)
        error = y_pred - probe_traj.forces[step]
        psi = torch.autograd.grad(y_pred, theta, create_graph=True)[0]
        pe_monitor.update(psi.detach())
        step += 1

        if step % 50 == 0:
            l_min_approx = pe_monitor.min_sv_approx()
            if l_min_approx < pe_thresh:
                if probe_used < budget:
                    mode = "probing"
                    probe_traj.increase_excitation()
                    probe_used += 0.05
                else:
                    print("PE budget exhausted; switching to conservative fallback.")
                    mode = "degraded"
                    break

        loss = (error**2).sum() / (1 + torch.norm(psi)**2)
        opt.zero_grad()
        loss.backward()
        opt.step()
        if torch.norm(theta.grad) < 1e-5:
            break
        t += 0.01
    return theta.detach(), pe_monitor, mode
```

B.3 Consistency‑Distilled Safety‑Guided Policy

```python
class ConsistencyPolicy(nn.Module):
    def __init__(self, consistency_model, safety_predictor, lambda_guide=0.1):
        super().__init__()
        self.consistency = consistency_model
        self.safety_pred = safety_predictor
        self.lambda_guide = lambda_guide

    def forward(self, obs, goal):
        z_v = vision_encoder(obs.rgbd)
        mu_t, sigma_t = tactile_encoder(obs.tactile)
        z_t = mu_t + sigma_t * torch.randn_like(mu_t)  # reparametrization
        z_halluc = tactile_decoder(z_v)  # from vision only

        noise = torch.randn(obs.batch_size, H, action_dim)
        a0 = self.consistency(noise, torch.cat([z_v, z_t], -1), goal, t=0)

        # Optional refinement (2 steps)
        for _ in range(2):
            alpha = 0.7
            noisy_a = math.sqrt(alpha) * a0 + math.sqrt(1-alpha) * torch.randn_like(a0)
            a0 = self.consistency(noisy_a, torch.cat([z_v, z_t], -1), goal, t=0)

        # Safety guidance
        a0.requires_grad_(True)
        cost = self.safety_pred(a0, z_halluc)
        grad = torch.autograd.grad(cost, a0)[0]
        return (a0 - self.lambda_guide * grad).detach()
```

B.4 Real‑Time 1 kHz Control Loop with Hysteresis Residual Monitor (C++)

```cpp
struct SafetyState {
    double avg_residual_sq = 0.0;
    bool passive_mode = false;
    int switch_count = 0;
    double last_switch_time = 0.0;
    double stable_below_low = 0.0; // time spent below LOW_THRESH
};

void controlLoop() {
    SafetyState safety;
    const double HIGH_THRESH = 25.0;   // N^2
    const double LOW_THRESH = 9.0;
    const double STABLE_REQ = 0.1;     // 100 ms
    const int MAX_SWITCHES = 3;
    const double REFLEX_FORCE_LIMIT = 50.0;

    while (true) {
        auto tactile = readTactile();
        auto joint = readJoints();

        // 1. Hard reflex
        if (tactile.force_norm > REFLEX_FORCE_LIMIT || tactile.slip_prob > 0.8) {
            auto tau = admittanceControl(safe_pose, joint);
            sendTorque(tau);
            continue;
        }

        // 2. Residual energy smoothing (EMA)
        double inst_res_sq = pow(norm(tactile.force - predicted_force), 2);
        safety.avg_residual_sq = 0.8 * safety.avg_residual_sq + 0.2 * inst_res_sq;

        // 3. Hysteresis logic
        if (safety.avg_residual_sq > HIGH_THRESH) {
            if (!safety.passive_mode) {
                safety.passive_mode = true;
                safety.switch_count++;
                safety.last_switch_time = now();
                safety.stable_below_low = 0.0;
            }
        } else if (safety.avg_residual_sq < LOW_THRESH) {
            safety.stable_below_low += DT;
            if (safety.passive_mode && safety.stable_below_low >= STABLE_REQ) {
                safety.passive_mode = false;
                safety.switch_count++;
                safety.last_switch_time = now();
            }
        } else {
            safety.stable_below_low = 0.0;  // in hysteresis band
        }

        // 4. Lock-out check
        if (safety.switch_count > MAX_SWITCHES && (now() - safety.last_switch_time) < 1.0) {
            safety.passive_mode = true;
            requestHumanIntervention();
        }

        // 5. Target selection
        Vector target;
        if (safety.passive_mode || !policyBuffer.isFresh()) {
            target = joint.position;
        } else {
            target = policyBuffer.getAction(step_idx);
        }

        // 6. Impedance control
        auto tau = impedanceController(target, joint);
        sendTorque(tau);
    }
}
```

