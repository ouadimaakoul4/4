    loss_recon = mse(v, vision_decoder(z_v)) + mse(t, tactile_decoder(z_t)) \
                + mse(v, vision_decoder(z_t)) + mse(t, tactile_decoder(z_v))
    # Contrastive alignment
    loss_align = info_nce(z_v, z_t)
    # Saturation masking
    mask_sat = (t_noisy < SAT_THRESH).float()
    loss_recon_touch = (mask_sat * (t - tactile_decoder(z_t))**2).sum() / mask_sat.sum()
    # Total loss (pretraining)
    total_loss = loss_recon + lambda_align*loss_align
    optimize(total_loss)

# Phase 2: Fine-tuning with domain adversarial alignment
for (v_sim, t_sim), (v_real, t_real) in zip(sim_loader, real_loader):
    z_t_sim, _, _ = tactile_encoder(t_sim)
    z_t_real, _, _ = tactile_encoder(t_real)
    # Domain classifier
    pred_sim = domain_discriminator(z_t_sim)
    pred_real = domain_discriminator(z_t_real)
    loss_dom = -log(pred_sim).mean() - log(1 - pred_real).mean()
    # Encoder adversarial loss (via gradient reversal)
    loss_adv = -loss_dom
    # Also reconstruction + alignment as before
    loss_total = loss_recon + lambda_align*loss_align + lambda_adv*loss_adv
    optimize(loss_total)
