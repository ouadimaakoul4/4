namespace l2wba::ethercat {

class EthercatMaster {
public:
    EthercatMaster(const char* iface, uint32_t cycle_us = 500)
        : cycle_us(cycle_us), running(true) {}

    void run_sync_loop(std::function<void(RxPdo& rx, const TxPdo& tx)> callback) {
        while (running) {
            auto start = std::chrono::steady_clock::now();

            // In a real system: receive TxPdo from hardware, call callback, send RxPdo.
            TxPdo tx;
            RxPdo rx;
            rx.timestamp_ns = start.time_since_epoch().count();
            callback(rx, tx);

            auto end = std::chrono::steady_clock::now();
            auto elapsed_us = std::chrono::duration_cast<std::chrono::microseconds>(end - start).count();
            int64_t sleep_us = cycle_us - elapsed_us;
            if (sleep_us > 0) {
                std::this_thread::sleep_for(std::chrono::microseconds(sleep_us));
            }
        }
    }

    void stop() { running = false; }

private:
    uint32_t cycle_us;
    std::atomic<bool> running;
};

} // namespace l2wba::ethercat
