using namespace l2wba::mediator;
using namespace l2wba::ipc;
using namespace l2wba::ethercat;

// Shared memory objects (global for simplicity)
SPSCRingBuffer<IntentSegment, 16>* intent_ring = nullptr;
SPSCRingBuffer<MediationResult, 16> feedback_ring;
ConstraintEngine engine;
SafeOperationEnvelope envelope;
BodyState current_state;

void* mediator_thread(void*) {
    // 1. CPU affinity (core 2)
    cpu_set_t cpuset;
    CPU_ZERO(&cpuset);
    CPU_SET(2, &cpuset);
    pthread_setaffinity_np(pthread_self(), sizeof(cpuset), &cpuset);

    // 2. Real‑time priority
    struct sched_param param;
    param.sched_priority = 99;
    pthread_setschedparam(pthread_self(), SCHED_FIFO, &param);

    // 3. Lock memory
    mlockall(MCL_CURRENT | MCL_FUTURE);

    // 4. EtherCAT master (placeholder)
    EthercatMaster master("eth0", 500);

    // 5. Main loop
    master.run_sync_loop([](RxPdo& rx, const TxPdo& tx) {
        // Update state from TxPdo (simplified: read actual positions into BodyState)
        // ...

        IntentSegment intent;
        bool has_intent = intent_ring->try_pop(intent);
        if (!has_intent) {
            // no new intent → hold position (zero velocity)
            intent.mutable_desired_twist()->Clear();
        }

        // Mediate
        MediationResult result = engine.mediate_intent(intent, current_state, envelope);

        // Fill RxPdo from result (convert mediated intent to joint commands)
        // In reality, the admittance controller would compute joint torques from the intent.
        // For brevity, we simply copy the first joint command.
        if (result.mediated_intent().joint_commands_size() > 0) {
            rx.joints[0].position_desired = result.mediated_intent().joint_commands(0).position();
            rx.joints[0].torque_ff = result.mediated_intent().joint_commands(0).torque();
        }

        // Push feedback for brain
        feedback_ring.try_push(result);
    });

    return nullptr;
}

int main() {
    // Create shared memory for brain intents (in production, use /dev/shm mapping)
    static SPSCRingBuffer<IntentSegment, 16> ring;
    intent_ring = &ring;

    pthread_t tid;
    pthread_create(&tid, nullptr, mediator_thread, nullptr);
    pthread_join(tid, nullptr);
    return 0;
}
