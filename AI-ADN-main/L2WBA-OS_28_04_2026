// l2wba/mediator/ConstraintEngine.hpp
// Copyright (c) 2025 xAI Robotics Division – Apache 2.0

#pragma once
#include <vector>
#include <string>
#include <cmath>
#include <algorithm>
#include <Eigen/Dense>
#include <Eigen/Geometry>
#include "ConstraintSystem.pb.h"   // generated from proto

namespace l2wba::mediator {

struct ConstraintViolation {
    std::string name;         // e.g. "Stability/CoM"
    double severity;          // 0.0 – 1.0
    std::string description;
};

class ConstraintEngine {
public:
    MediationResult mediate_intent(const IntentSegment& intent,
                                   const BodyState& state,
                                   const SafeOperationEnvelope& env) {
        auto violations = intersect_constraints(intent, state, env);
        if (violations.empty()) {
            MediationResult res;
            res.set_strategy(MediationResult::PASS_THROUGH);
            res.mutable_mediated_intent()->CopyFrom(intent);
            res.set_feasibility_score(1.0);
            return res;
        }

        ConflictLevel level = classify(violations);
        switch (level) {
            case CRITICAL: return substitute(intent, violations);
            case SEVERE:   return project(intent, violations, env);
            case MODERATE: return scale(intent, violations, env);
            case MINOR:    return dampen(intent, violations);
        }
        // unreachable
        return reject(intent);
    }

private:
    enum ConflictLevel { MINOR, MODERATE, SEVERE, CRITICAL };

    std::vector<ConstraintViolation> intersect_constraints(
        const IntentSegment& intent,
        const BodyState& state,
        const SafeOperationEnvelope& env) {

        std::vector<ConstraintViolation> v;
        auto comV = check_stability(intent, state, env.stability());
        v.insert(v.end(), comV.begin(), comV.end());
        auto actV = check_actuators(intent, state, env.actuator_health());
        v.insert(v.end(), actV.begin(), actV.end());
        auto geoV = check_geometry(intent, state, env.geometry());
        v.insert(v.end(), geoV.begin(), geoV.end());
        auto envV = check_environment(intent, state, env.environment());
        v.insert(v.end(), envV.begin(), envV.end());
        return v;
    }

    ConflictLevel classify(const std::vector<ConstraintViolation>& v) {
        if (v.empty()) return MINOR;
        double maxSev = 0.0;
        for (auto& vi : v) maxSev = std::max(maxSev, vi.severity);
        if (maxSev > 0.9 || v.size() > 5) return CRITICAL;
        if (maxSev > 0.7 || v.size() > 3) return SEVERE;
        if (maxSev > 0.4 || v.size() > 1) return MODERATE;
        return MINOR;
    }

    // ---------- constraint subroutines ----------
    std::vector<ConstraintViolation> check_stability(
        const IntentSegment& intent,
        const BodyState& state,
        const StabilityConstraint& stab) {

        std::vector<ConstraintViolation> v;
        // project CoM with linear extrapolation (dt = 1 ms)
        Eigen::Vector3d com = Eigen::Vector3d(state.current_com().x(),
                                             state.current_com().y(),
                                             state.current_com().z());
        Eigen::Vector3d vel(intent.desired_twist().linear().x(),
                            intent.desired_twist().linear().y(),
                            intent.desired_twist().linear().z());
        Eigen::Vector3d proj_com = com + vel * 0.001;

        // support polygon is a list of Point2D
        std::vector<Eigen::Vector2d> poly;
        for (auto& pt : stab.support_polygon().points())
            poly.emplace_back(pt.x(), pt.y());

        Eigen::Vector2d com2 = proj_com.head<2>();
        bool inside = point_in_polygon(com2, poly);
        double dev = (proj_com - com).norm();

        if (!inside || dev > stab.max_com_deviation()) {
            double sev = std::min(1.0, dev / stab.max_com_deviation());
            v.push_back({"Stability/CoM", sev, "CoM outside support polygon or excessive deviation"});
        }

        // tip-over check
        double tip_angle = std::atan2(proj_com.y(), proj_com.z()) * 180.0 / M_PI;
        if (tip_angle > stab.tip_over_threshold()) {
            v.push_back({"Stability/TipOver", 0.8, "Tip-over angle exceeded"});
        }
        return v;
    }

    std::vector<ConstraintViolation> check_actuators(
        const IntentSegment& intent,
        const BodyState& state,
        const ActuatorHealthConstraint& health) {

        std::vector<ConstraintViolation> v;
        for (auto& cmd : intent.joint_commands()) {
            const std::string& name = cmd.name();
            double torque = cmd.torque();
            double maxT = health.torque_limits().at(name);
            if (std::abs(torque) > maxT) {
                v.push_back({"Actuator/Torque_" + name,
                             std::min(1.0, std::abs(torque)/maxT),
                             "Torque limit exceeded"});
            }
            // velocity, thermal similar
        }
        return v;
    }

    std::vector<ConstraintViolation> check_geometry(
        const IntentSegment& intent,
        const BodyState& state,
        const GeometricConstraint& geo) {

        std::vector<ConstraintViolation> v;
        auto& prims = geo.self_collision_primitives();
        for (int i = 0; i < prims.size(); ++i) {
            for (int j = i+1; j < prims.size(); ++j) {
                double dist = capsule_distance(prims[i], prims[j], intent, state);
                if (dist < geo.min_clearance()) {
                    v.push_back({"Geometric/SelfCollision",
                                 1.0 - dist/geo.min_clearance(),
                                 "Self-collision risk"});
                }
            }
        }
        return v;
    }

    std::vector<ConstraintViolation> check_environment(
        const IntentSegment& intent,
        const BodyState& state,
        const EnvironmentalConstraint& env) {

        std::vector<ConstraintViolation> v;
        double req_mu = required_friction(intent, state);
        if (req_mu > env.ground_friction()) {
            v.push_back({"Environmental/Friction",
                         std::min(1.0, req_mu/env.ground_friction()),
                         "Insufficient ground friction"});
        }
        // obstacles: simplified – check if desired footprint overlaps any obstacle
        return v;
    }

    // ---------- resolution strategies ----------
    MediationResult substitute(const IntentSegment& intent,
                               const std::vector<ConstraintViolation>& violations) {
        IntentSegment safe;
        safe.mutable_desired_twist()->Clear(); // zero velocity → hold position
        MediationResult res;
        res.set_strategy(MediationResult::SUBSTITUTION);
        res.mutable_mediated_intent()->CopyFrom(safe);
        res.set_feasibility_score(1.0);
        fill_teaching(&res, intent, safe, "SUBSTITUTION", 0.0);
        return res;
    }

    MediationResult project(const IntentSegment& intent,
                            const std::vector<ConstraintViolation>& violations,
                            const SafeOperationEnvelope& env) {
        // Simplified: reduce acceleration, increase damping
        IntentSegment proj = intent;
        proj.mutable_desired_accel()->Clear();  // zero commanded accel
        MediationResult res;
        res.set_strategy(MediationResult::PROJECTION);
        res.mutable_mediated_intent()->CopyFrom(proj);
        double phi = calc_feasibility(proj, env);
        res.set_feasibility_score(phi);
        fill_teaching(&res, intent, proj, "PROJECTION", 0.8);
        return res;
    }

    MediationResult scale(const IntentSegment& intent,
                          const std::vector<ConstraintViolation>& violations,
                          const SafeOperationEnvelope& env) {
        double factor = 1.0;
        for (auto& v : violations) factor = std::min(factor, 1.0 - v.severity);
        IntentSegment sc = intent;
        sc.mutable_desired_twist()->mutable_linear()->set_x(
            sc.desired_twist().linear().x() * factor);
        // similarly for other axes
        MediationResult res;
        res.set_strategy(MediationResult::SCALING);
        res.mutable_mediated_intent()->CopyFrom(sc);
        res.set_feasibility_score(factor);
        fill_teaching(&res, intent, sc, "SCALING", factor);
        return res;
    }

    MediationResult dampen(const IntentSegment& intent,
                           const std::vector<ConstraintViolation>& violations) {
        IntentSegment adj = intent;
        // increase orientation compliance slightly
        adj.mutable_compliance()->mutable_orientation_compliance()->set_x(
            adj.compliance().orientation_compliance().x() * 1.2);
        MediationResult res;
        res.set_strategy(MediationResult::SCALING);
        res.mutable_mediated_intent()->CopyFrom(adj);
        res.set_feasibility_score(0.9);
        return res;
    }

    MediationResult reject(const IntentSegment& intent) {
        MediationResult res;
        res.set_strategy(MediationResult::REJECTION);
        res.set_feasibility_score(0.0);
        return res;
    }

    // ---------- helpers ----------
    double calc_feasibility(const IntentSegment& intent,
                            const SafeOperationEnvelope& env) {
        auto v = intersect_constraints(intent, BodyState(), env);
        double sum = 0.0;
        for (auto& vi : v) sum += vi.severity;
        return 1.0 / (1.0 + sum);
    }

    void fill_teaching(MediationResult* res,
                       const IntentSegment& orig, const IntentSegment& med,
                       const std::string& strat, double factor) {
        auto* ts = res->mutable_teaching_signal();
        ts->set_original_intent_id(orig.id());
        ts->set_adjustment_factor(factor);
        ts->set_primary_constraint("Multiple"); // in reality, from violations
        ts->set_estimated_recovery_time_ms(100);
        ts->set_suggested_alternative(strat + " applied");
    }

    // Low‑level geometry (simplified, real implementation uses FCL)
    bool point_in_polygon(const Eigen::Vector2d& p,
                          const std::vector<Eigen::Vector2d>& poly) {
        int n = poly.size();
        bool inside = false;
        for (int i = 0, j = n-1; i < n; j = i++) {
            if ((poly[i].y() > p.y()) != (poly[j].y() > p.y()) &&
                p.x() < (poly[j].x() - poly[i].x()) * (p.y() - poly[i].y()) /
                         (poly[j].y() - poly[i].y()) + poly[i].x())
                inside = !inside;
        }
        return inside;
    }

    double capsule_distance(const CollisionPrimitive& a,
                            const CollisionPrimitive& b,
                            const IntentSegment& intent,
                            const BodyState& state) {
        // Assume capsules are defined by two endpoints and radius; compute segment distance
        // Placeholder: return 1.0 m for safety
        return 1.0;
    }

    double required_friction(const IntentSegment& intent,
                             const BodyState& state) {
        // Simplified: assume required friction = horizontal accel / g
        double ax = intent.desired_accel().linear().x();
        double g = 9.81;
        return std::abs(ax) / g;
    }
};

} // namespace l2wba::mediator
