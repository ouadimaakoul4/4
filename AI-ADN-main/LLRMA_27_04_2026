F.3 Specific Resistance Estimation

```python
def specific_resistance(rho, k_a, k_heel=2000, m=70.0, d=0.75, g_=9.81):
    v_heel = 0.3
    E_impact = 0.5 * m * v_heel**2 * (1 - rho)**2
    xi_max = 0.15
    E_spring = 0.5 * k_a * xi_max**2
    eta = 0.9
    E_returned = eta * E_spring * rho
    E_actuation = 0.12 * rho * m * g_ * d
    SR = (E_impact + E_actuation - E_returned) / (m * g_ * d)
    return max(SR, 0.04)

# Sweep
rhos = np.linspace(0.05, 0.99, 50)
SRs = [specific_resistance(rho, 1500) for rho in rhos]
optimal_rho = rhos[np.argmin(SRs)]
