F.2 Stability and Coupling Indices

```python
def compute_SI_TCI(P, g):
    U, sigma, Vt = np.linalg.svd(P, full_matrices=True)
    r = np.sum(sigma > 1e-10)
    n, m = P.shape
    if r == n:
        SI = np.inf
    elif r == 0:
        SI = 0.0
    else:
        SI = r / (n - r)
    PP_plus = U[:, :r] @ U[:, :r].T
    g1 = PP_plus @ g
    TCI = np.linalg.norm(g1) / np.linalg.norm(g)
    kappa = sigma[0] / sigma[r-1] if r > 1 else 1.0
    return SI, TCI, kappa, r

# Example usage
P = np.array([[1.0, 0.5, 0.1],
              [0.6, 1.0, 0.3],
              [0.2, 0.4, 0.9],
              [0.0, 0.0, 0.2]])
g_walk = np.array([1.0, 0.8, 0.5, 0.1])
SI, TCI, kappa, r = compute_SI_TCI(P, g_walk)
