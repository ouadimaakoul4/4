F.1 Forward Kinematics (Product of Exponentials)

```python
import numpy as np

def skew(v):
    return np.array([[0, -v[2], v[1]],
                     [v[2], 0, -v[0]],
                     [-v[1], v[0], 0]])

def exp_screw(S, theta):
    omega = S[3:]
    v = S[:3]
    w_norm = np.linalg.norm(omega)
    if w_norm < 1e-10:  # prismatic joint
        T = np.eye(4)
        T[:3, 3] = v * theta
        return T
    W = skew(omega / w_norm)
    R = (np.eye(3) + np.sin(w_norm * theta) * W
         + (1 - np.cos(w_norm * theta)) * W @ W)
    p = ((np.eye(3) - R) @ np.cross(omega / w_norm, v)
         + np.outer(omega, omega) @ v / w_norm**2 * theta)
    T = np.eye(4)
    T[:3, :3] = R
    T[:3, 3] = p
    return T

def poe_fk(screws, thetas, M):
    T = M.copy()
    for i in reversed(range(len(thetas))):
        T = exp_screw(screws[i], thetas[i]) @ T
    return T

# Example: planar 3‑DoF leg (hip, knee, ankle)
q_hip   = np.array([0., 0., 0.9])
q_knee  = np.array([0., 0., 0.48])
q_ankle = np.array([0., 0., 0.08])
omega   = np.array([0., 1., 0.])          # lateral axis

def revolute_screw(omega, q):
    return np.concatenate([-np.cross(omega, q), omega])

screws = [revolute_screw(omega, q_hip),
          revolute_screw(omega, q_knee),
          revolute_screw(omega, q_ankle)]
M = np.eye(4)   # foot home config
