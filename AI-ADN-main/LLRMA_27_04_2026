```python
def flex_trajectory(joint_idx, phi, t_start, t_end, n_joints, n_pts=50):
    t = np.linspace(t_start, t_end, n_pts)
    s = (1 - np.cos(np.pi * (t - t_start) / (t_end - t_start))) / 2
    theta = np.zeros((n_joints, n_pts))
    theta[joint_idx, :] = phi * s
    return t, theta

def level_walk_trajectory(T=1.1, n_pts=200):
    t = np.linspace(0, T, n_pts)
    theta = np.zeros((4, n_pts))  # hip, knee, ankle, subtalar
    phase = t / T
    stance = phase < 0.6
    theta[0, stance] = 20 * np.sin(np.pi * phase[stance] / 0.6)
    theta[1, stance] = 10 * np.sin(np.pi * phase[stance] / 0.3)
    theta[2, stance] = -15 * phase[stance] / 0.6
    swing = ~stance
    phase_sw = (phase[swing] - 0.6) / 0.4
    theta[0, swing] = 30 * np.sin(np.pi * phase_sw)
    theta[1, swing] = 60 * np.sin(np.pi * phase_sw)
    theta[2, swing] = 10 * phase_sw
    return t, theta
