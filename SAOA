Appendix B – Core Algorithms (Pseudocode)

Algorithm 1: SAOA Main Loop

```
Initialise USO graph G_0, task DAG Φ_0, Beta priors for all agents/concepts
Initialise message bus, agent pool, RSA, critic
for episode in 1 .. max_episodes do
    while solution not found and budget not exhausted do
        // 1. Meta-cognition (every N_rsa steps)
        if step % N_rsa == 0 then
            g ← RSA.propose_goal(G_t, Ω_t, H_t)
        end if
        // 2. State encoding
        h_t ← GAT_encoder(G_t, Φ_t, Ω_t, H_t)
        // 3. Orchestration
        a_t ← MCTS_planner(h_t, g, A_orch)
        // 4. Execute action
        if a_t is Assignment(task, agent) then
            response ← agent.execute(task)
            node ← agent.format_USO_node(response)
        else if a_t is Verification(node) then
            verdict ← verify(node)
            if verdict.accepted then
                G_t ← G_t ∪ {node}
                update_competence(agent, success=True)
            else
                update_competence(agent, success=False)
            end if
        else if a_t is Distillation(src, tgt, concept) then
            trigger_distillation(src, tgt, concept)
        else if a_t is Arbitration(node_i, node_j) then
            resolve_conflict(node_i, node_j)
        end if
        // 5. Update DAG, entropy, history
        update_Φ_Ω_H()
    end do
    // End of episode: compute Shapley values, store snapshot, distill if needed
    compute_shapley_values()
    create_reproducibility_snapshot()
end for
```

Algorithm 2: Factored Thompson Sampling for Task Assignment

```
Input: task of concept k, task DAG Φ_t, agent pool A
Output: selected agent i*

build coordination graph C from Φ_t
for each agent i in A do
    compute upstream set up(i)
    sample ĉ_{i,k} ~ Beta(α_{i,k}, β_{i,k})
    if up(i) is empty then
        effective_comp ← ĉ_{i,k}
    else
        weakest_mean ← min_{p in up(i)} μ_{p,k}
        effective_comp ← ĉ_{i,k} - λ_c * (1 - weakest_mean)
    end if
    score[i] ← effective_comp - λ * cost(i)
end for
return argmax score
```

Algorithm 3: Process‑Level Shapley Value Estimation

```
Input: set of verified nodes V with provenance and quality q(v),
        agent set A, number of permutations m
Output: Shapley value φ_i for each i in A

for each agent i do
    φ_i ← 0
end for
for t = 1 to m do
    σ ← random permutation of A
    current_coalition ← {}
    for each agent i in σ (in order) do
        S ← current_coalition
        S_plus_i ← S ∪ {i}
        // compute utility as sum of q(v) for nodes contributed by coalition
        v_S ← sum_{v in V: provenance(v) ⊆ S} q(v)
        v_S_plus_i ← sum_{v in V: provenance(v) ⊆ S_plus_i} q(v)
        Δ_i ← v_S_plus_i - v_S
        φ_i ← φ_i + Δ_i
        current_coalition ← S_plus_i
    end for
end for
for each agent i do
    φ_i ← φ_i / m
end for
return {φ_i}
```

Algorithm 4: Conflict Resolution Protocol (CRP)

```
Input: contradictory nodes v_i, v_j, USO graph G
Output: resolved node v*, capability updates

// Step 1: compute distance
δ ← w_q * |x_i - x_j| / (σ_i + σ_j) + w_s * d_graph(v_i, v_j)
// Step 2: decision threshold
if δ < 1 then
    // Bayesian weighted merge
    v* ← precision_weighted_merge(v_i, v_j)
    adopt v*
else
    // deep arbitration
    referee ← select_referee(concept_k)
    if referee exists then
        v* ← referee.evaluate(v_i, v_j)
    else
        v* ← SWM.simulate(v_i, v_j)
    end if
    // capability updates based on distance from v*
    update_competence(agent_i, success = (distance(v_i, v*) < ϵ))
    update_competence(agent_j, success = (distance(v_j, v*) < ϵ))
    adopt v*
end if
return v*
```

Algorithm 5: Knowledge Distillation with Safeguards

```
Input: source agent i, target agent j, concept k, instance set D_k
Output: updated competence for j if successful

if not (μ_{i,k} > θ_high and μ_{j,k} < θ_low) then return

// compatibility check
κ ← expected_cosine_similarity(i, j, D_k)  // expectation over m subsets
var_κ ← variance of cosine similarities
if κ < θ_rep or var_κ > σ²_max then
    // fallback to symbolic
    rules ← i.extract_symbolic_rules(k)
    j.add_symbolic_rules(rules)
else
    // LoRA fine-tuning
    dataset ← i.generate_distillation_data(k)
    j.fine_tune_LoRA(dataset)
    acc_before ← j.evaluate(T_k)
    acc_after ← j.evaluate(T_k)
    if acc_after > acc_before then
        update_competence(j, bonus proportional to improvement)
    else
        j.rollback_LoRA()
        record_failure(i,j,k)
        r_{i,j,k} += 1
        if r_{i,j,k} >= 3 then
            blacklist(i,j,k)
        else
            schedule_retry(i,j,k, after 10^{r_{i,j,k}} cycles)
        end if
    end if
end if
```

