import numpy as np

n = 6  # sectors
# Vertices: a_1..a_n (inner), b_1..b_n (outer)
# Edges: inner, outer, radial (2n)
# Build delta0 as a sparse matrix

V = 2 * n
E = 4 * n  # n inner + n outer + 2n radial
delta0 = np.zeros((E, V))

def idx_a(i): return i % n
def idx_b(i): return n + (i % n)

# Inner edges: (a_i, a_{i+1})
for i in range(n):
    delta0[i, idx_a(i)] = -1
    delta0[i, idx_a(i+1)] = 1

# Outer edges: (b_i, b_{i+1})
for i in range(n):
    delta0[n + i, idx_b(i)] = -1
    delta0[n + i, idx_b(i+1)] = 1

# Radial edges: (a_i, b_i) and (a_{i+1}, b_i)
for i in range(n):
    delta0[2*n + 2*i, idx_a(i)] = -1
    delta0[2*n + 2*i, idx_b(i)] = 1
    delta0[2*n + 2*i + 1, idx_a(i+1)] = -1
    delta0[2*n + 2*i + 1, idx_b(i)] = 1

