## Appendix A: Isabelle/HOL Code Snippets

The following Isabelle/HOL code snippets illustrate the formalisation strategy for key components.

```isabelle
(* HITree datatype definition *)
codatatype ('e, 'r) HITree = 
    Ret 'r 
  | Vis 'e "('e ⇒ ('e, 'r) HITree)"
  | Evolve "real ⇒ real ⇒ real" "(real ⇒ bool)" "('e, 'r) HITree"
  | Jump "(real ⇒ bool)" "'a" "('e, 'r) HITree"

(* Deadlock-freedom property *)
definition deadlock_free :: "('e, 'r) HITree ⇒ bool" where
  "deadlock_free T ⟷ (∀s. ∃T'. T ⟶ T')"

(* Compositional deadlock-freedom lemma *)
lemma interleave_deadlock_free:
  assumes "deadlock_free C1" "deadlock_free C2" 
          "resources C1 ∩ resources C2 = {}"
  shows "deadlock_free (C1 ||| C2)"
```

```isabelle
(* Bisimulation metric fixed-point definition *)
definition bisim_operator :: 
  "(('s × 's) ⇒ real) ⇒ (('s × 's) ⇒ real)" where
  "bisim_operator d s1 s2 = max (base_metric s1 s2) 
    (⨆a. wasserstein_1 d (T s1 a) (T s2 a))"

lemma bisim_contraction:
  assumes "uniformly_probabilistic M"
  shows "lipschitz_contraction bisim_operator γ"
```

```isabelle
(* Lyapunov shield verification condition *)
definition lyapunov_condition :: 
  "(real^'m ⇒ real) ⇒ real ⇒ (real^'m ⇒ real^'m) ⇒ bool" where
  "lyapunov_condition L η π ⟷ 
    (∀b. b ∉ unsafe_set ⟶ 
      expectation (λb'. L(π b')) (P b) - L b ≤ -η)"

theorem shield_safety:
  assumes "lyapunov_condition L η π" "η > 0" "L b0 ≤ L_max"
  shows "P(∃t. state_at t ∈ unsafe_set) ≤ L b0 / L_max"
```

