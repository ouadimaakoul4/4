   │         auth.used = TRUE ⟹ phase ∉ {AUTHORIZED, AWAITING_APPROVAL}│
   │                                                                  │
   │  INV-4  Uncertainty Preservation                                 │
   │         phase = "AMBIGUOUS" ⟹ providerStatus[attempt.id]="unknown"│
   │                                                                  │
   │  INV-5  Audit Integrity                                          │
   │         timestamps monotone; length reflects linearization points│
   │                                                                  │
   │  INV-6  Compensation Soundness                                   │
   │         compState = "REFUND_CONFIRMED" ⟹ paymentState="REFUNDED" │
   │                                                                  │
   │  INV-7  Cancellation Soundness                                   │
   │         orderState = "CANCELLED" ⟹ compState = "CANCEL_CONFIRMED"│
   │                                                                  │
