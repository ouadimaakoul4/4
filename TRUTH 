C.3 Contradiction Engine (nli_contradiction.py)

This module implements Layers 1–3 of the contradiction detector. We include a claim-type matching step: if two assertions have different claim_type values, the contradiction score is forced to zero because they are not commensurable.

```python
import torch
import torch.nn as nn
from transformers import AutoTokenizer, AutoModelForSequenceClassification
import math
from typing import List, Tuple
from truth_tier1.schemas import Assertion, SpatialTemporalCoords

class Tier1ContradictionEngine(nn.Module):
    def __init__(self, model_name="cross-encoder/nli-deberta-v3-base", device="cuda"):
        super().__init__()
        self.device = torch.device(device if torch.cuda.is_available() else "cpu")
        self.tokenizer = AutoTokenizer.from_pretrained(model_name)
        self.nli_model = AutoModelForSequenceClassification.from_pretrained(model_name).to(self.device)
        self.nli_model.eval()
        self.max_human_speed_kmh = 1000.0

    def _layer1_surface_nli(self, premises, hypotheses):
        inputs = self.tokenizer(premises, hypotheses, padding=True, truncation=True, return_tensors="pt").to(self.device)
        with torch.no_grad():
            logits = self.nli_model(**inputs).logits
        probs = torch.softmax(logits, dim=-1)
        return probs[:, 0]  # index 0 = contradiction

    def _layer2_entity_attribute_check(self, a1: Assertion, a2: Assertion) -> float:
        if not a1.entities or not a2.entities:
            return 0.0
        clashes = 0
        comparisons = 0
        for e1 in a1.entities:
            for e2 in a2.entities:
                if e1.entity_id == e2.entity_id and e1.attribute_name == e2.attribute_name:
                    comparisons += 1
                    if e1.attribute_value.lower() != e2.attribute_value.lower():
                        clashes += 1
        return clashes / comparisons if comparisons > 0 else 0.0

    def _layer3_spatial_temporal_feasibility(self, c1: SpatialTemporalCoords, c2: SpatialTemporalCoords) -> float:
        if None in (c1.latitude, c1.longitude, c2.latitude, c2.longitude) or None in (c1.timestamp, c2.timestamp):
            return 0.0
        time_delta_hr = abs((c1.timestamp - c2.timestamp).total_seconds()) / 3600.0
        if time_delta_hr == 0: time_delta_hr = 0.001
        lat1, lon1, lat2, lon2 = map(math.radians, [c1.latitude, c1.longitude, c2.latitude, c2.longitude])
        dlat = lat2 - lat1; dlon = lon2 - lon1
        a = math.sin(dlat/2)**2 + math.cos(lat1)*math.cos(lat2)*math.sin(dlon/2)**2
        distance_km = 6371.0 * 2 * math.atan2(math.sqrt(a), math.sqrt(1-a))
        required_speed = distance_km / time_delta_hr
        return 1.0 if required_speed > self.max_human_speed_kmh else 0.0

    def compute_pairwise_contradiction(self, a1: Assertion, a2: Assertion) -> float:
        # Claim-type gate: if claim types differ, no direct contradiction is assessed
        if a1.claim_type != a2.claim_type:
            return 0.0
        l1 = self._layer1_surface_nli([a1.text], [a2.text]).item()
        l2 = self._layer2_entity_attribute_check(a1, a2)
        l3 = self._layer3_spatial_temporal_feasibility(a1.coords, a2.coords)
        return max(l1, l2, l3)
```

C.4 Source Dependency Engine (source_dependency.py)

Implements the logistic model for $P(D_{jk}=1)$ and the effective sample size calculation with design effect.

```python
import torch
import torch.nn as nn
import math
from typing import List
from truth_tier1.schemas import SourceMetadata

class SourceDependencyEngine(nn.Module):
    def __init__(self, in_features=3):
        super().__init__()
        self.weights = nn.Parameter(torch.tensor([2.0, 1.5, 3.0]))
        self.bias = nn.Parameter(torch.tensor([-2.5]))

    def compute_jaccard(self, t1, t2):
        s1, s2 = set(t1.lower().split()), set(t2.lower().split())
        if not s1 or not s2: return 0.0
        return len(s1 & s2) / len(s1 | s2)

    def extract_features(self, s1: SourceMetadata, s2: SourceMetadata):
        text_sim = self.compute_jaccard(s1.text_corpus, s2.text_corpus)
        days_diff = abs((s1.creation_date - s2.creation_date).days)
        temp_prox = math.exp(-days_diff / 365.0)
        has_cite = 1.0 if (s1.source_id in s2.citation_ids or s2.source_id in s1.citation_ids or s1.author_id == s2.author_id) else 0.0
        return torch.tensor([text_sim, temp_prox, has_cite], dtype=torch.float32)

    def forward(self, sources: List[SourceMetadata]) -> torch.Tensor:
        K = len(sources)
        P_dep = torch.zeros((K, K))
        for j in range(K):
            for k in range(j+1, K):
                feats = self.extract_features(sources[j], sources[k])
                logit = torch.dot(self.weights, feats) + self.bias
                p = torch.sigmoid(logit)
                P_dep[j,k] = p
                P_dep[k,j] = p
        return P_dep

    def effective_sample_size(self, cluster_indices: List[int], P_dep: torch.Tensor, gamma=0.5) -> float:
        if len(cluster_indices) <= 1: return float(len(cluster_indices))
        dep_sum = 0.0
        for i in cluster_indices:
            for j in cluster_indices:
                if i != j:
                    dep_sum += P_dep[i,j].item()
        return 1.0 / (1.0 + gamma * dep_sum)
```

C.5 Bootstrap Reliability Engine (bootstrap_reliability.py)

Implements the de‑circularised one‑step bootstrap (Algorithm 1). The agreement and contradiction scores are computed from assertion pairs filtered by the event_id and claim type.

```python
import torch
from typing import List, Dict
from truth_tier1.schemas import Assertion, SourceMetadata

class DeCircularisedBootstrapEngine:
    def __init__(self, alpha=2.0):
        self.alpha = alpha

    def compute_source_reliability(self, sources, assertions, contra_matrix, prior_reliabilities):
        K = len(sources)
        sid_to_idx = {s.source_id: i for i, s in enumerate(sources)}
        source_assertions = {i: [] for i in range(K)}
        for idx, a in enumerate(assertions):
            source_assertions[sid_to_idx[a.source_id]].append(idx)

        Agree = torch.zeros((K, K))
        Contradict = torch.zeros((K, K))
        for j in range(K):
            for k in range(K):
                if j == k: continue
                idx_j = source_assertions[j]
                idx_k = source_assertions[k]
                if not idx_j or not idx_k: continue
                total = len(idx_j) * len(idx_k)
                agree_sum = 0.0
                contra_sum = 0.0
                for a in idx_j:
                    for b in idx_k:
                        if assertions[a].event_id == assertions[b].event_id:
                            # claim type already handled in contra_matrix
                            contra = contra_matrix[a, b].item()
                            contra_sum += contra
                            agree_sum += (1.0 - contra)
                Agree[j,k] = agree_sum / total
                Contradict[j,k] = contra_sum / total

        R_star = torch.zeros(K)
        for k in range(K):
            weighted_agree = sum(prior_reliabilities[j].item() * Agree[j,k].item() for j in range(K) if j != k)
            weighted_contra = sum(prior_reliabilities[j].item() * Contradict[j,k].item() for j in range(K) if j != k)
            lambda_0 = torch.logit(prior_reliabilities[k])
            z = self.alpha * (weighted_agree - weighted_contra) + lambda_0
            R_star[k] = torch.sigmoid(z)
        return R_star
```

C.6 Pipeline Orchestration (pipeline.py)

The run_tier1_pipeline() function demonstrates the end‑to‑end flow: load sources and assertions, compute contradiction matrix, dependency matrix, and bootstrap reliabilities.

```python
import torch, datetime
from truth_tier1.schemas import Assertion, SourceMetadata, SpatialTemporalCoords
from truth_tier1.engines.nli_contradiction import Tier1ContradictionEngine
from truth_tier1.engines.source_dependency import SourceDependencyEngine
from truth_tier1.engines.bootstrap_reliability import DeCircularisedBootstrapEngine

def run_tier1_pipeline():
    nli = Tier1ContradictionEngine()
    dep = SourceDependencyEngine()
    boot = DeCircularisedBootstrapEngine(alpha=2.5)

    s1 = SourceMetadata(source_id="S1", author_id="A", creation_date=datetime.datetime(1200,5,1),
                        text_corpus="The king marched north with five thousand cavalrymen.")
    s2 = SourceMetadata(source_id="S2", author_id="B", creation_date=datetime.datetime(1205,3,10),
                        text_corpus="The king marched south with two thousand infantrymen.", citation_ids=["S1"])
    sources = [s1, s2]

    a1 = Assertion(assertion_id="A1", source_id="S1", event_id="E1", claim_type="troop_count",
                   text="king marched north with 5000 cavalrymen",
                   coords=SpatialTemporalCoords(timestamp=datetime.datetime(1200,5,1), latitude=51.5, longitude=-0.1))
    a2 = Assertion(assertion_id="A2", source_id="S2", event_id="E1", claim_type="troop_count",
                   text="king marched south with 2000 infantrymen",
                   coords=SpatialTemporalCoords(timestamp=datetime.datetime(1200,5,1), latitude=48.8, longitude=2.35))
    assertions = [a1, a2]

    N = len(assertions)
    contra = torch.zeros((N, N))
    for i in range(N):
        for j in range(i+1, N):
            score = nli.compute_pairwise_contradiction(assertions[i], assertions[j])
            contra[i,j] = contra[j,i] = score

    P_dep = dep(sources)
    priors = torch.tensor([0.7, 0.5])
    R = boot.compute_source_reliability(sources, assertions, contra, priors)

    print("Contradiction matrix:\n", contra)
    print("Dependency matrix:\n", P_dep)
    print("Reliabilities:", R)
```

C.7 Notes on Claim‑Type Matching

As required in §3.1.2, the contradiction score between two assertions is set to zero if their claim_type fields differ. This is implemented in Tier1ContradictionEngine.compute_pairwise_contradiction() by returning 0.0 when a1.claim_type != a2.claim_type. This prevents incommensurable assertions (e.g., a troop count vs. a weather report) from being compared as contradictions.

