# 1. SYNTHETIC DATASET GENERATION (Simulating Expert Historical Annotations)
# ==============================================================================

def generate_synthetic_controversy_data(n_controversies=100, n_experts=5):
    """
    Generates a synthetic dataset of historical controversies matching Chapter 6 specs.
    Each controversy has 3 to 5 competing versions with extracted features:
    - I_bar: Mean independence-adjusted reliability [0, 1]
    - C_bar: Coherence score [0, 1]
    - S: Temporal stability [0, 1]
    - V: Source variety [0, 1]
    - B: Corpus representation adjustment [0, 1]
    - D: Contradiction score [0, 1]
    - U: Uncertainty score [0, 1]
    - Domain: Historical domain ID (e.g., 0: Ancient, 1: Medieval, 2: Modern)
    """
    records = []
    for c_id in range(n_controversies):
        n_versions = np.random.randint(3, 6)
        domain_id = np.random.choice([0, 1, 2])  # 3 historical domains
        for v_id in range(n_versions):
            # Feature extraction mocks
            I_bar = np.random.beta(2, 2)
            C_bar = np.random.beta(3, 2)
            S = np.random.beta(2, 2)
            V = np.random.beta(2, 2)
            B = np.random.uniform(-0.5, 0.5)
            D = np.random.beta(1.5, 3.0)
            U = np.random.beta(2.0, 2.0)
            
            # Ground truth latent epistemic support
            true_E = 1 / (1 + np.exp(-(1.2 * I_bar + 0.8 * C_bar + 0.5 * S + 0.4 * V + 0.3 * B - 1.0)))
            
            # Ground truth logits for Blue, Yellow, Red
            z_B = 4.0 * (true_E - 0.5) + 3.0 * (0.3 - D) + 2.0 * (0.4 - U)
            z_Y = 0.0
            z_R = 4.0 * (0.4 - true_E) + 3.5 * (D - 0.4) + 2.0 * (U - 0.5)
            
            exp_z = np.exp([z_B, z_Y, z_R])
            true_probs = exp_z / np.sum(exp_z)
            
            # Expert panel annotations (Multinomial counts across B, Y, R)
            expert_counts = np.random.multinomial(n_experts, true_probs)
            
            records.append({
                'controversy_id': c_id,
                'version_id': v_id,
                'domain_id': domain_id,
                'I_bar': I_bar,
                'C_bar': C_bar,
                'S': S,
                'V': V,
                'B': B,
                'D': D,
                'U': U,
                'count_B': expert_counts[0],
                'count_Y': expert_counts[1],
                'count_R': expert_counts[2],
                'consensus_circle': np.argmax(expert_counts)
            })
    return pd.DataFrame(records)

# ==============================================================================
# 2. HIERARCHICAL PYMC CALIBRATION MODEL
# ==============================================================================

def build_truth_calibration_model(df, n_experts=5):
    """
    Builds the PyMC Hierarchical Bayesian Calibration Model implementing Chapter 6:
    - Hierarchical Epistemic Support Weights (w_1 ... w_5) pooled across domains.
    - Softmax Three-Circle Membership logits (z_B, z_Y, z_R).
    - L2 Regularization via Normal/HalfNormal hyperpriors.
    - Multinomial Likelihood over Expert Panel Circle Ratings.
    """
    n_obs = len(df)
    n_domains = df['domain_id'].nunique()
    domain_idx = df['domain_id'].values
    
    # Feature matrix X for Epistemic Support components: [I_bar, C_bar, S, V, B]
    X_mat = df[['I_bar', 'C_bar', 'S', 'V', 'B']].values
    D_vec = df['D'].values
    U_vec = df['U'].values
    
    # Observed count matrix [n_obs, 3] for multinomial expert labels (Blue, Yellow, Red)
    Y_obs = df[['count_B', 'count_Y', 'count_R']].values
    
    with pm.Model() as model:
        # --- Hyperpriors for Epistemic Support Scoring Weights ---
        mu_w = pm.Normal('mu_w', mu=0.5, sigma=0.5, shape=5)
        sigma_w = pm.HalfNormal('sigma_w', sigma=0.5, shape=5)
        
        # Domain-level weights (Hierarchical pooling across historical domains)
        w_domain = pm.Normal('w_domain', mu=mu_w, sigma=sigma_w, shape=(n_domains, 5))
        
        # Domain-level Intercepts
        b0_domain = pm.Normal('b0_domain', mu=0.0, sigma=1.0, shape=n_domains)
        
        # Calculate Epistemic Support E_i for each observation
        # E_i = sigmoid(w_1*I_bar + w_2*C_bar + w_3*S + w_4*V + w_5*B + b0)
        w_obs = w_domain[domain_idx]  # Shape: [n_obs, 5]
        b0_obs = b0_domain[domain_idx]  # Shape: [n_obs]
        
        lin_pred = pt.sum(w_obs * X_mat, axis=1) + b0_obs
        E_i = pm.Deterministic('E_i', pm.math.sigmoid(lin_pred))
        
        # --- Threshold Parameters (Regularized Priors) ---
        tau_E = pm.Beta('tau_E', alpha=2, beta=2)  # Support threshold
        tau_D = pm.Beta('tau_D', alpha=2, beta=2)
        delta_D = pm.Beta('delta_D', alpha=2, beta=2)  # Contradiction thresholds
        delta_D_prime = pm.Beta('delta_D_prime', alpha=2, beta=2)
        delta_U = pm.Beta('delta_U', alpha=2, beta=2)  # Uncertainty thresholds
        delta_U_prime = pm.Beta('delta_U_prime', alpha=2, beta=2)
        
        # --- Sharpness Parameters (a_1 to a_6 > 0) ---
        a = pm.HalfNormal('a', sigma=2.0, shape=6)
        
        # --- Softmax Circle Logits Formulation (§3.2.2) ---
        # Blue Logit: High support, low contradiction, low uncertainty
        z_B = a[0] * (E_i - tau_E) + a[1] * (delta_D - D_vec) + a[2] * (delta_U - U_vec)
        
        # Yellow Logit: Reference logit anchored at 0
        z_Y = pt.zeros(n_obs)
        
        # Red Logit: Low support, high contradiction, high uncertainty
        z_R = a[3] * (tau_D - E_i) + a[4] * (D_vec - delta_D_prime) + a[5] * (U_vec - delta_U_prime)
        
        # Stack logits into [n_obs, 3] matrix
        logits = pt.stack([z_B, z_Y, z_R], axis=1)
        
        # Softmax membership vector mu_c = exp(z_c) / sum(exp(z_c'))
        mu_c = pm.Deterministic('mu_c', pm.math.softmax(logits, axis=1))
        
        # --- Likelihood Function ---
        # Multinomial observation model for panel of experts
        likelihood = pm.Multinomial('Y_obs', n=n_experts, p=mu_c, observed=Y_obs)
    
    return model

# ==============================================================================
# 3. LEAVE-ONE-CONTROVERSY-OUT CROSS-VALIDATION & INFERENCE PIPELINE
# ==============================================================================

def run_calibration_pipeline():
    # 1. Generate Dataset
    df = generate_synthetic_controversy_data(n_controversies=40, n_experts=5)
    
    # 2. Build PyMC Model
    calibration_model = build_truth_calibration_model(df, n_experts=5)
    
    # 3. Perform Bayesian MCMC Sampling
    with calibration_model:
        trace = pm.sample(
            draws=1000,
            tune=1000,
            chains=2,
            target_accept=0.92,
            random_seed=42,
            return_inferencedata=True
        )
        
        # Posterior Predictive Checks
        posterior_predictive = pm.sample_posterior_predictive(
            trace, random_seed=42
        )
    
    # 4. Diagnostics and Summaries
    print("\n--- PARAMETER ESTIMATION SUMMARY ---")
    summary = az.summary(trace, var_names=['mu_w', 'tau_E', 'tau_D', 'a'])
    print(summary[['mean', 'sd', 'hdi_3%', 'hdi_97%', 'r_hat', 'ess_bulk']])
    
    # 5. Extract Predicted Memberships
    posterior_mu = trace.posterior['mu_c'].values
    
    # Average across chains and draws -> [n_obs, 3]
    mean_pred_probs = posterior_mu.mean(axis=(0, 1))
    pred_circles = np.argmax(mean_pred_probs, axis=1)
    true_circles = df['consensus_circle'].values
    
    # 6. Evaluate Classification Performance against Expert Consensus
    acc = accuracy_score(true_circles, pred_circles)
    loss = log_loss(true_circles, mean_pred_probs)
    
    print("\n--- MODEL PERFORMANCE METRICS ---")
    print(f"Expert Circle Classification Accuracy: {acc * 100:.2f}%")
    print(f"Categorical Cross-Entropy Loss: {loss:.4f}")
    
    return trace, df

if __name__ == "__main__":
    trace, df = run_calibration_pipeline()
