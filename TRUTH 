import pandas as pd
import pymc as pm
import pytensor.tensor as pt
import arviz as az
from sklearn.metrics import accuracy_score, log_loss

np.random.seed(42)

def generate_synthetic_controversy_data(n_controversies=100, n_experts=5):
    records = []
    for c_id in range(n_controversies):
        n_versions = np.random.randint(3, 6)
        domain_id = np.random.choice([0, 1, 2])
        for v_id in range(n_versions):
            I_bar = np.random.beta(2, 2)
            C_bar = np.random.beta(3, 2)
            S = np.random.beta(2, 2)
            V = np.random.beta(2, 2)
            B = np.random.uniform(-0.5, 0.5)
            D = np.random.beta(1.5, 3.0)
            U = np.random.beta(2.0, 2.0)
            true_E = 1 / (1 + np.exp(-(1.2*I_bar + 0.8*C_bar + 0.5*S + 0.4*V + 0.3*B - 1.0)))
            z_B = 4.0*(true_E - 0.5) + 3.0*(0.3 - D) + 2.0*(0.4 - U)
            z_Y = 0.0
            z_R = 4.0*(0.4 - true_E) + 3.5*(D - 0.4) + 2.0*(U - 0.5)
            exp_z = np.exp([z_B, z_Y, z_R])
            probs = exp_z / np.sum(exp_z)
            counts = np.random.multinomial(n_experts, probs)
            records.append({
                'controversy_id': c_id,
                'version_id': v_id,
                'domain_id': domain_id,
                'I_bar': I_bar, 'C_bar': C_bar, 'S': S, 'V': V, 'B': B,
                'D': D, 'U': U,
                'count_B': counts[0], 'count_Y': counts[1], 'count_R': counts[2],
                'consensus_circle': np.argmax(counts)
            })
    return pd.DataFrame(records)

def build_truth_calibration_model(df, n_experts=5):
    n_obs = len(df)
    n_domains = df['domain_id'].nunique()
    domain_idx = df['domain_id'].values
    X = df[['I_bar', 'C_bar', 'S', 'V', 'B']].values
    D_vec = df['D'].values
    U_vec = df['U'].values
    Y = df[['count_B', 'count_Y', 'count_R']].values

    with pm.Model() as model:
        # Hyperpriors for support weights (L2 regularization)
        mu_w = pm.Normal('mu_w', mu=0.5, sigma=0.5, shape=5)
        sigma_w = pm.HalfNormal('sigma_w', sigma=0.5, shape=5)
        w_domain = pm.Normal('w_domain', mu=mu_w, sigma=sigma_w, shape=(n_domains, 5))
        b0_domain = pm.Normal('b0_domain', mu=0.0, sigma=1.0, shape=n_domains)

        w_obs = w_domain[domain_idx]
        b0_obs = b0_domain[domain_idx]
        lin = pt.sum(w_obs * X, axis=1) + b0_obs
        E_i = pm.Deterministic('E_i', pm.math.sigmoid(lin))

        tau_E = pm.Beta('tau_E', alpha=2, beta=2)
        tau_D = pm.Beta('tau_D', alpha=2, beta=2)
        delta_D = pm.Beta('delta_D', alpha=2, beta=2)
        delta_D_prime = pm.Beta('delta_D_prime', alpha=2, beta=2)
        delta_U = pm.Beta('delta_U', alpha=2, beta=2)
        delta_U_prime = pm.Beta('delta_U_prime', alpha=2, beta=2)

        a = pm.HalfNormal('a', sigma=2.0, shape=6)

        z_B = a[0]*(E_i - tau_E) + a[1]*(delta_D - D_vec) + a[2]*(delta_U - U_vec)
        z_Y = pt.zeros(n_obs)
        z_R = a[3]*(tau_D - E_i) + a[4]*(D_vec - delta_D_prime) + a[5]*(U_vec - delta_U_prime)

        logits = pt.stack([z_B, z_Y, z_R], axis=1)
        mu_c = pm.Deterministic('mu_c', pm.math.softmax(logits, axis=1))
        pm.Multinomial('Y_obs', n=n_experts, p=mu_c, observed=Y)

    return model

def run_calibration():
    df = generate_synthetic_controversy_data(40, 5)
    model = build_truth_calibration_model(df)
    with model:
        trace = pm.sample(1000, tune=1000, chains=2, target_accept=0.92, random_seed=42)
        ppc = pm.sample_posterior_predictive(trace, random_seed=42)
    summary = az.summary(trace, var_names=['mu_w', 'tau_E', 'tau_D', 'a'])
    print(summary[['mean', 'sd', 'hdi_3%', 'hdi_97%', 'r_hat']])
    mean_probs = trace.posterior['mu_c'].mean(axis=(0,1)).values
    pred = np.argmax(mean_probs, axis=1)
    true = df['consensus_circle'].values
    acc = accuracy_score(true, pred)
    print(f"Accuracy: {acc:.3f}")

if __name__ == "__main__":
    run_calibration()
```

B.2 Stan Implementation

The equivalent Stan model is saved as truth_calibration.stan:

```stan
data {
  int<lower=1> N;                      // number of observations
  int<lower=1> K;                      // number of domains
  int<lower=1> N_experts;              // experts per panel
  array[N] int<lower=1, upper=K> domain_idx;
  matrix[N, 5] X;                      // features [I_bar, C_bar, S, V, B]
  vector[N] D_vec;
  vector[N] U_vec;
  array[N, 3] int Y_obs;               // counts [Blue, Yellow, Red]
}
parameters {
  vector[5] mu_w;
  vector<lower=0>[5] sigma_w;
  matrix[K, 5] w_domain;
  vector[K] b0_domain;
  real<lower=0, upper=1> tau_E;
  real<lower=0, upper=1> tau_D;
  real<lower=0, upper=1> delta_D;
  real<lower=0, upper=1> delta_D_prime;
  real<lower=0, upper=1> delta_U;
  real<lower=0, upper=1> delta_U_prime;
  vector<lower=0>[6] a;
}
transformed parameters {
  matrix[N, 3] logits;
  for (n in 1:N) {
    int k = domain_idx[n];
    real lin = dot_product(w_domain[k], X[n]) + b0_domain[k];
    real E = inv_logit(lin);
    logits[n,1] = a[1]*(E - tau_E) + a[2]*(delta_D - D_vec[n]) + a[3]*(delta_U - U_vec[n]);
    logits[n,2] = 0.0;
    logits[n,3] = a[4]*(tau_D - E) + a[5]*(D_vec[n] - delta_D_prime) + a[6]*(U_vec[n] - delta_U_prime);
  }
}
model {
  mu_w ~ normal(0.5, 0.5);
  sigma_w ~ normal(0, 0.5);
  for (k in 1:K) {
    w_domain[k] ~ normal(mu_w, sigma_w);
    b0_domain[k] ~ normal(0, 1);
  }
  tau_E ~ beta(2,2); tau_D ~ beta(2,2);
  delta_D ~ beta(2,2); delta_D_prime ~ beta(2,2);
  delta_U ~ beta(2,2); delta_U_prime ~ beta(2,2);
  a ~ normal(0, 2);
  for (n in 1:N)
    Y_obs[n] ~ multinomial(softmax(to_vector(logits[n,])));
}
```

B.3 Mapping to Dissertation Equations

· The epistemic support score $E_i$ is computed as $\sigma(w \cdot X + b_0)$, matching Eq. (3.6).
· The softmax logits $z_B, z_Y, z_R$ follow Eq. (3.2.2).
· Hierarchical priors on weights implement L2 regularisation and partial pooling across domains, as required by §6.3.
· Multinomial likelihood correctly models the clustered expert ratings, avoiding the conflation of observations and ratings.

